local PASS_LOB_SPEED = 260
local SPECIAL_MAX_TICKS = 180
local SPECIAL_STRAIGHT_SPEED = 560
local SPECIAL_ZIGZAG_SPEED = 400
local SPECIAL_ZIGZAG_AMP = 260
local SPECIAL_ZIGZAG_FREQ = 0.3
local SPECIAL_LOB_SPEED = 300
local SPECIAL_LOB_VZ = 420
local SPECIAL_LOB_FALL_GRAVITY_MULT = 3
