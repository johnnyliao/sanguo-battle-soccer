            <string name="Name">random</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local imul = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "rng").imul
--* mulberry32 step over an AI rng field (AIState.rng). Returns a float in [0, 1) and advances it. 
local function nextRandom(ai)
	ai.rng = bit32.rshift((ai.rng + 0x6d2b79f5), 0)
	local t = ai.rng
	t = imul(bit32.bxor(t, (bit32.rshift(t, 15))), bit32.bor(t, 1))
	t = bit32.bxor(t, t + imul(bit32.bxor(t, (bit32.rshift(t, 7))), bit32.bor(t, 61)))
	return (bit32.rshift((bit32.bxor(t, (bit32.rshift(t, 14)))), 0)) / 4294967296
end
return {
	nextRandom = nextRandom,
}
]]></string>
