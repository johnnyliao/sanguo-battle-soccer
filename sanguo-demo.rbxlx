        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">actions</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local K = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local _field = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "field")
local attackDir = _field.attackDir
local goalMouth = _field.goalMouth
local inOwnArea = _field.inOwnArea
local opponentGoalX = _field.opponentGoalX
local ownGoalX = _field.ownGoalX
local _rng = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "rng")
local rngInt = _rng.rngInt
local rngNext = _rng.rngNext
--* Vertical gap under which an airborne hit still connects. 
local AIR_HIT_Z = 24
--* A tackle only connects with victims this close to the ground. 
local TACKLE_MAX_VICTIM_Z = 10
local TACKLE_CONTACT_PAD = 4
local PUNCH_DAMP = 0.85
local PUNCH_WALK_MULT = 0.3
local TACKLE_DAMP = 0.96
local HITSTUN_DAMP = 0.88
local DOWN_DAMP = 0.85
local RECOVER_DAMP = 0.85
local HIT_VZ = 80
local LOOSE_BALL_SPEED = 90
local LOOSE_BALL_SPREAD = 30
local LOOSE_BALL_VZ = 120
local RAMPAGE_BUMP_VZ = 220
local ROAR_VZ = 140
--* A rampager bumps opponents whose circle comes within this many px of its own. 
local RAMPAGE_BUMP_PAD = 4
local PASS_CONE_COS = 0.3
local PASS_SPEED_GUESS = 300
local PASS_GROUND_VZ = 30
local PASS_LOB_MAX_VZ = 420
local SHOT_AIM_OFFSET_Y = 28
local SHOT_AIM_SPREAD = 3.5
local SHOT_MAX_VZ = 500
local CLEAR_SPEED = 300
local CLEAR_VZ = 150
local GK_DIVE_VZ = 120
local GK_DIVE_DAMP = 0.95
local LOB_MIN_SPEED = 120
local LOB_MAX_SPEED = 440
--* A lob lands this far past the goal line along its shot direction. 
local LOB_OVERSHOOT = 10
--* Runs one tick of the player's current action. Mutates the player and may mutate the ball and events. 
local applyGravity, tickRampage, tickTiger, tickSlash, tickSail, tickSpecialCooldown, updateNormal, updatePunch, updateTackle, updateDive, coast, toNormal, updateCharge, updateLunge, updateCast, updateFear, updateLeap, updateRide
local function updateAction(state, p, input)
	-- A passenger on a sail is carried by carryPassengers: no input, no timers, no physics.
	if p.sailPassengerOf ~= -1 then
		return nil
	end
	if p.callPassTicks > 0 then
		p.callPassTicks -= 1
	end
	applyGravity(p)
	tickRampage(state, p)
	tickTiger(state, p)
	tickSlash(state, p)
	tickSail(state, p)
	tickSpecialCooldown(state, p)
	if p.silenceTicks > 0 then
		p.silenceTicks -= 1
	end
	if input.l and not p.prevInput.l and p.action ~= "fear" and p.silenceTicks == 0 then
		p.specialBuffer = K.SPECIAL_BUFFER_TICKS
	elseif p.specialBuffer > 0 then
		p.specialBuffer -= 1
	end
	local _exp = p.action
	repeat
		if _exp == "normal" then
			updateNormal(state, p, input)
			break
		end
		if _exp == "punch" then
			updatePunch(state, p)
			break
		end
		if _exp == "tackle" then
			updateTackle(state, p)
			break
		end
		if _exp == "dive" then
			updateDive(p)
			break
		end
		if _exp == "hitstun" then
			if coast(p, HITSTUN_DAMP) then
				toNormal(p)
			end
			break
		end
		if _exp == "down" then
			if coast(p, DOWN_DAMP) then
				toNormal(p)
				if p.stamina <= 0 then
					p.stamina = p.maxStamina * K.GETUP_STAMINA_RATIO
				end
			end
			break
		end
		if _exp == "recover" then
			if coast(p, RECOVER_DAMP) then
				toNormal(p)
			end
			break
		end
		if _exp == "charge" then
			updateCharge(state, p, input)
			break
		end
		if _exp == "lunge" then
			updateLunge(state, p)
			break
		end
		if _exp == "cast" then
			updateCast(state, p)
			break
		end
		if _exp == "fear" then
			updateFear(p)
			break
		end
		if _exp == "leap" then
			updateLeap(state, p)
			break
		end
		if _exp == "ride" then
			updateRide(state, p)
			break
		end
	until true
end
--* Pushes a player back inside the field bounds in xy. 
local function clampPlayerToField(p)
	if p.x < 0 then
		p.x = 0
		p.vx = 0
	elseif p.x > K.FIELD_W then
		p.x = K.FIELD_W
		p.vx = 0
	end
	if p.y < 0 then
		p.y = 0
		p.vy = 0
	elseif p.y > K.FIELD_D then
		p.y = K.FIELD_D
		p.vy = 0
	end
end
--* Applies gravity to airborne players (knocked-back players are airborne briefly). 
function applyGravity(p)
	if p.z <= 0 and p.vz == 0 then
		return nil
	end
	p.vz -= K.PLAYER_GRAVITY * K.DT
	p.z += p.vz * K.DT
	if p.z <= 0 then
		p.z = 0
		p.vz = 0
	end
end
local function integrate(p)
	p.x += p.vx * K.DT
	p.y += p.vy * K.DT
	clampPlayerToField(p)
end
--* Damps velocity, integrates, and counts down the action timer. Returns true when the timer ends. 
function coast(p, damp)
	p.vx *= damp
	p.vy *= damp
	integrate(p)
	p.actionTimer -= 1
	return p.actionTimer <= 0
end
--* Where an ice field, a portal or an eastwind slow a player, the lowest multiplier applies (the minimum, not the product). 
local iceSlowMult, portalSlowMult, eastwindSlowMult
local function maxSpeedOf(state, p)
	local sailMult = if p.sailTicks > 0 then K.SAIL_SPEED_MULT else 1
	local slowMult = math.min(iceSlowMult(state, p), portalSlowMult(state, p), eastwindSlowMult(state, p))
	return (K.PLAYER_BASE_SPEED + p.stats.speed * K.PLAYER_SPEED_PER_STAT) * slowMult * sailMult
end
--[[
	*
	 * Speed multiplier from Zhen Ji's ice fields: ICE_SLOW_MULT while the player stands within ICE_RADIUS of a field cast by an
	 * opponent. Invincible players are unaffected. It is computed from position each tick, so leaving a field restores speed at once.
	 
]]
local isInvincible, distance
function iceSlowMult(state, p)
	if isInvincible(p) then
		return 1
	end
	for _, f in state.iceFields do
		if f.team ~= p.team and distance(f.x, f.y, p.x, p.y) <= K.ICE_RADIUS then
			return K.ICE_SLOW_MULT
		end
	end
	return 1
end
--[[
	*
	 * Speed multiplier from Daqiao's portals: PORTAL_SLOW_MULT while the player stands within PORTAL_RADIUS of a portal cast by an
	 * opponent. Invincible players are unaffected. Computed from position each tick, like iceSlowMult.
	 
]]
function portalSlowMult(state, p)
	if isInvincible(p) then
		return 1
	end
	for _, f in state.portals do
		if f.team ~= p.team and distance(f.x, f.y, p.x, p.y) <= K.PORTAL_RADIUS then
			return K.PORTAL_SLOW_MULT
		end
	end
	return 1
end
--* Unit vector of the held direction, or zero when no direction is held. 
local function inputDir(input)
	if input.moveX == 0 and input.moveY == 0 then
		return {
			x = 0,
			y = 0,
		}
	end
	local len = math.sqrt(input.moveX * input.moveX + input.moveY * input.moveY)
	return {
		x = input.moveX / len,
		y = input.moveY / len,
	}
end
function toNormal(p)
	p.action = "normal"
	p.actionTimer = 0
end
local function startAttack(state, p, kind, ticks)
	p.action = kind
	p.actionTimer = ticks
	p.hitDone = false
	local _events = state.events
	local _arg0 = {
		type = "attack",
		playerIdx = p.idx,
		kind = kind,
	}
	table.insert(_events, _arg0)
end
local function startRecover(p)
	p.action = "recover"
	p.actionTimer = K.RECOVER_TICKS
end
local function setDown(p, ticks)
	p.action = "down"
	p.actionTimer = ticks
end
local trySpecial, endRampage, passBall, startSpecial, moveCharging, startDive
function updateNormal(state, p, input)
	local dir = inputDir(input)
	local moving = dir.x ~= 0 or dir.y ~= 0
	if moving then
		p.facingX = dir.x
		p.facingY = dir.y
	end
	-- A lunge or beam cast takes over the whole tick: its movement is set by startLunge / startBeamCast and their updates.
	if trySpecial(state, p, input) and p.action ~= "normal" then
		return nil
	end
	-- A rampage replaces the dash: no dash drain, and the rampage speed applies instead.
	local rampaging = p.rampageTicks > 0
	local dashHeld = not rampaging and input.dash and p.stamina > 0
	if dashHeld and moving then
		p.stamina -= K.DASH_STAMINA_COST * K.DT
	else
		p.stamina += K.STAMINA_REGEN * K.DT
	end
	p.stamina = math.min(p.maxStamina, math.max(0, p.stamina))
	local ownsBall = state.ball.ownerIdx == p.idx
	local baseSpeed = maxSpeedOf(state, p)
	-- Silenced (a leap landing): only movement works, so J and K do nothing.
	local silenced = p.silenceTicks > 0
	if ownsBall and not silenced then
		if input.k and not p.prevInput.k then
			if rampaging then
				endRampage(state, p)
			end
			passBall(state, p)
			integrate(p)
			return nil
		end
		if input.j and not p.prevInput.j and rampaging then
			endRampage(state, p)
			startSpecial(state, p)
			return nil
		end
		if input.j and not p.prevInput.j then
			p.action = "charge"
			p.chargeTicks = 0
			moveCharging(state, p, input)
			return nil
		end
	end
	if input.k and not p.prevInput.k and not silenced then
		p.callPassTicks = K.CALL_PASS_TICKS
		local _events = state.events
		local _arg0 = {
			type = "callPass",
			playerIdx = p.idx,
		}
		table.insert(_events, _arg0)
	end
	-- A rampage without the ball (a no-ball special) makes J do nothing: no punch, tackle or dive.
	if input.j and not p.prevInput.j and not ownsBall and not rampaging and not silenced then
		if dashHeld then
			-- While sailing the tackle keeps the sail speed: no extra burst on top of it.
			local tackleMult = if p.sailTicks > 0 then 1 else K.TACKLE_SPEED_MULT
			startAttack(state, p, "tackle", K.TACKLE_TICKS)
			p.vx = p.facingX * baseSpeed * tackleMult
			p.vy = p.facingY * baseSpeed * tackleMult
		elseif p.role == "GK" and inOwnArea(state, p) and p.z == 0 and p.vz == 0 then
			startDive(state, p, input)
			return nil
		else
			startAttack(state, p, "punch", K.PUNCH_TICKS)
			p.vx *= PUNCH_WALK_MULT
			p.vy *= PUNCH_WALK_MULT
		end
		integrate(p)
		return nil
	end
	-- The sail's speed does not stack with dash: while sailing, dash leaves the speed at the sail speed.
	local maxSpeed = if rampaging then baseSpeed * K.RAMPAGE_SPEED_MULT elseif dashHeld and p.sailTicks == 0 then baseSpeed * K.DASH_MULT else baseSpeed
	local k = math.min(1, (K.PLAYER_ACCEL * K.DT) / p.mass)
	p.vx += (dir.x * maxSpeed - p.vx) * k
	p.vy += (dir.y * maxSpeed - p.vy) * k
	integrate(p)
end
local findVictim, applyHit
function updatePunch(state, p)
	local done = coast(p, PUNCH_DAMP)
	local elapsed = K.PUNCH_TICKS - p.actionTimer
	if not p.hitDone and elapsed >= K.PUNCH_ACTIVE_FROM and elapsed <= K.PUNCH_ACTIVE_TO then
		local reach = p.radius + K.PUNCH_RANGE
		local cx = p.x + p.facingX * reach
		local cy = p.y + p.facingY * reach
		local victim = findVictim(state, p, function(v)
			return math.abs(v.z - p.z) < AIR_HIT_Z and distance(cx, cy, v.x, v.y) < K.PUNCH_HIT_RADIUS + v.radius
		end)
		if victim then
			p.hitDone = true
			applyHit(state, p, victim, "punch")
		end
	end
	if done then
		toNormal(p)
	end
end
function updateTackle(state, p)
	local done = coast(p, TACKLE_DAMP)
	if not p.hitDone then
		local victim = findVictim(state, p, function(v)
			return v.z < TACKLE_MAX_VICTIM_Z and distance(p.x, p.y, v.x, v.y) < p.radius + v.radius + TACKLE_CONTACT_PAD
		end)
		if victim then
			p.hitDone = true
			applyHit(state, p, victim, "tackle")
		end
	end
	if done then
		startRecover(p)
	end
end
--* Goalkeeper dive: a fast slide along the held direction (or facing) with a small hop. 
function startDive(state, p, input)
	local dir = inputDir(input)
	if dir.x ~= 0 or dir.y ~= 0 then
		p.facingX = dir.x
		p.facingY = dir.y
	end
	p.action = "dive"
	p.actionTimer = K.GK_DIVE_TICKS
	p.vx = p.facingX * K.GK_DIVE_SPEED
	p.vy = p.facingY * K.GK_DIVE_SPEED
	p.vz = GK_DIVE_VZ
	local _events = state.events
	local _arg0 = {
		type = "dive",
		playerIdx = p.idx,
	}
	table.insert(_events, _arg0)
	integrate(p)
end
--* Dive slides, decaying each tick, then turns into a recover. 
function updateDive(p)
	p.vx *= GK_DIVE_DAMP
	p.vy *= GK_DIVE_DAMP
	integrate(p)
	p.actionTimer -= 1
	if p.actionTimer <= 0 then
		p.action = "recover"
		p.actionTimer = K.GK_DIVE_RECOVER_TICKS
	end
end
--* Ball-carrier charging a shot: slow movement, no dash, no stamina regen. Releasing J shoots. 
local releaseCharge
function updateCharge(state, p, input)
	if state.ball.ownerIdx ~= p.idx then
		p.chargeTicks = 0
		toNormal(p)
		return nil
	end
	if trySpecial(state, p, input) then
		p.chargeTicks = 0
		return nil
	end
	if not input.j and p.prevInput.j then
		releaseCharge(state, p, input)
		return nil
	end
	if p.chargeTicks < K.CHARGE_FULL then
		p.chargeTicks += 1
		if p.chargeTicks == K.CHARGE_FULL then
			local _events = state.events
			local _arg0 = {
				type = "chargeFull",
				playerIdx = p.idx,
			}
			table.insert(_events, _arg0)
		end
	end
	moveCharging(state, p, input)
end
function moveCharging(state, p, input)
	local dir = inputDir(input)
	if dir.x ~= 0 or dir.y ~= 0 then
		p.facingX = dir.x
		p.facingY = dir.y
	end
	local maxSpeed = maxSpeedOf(state, p) * K.CHARGE_MOVE_MULT
	local k = math.min(1, (K.PLAYER_ACCEL * K.DT) / p.mass)
	p.vx += (dir.x * maxSpeed - p.vx) * k
	p.vy += (dir.y * maxSpeed - p.vy) * k
	integrate(p)
end
--* Picks the shot on J release: a shot toward the goal (power by charge), else a clear. 
local shoot, kickClear
function releaseCharge(state, p, input)
	local charge = p.chargeTicks
	p.chargeTicks = 0
	local towardGoal = p.facingX * attackDir(state, p.team) > 0
	if towardGoal then
		shoot(state, p, input, charge)
	else
		kickClear(state, p)
	end
end
--[[
	*
	 * Buffered L press: starts the special if a press is buffered, the match is in play, and it is ready (cooldown 0,
	 * enough stamina). A roar (Zhang Fei) and a fear (Zhang Liao) are instant. Every other special needs the ball unless
	 * its character has specialNoBall; a rampage, lunge, beam, leap or ride starts at once, and a summon keeps the ball.
	 * A special that cannot start yet keeps the buffer. Returns true if it started.
	 
]]
local castRoar, castFear, startLunge, startBeamCast, startSummon, startLeap, startTiger, startSlash, startRide, startIcefield, startSail, startGust, startPortal, startEastwind, startArrowship, startRampage
function trySpecial(state, p, input)
	if p.specialBuffer == 0 or state.match.phase ~= "play" or p.silenceTicks > 0 then
		return false
	end
	if p.specialCooldown > 0 or p.stamina < K.SPECIAL_STAMINA_COST then
		return false
	end
	if p.specialMode == "roar" then
		p.specialBuffer = 0
		castRoar(state, p)
		return true
	end
	if p.specialMode == "fear" then
		p.specialBuffer = 0
		castFear(state, p)
		return true
	end
	if not p.specialNoBall and state.ball.ownerIdx ~= p.idx then
		return false
	end
	p.specialBuffer = 0
	if p.specialMode == "lunge" then
		startLunge(state, p, input)
	elseif p.specialMode == "beam" then
		startBeamCast(state, p)
	elseif p.specialMode == "summon" then
		startSummon(state, p)
	elseif p.specialMode == "leap" then
		startLeap(state, p)
	elseif p.specialMode == "tiger" then
		startTiger(state, p)
	elseif p.specialMode == "slash" then
		startSlash(state, p)
	elseif p.specialMode == "ride" then
		startRide(state, p)
	elseif p.specialMode == "icefield" then
		startIcefield(state, p)
	elseif p.specialMode == "sail" then
		startSail(state, p)
	elseif p.specialMode == "gust" then
		startGust(state, p)
	elseif p.specialMode == "portal" then
		startPortal(state, p)
	elseif p.specialMode == "eastwind" then
		startEastwind(state, p)
	elseif p.specialMode == "arrowship" then
		startArrowship(state, p)
	else
		startRampage(state, p)
	end
	return true
end
--* Special L: the player's rampage starts. With the ball he keeps it; the special ball flies on the next J press. 
function startRampage(state, p)
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.rampageTicks = K.RAMPAGE_TICKS
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	p.action = "normal"
	p.actionTimer = 0
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "rampageStart",
		playerIdx = p.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * Special L with the ball (Zhao Yun): a fixed-speed dash along the held direction (or facing). The player keeps the ball
	 * at his feet and is invincible for the lunge's LUNGE_TICKS ticks.
	 
]]
function startLunge(state, p, input)
	local dir = inputDir(input)
	if dir.x ~= 0 or dir.y ~= 0 then
		p.facingX = dir.x
		p.facingY = dir.y
	end
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	p.chargeTicks = 0
	p.action = "lunge"
	p.actionTimer = K.LUNGE_TICKS
	p.vx = p.facingX * K.LUNGE_SPEED
	p.vy = p.facingY * K.LUNGE_SPEED
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "lungeStart",
		playerIdx = p.idx,
		x = p.x,
		y = p.y,
		dirX = p.facingX,
		dirY = p.facingY,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * One lunge tick: the velocity stays fixed and input is ignored. The lunge ends when its timer runs out, when the
	 * player reaches the field edge, or when the phase leaves play.
	 
]]
local endLunge, ballIntoGoal
function updateLunge(state, p)
	if state.match.phase ~= "play" then
		endLunge(state, p)
		return nil
	end
	local nextX = p.x + p.vx * K.DT
	local nextY = p.y + p.vy * K.DT
	local atEdge = nextX < 0 or nextX > K.FIELD_W or nextY < 0 or nextY > K.FIELD_D
	-- Reaching the opponent's goal line inside the mouth (ball radius inset) scores; the lunge never scores into his own goal.
	local side = if attackDir(state, p.team) == 1 then 1 else 0
	local mouth = goalMouth(side)
	local onGoalLine = if side == 1 then nextX >= K.FIELD_W else nextX <= 0
	local inMouth = nextY >= mouth.yMin + K.BALL_RADIUS and nextY <= mouth.yMax - K.BALL_RADIUS
	integrate(p)
	p.actionTimer -= 1
	if onGoalLine and inMouth and state.ball.ownerIdx == p.idx then
		ballIntoGoal(state, p, side, p.vx, p.vy)
		endLunge(state, p)
	elseif atEdge or p.actionTimer <= 0 then
		endLunge(state, p)
	end
end
--[[
	*
	 * A lunger's or rampager's ball leaves his feet at (vx, vy) and is placed just past the goal line of `side`, so the goal
	 * check in updateMatch scores it this tick (the ball is past the line, so pickup and possession skip it).
	 
]]
local releaseBall
function ballIntoGoal(state, p, side, vx, vy)
	releaseBall(state, p, vx, vy, 0)
	local ball = state.ball
	ball.x = if side == 1 then K.FIELD_W + K.BALL_RADIUS + 1 else -(K.BALL_RADIUS + 1)
	ball.y = p.y
	ball.z = 0
end
--* Back to normal play. The lunge speed is scaled down to the player's normal top speed, keeping its direction. 
function endLunge(state, p)
	local maxSpeed = maxSpeedOf(state, p)
	local speed = math.sqrt(p.vx * p.vx + p.vy * p.vy)
	if speed > maxSpeed then
		p.vx = (p.vx / speed) * maxSpeed
		p.vy = (p.vy / speed) * maxSpeed
	end
	toNormal(p)
	local _events = state.events
	local _arg0 = {
		type = "lungeEnd",
		playerIdx = p.idx,
		x = p.x,
		y = p.y,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Simayi's leap (鷹視狼顧): a back-hop opposite his facing, then a long flight along it, invincible throughout. He keeps
	 * any ball at his feet. The landing hits the opponents near him (see landLeap).
	 
]]
function startLeap(state, p)
	local len = math.sqrt(p.facingX * p.facingX + p.facingY * p.facingY)
	if len > 0 then
		p.facingX /= len
		p.facingY /= len
	else
		p.facingX = attackDir(state, p.team)
		p.facingY = 0
	end
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	p.chargeTicks = 0
	p.action = "leap"
	p.actionTimer = K.LEAP_BACK_TICKS + K.LEAP_FLY_TICKS
	local backSpeed = (K.LEAP_BACK_DISTANCE / K.LEAP_BACK_TICKS) * K.TICK_HZ
	p.vx = -p.facingX * backSpeed
	p.vy = -p.facingY * backSpeed
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "leapStart",
		playerIdx = p.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * One leap tick. The back-hop runs while the timer is above LEAP_FLY_TICKS; the flight follows, with z on a parabola that
	 * peaks at LEAP_PEAK_Z and is 0 on landing. Input is ignored. The leap ends (and lands) when its timer runs out, or ends
	 * quietly when the phase leaves play.
	 
]]
local endLeap, landLeap
function updateLeap(state, p)
	if state.match.phase ~= "play" then
		endLeap(p)
		return nil
	end
	p.actionTimer -= 1
	-- Flight tick n is 1..LEAP_FLY_TICKS; back-hop ticks are 0 or below.
	local flyTick = K.LEAP_FLY_TICKS - p.actionTimer
	if flyTick == 1 then
		local flySpeed = (K.LEAP_FLY_DISTANCE / K.LEAP_FLY_TICKS) * K.TICK_HZ
		p.vx = p.facingX * flySpeed
		p.vy = p.facingY * flySpeed
		local _events = state.events
		local _arg0 = {
			type = "leapFly",
			playerIdx = p.idx,
		}
		table.insert(_events, _arg0)
	end
	integrate(p)
	if flyTick < 1 then
		return nil
	end
	local t = math.min(1, flyTick / K.LEAP_FLY_TICKS)
	p.z = 4 * K.LEAP_PEAK_Z * t * (1 - t)
	p.vz = 0
	if p.actionTimer <= 0 then
		landLeap(state, p)
	end
end
--* Back to normal on the spot, with no velocity and on the ground. Used when the phase leaves play. 
function endLeap(p)
	p.z = 0
	p.vz = 0
	p.vx = 0
	p.vy = 0
	toNormal(p)
end
--[[
	*
	 * Leap landing: every opponent within LEAP_RADIUS of his landing point that is not invincible is hit (see leapVictim).
	 * The landing is reported before the hits.
	 
]]
local leapVictim
function landLeap(state, p)
	endLeap(p)
	local _exp = state.players
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(v)
		return v.team ~= p.team and not isInvincible(v) and distance(p.x, p.y, v.x, v.y) <= K.LEAP_RADIUS
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	local victims = _newValue
	local _events = state.events
	local _object = {
		type = "leapLand",
		playerIdx = p.idx,
		x = p.x,
		y = p.y,
	}
	local _left = "victimIdxs"
	-- ▼ ReadonlyArray.map ▼
	local _newValue_1 = table.create(#victims)
	local _callback_1 = function(v)
		return v.idx
	end
	for _k, _v in victims do
		_newValue_1[_k] = _callback_1(_v, _k - 1, victims)
	end
	-- ▲ ReadonlyArray.map ▲
	_object[_left] = _newValue_1
	table.insert(_events, _object)
	for _, v in victims do
		leapVictim(state, p, v)
	end
end
--[[
	*
	 * One leap victim: cancels a beam channel, loses LEAP_STAMINA_RATIO of maxStamina and is silenced for SILENCE_TICKS. Going
	 * to zero stamina knocks him down (a down player keeps his timer). Otherwise he is stunned for HITSTUN_TICKS, unless he is
	 * already down or recovering. He keeps any ball he holds.
	 
]]
local reportCastCancel
function leapVictim(state, p, v)
	reportCastCancel(state, v)
	v.chargeTicks = 0
	local cost = K.LEAP_STAMINA_RATIO * v.maxStamina
	v.stamina = math.max(0, v.stamina - cost)
	v.silenceTicks = K.SILENCE_TICKS
	local down = false
	if v.stamina <= 0 then
		if v.action ~= "down" then
			setDown(v, K.DOWN_TICKS_EXHAUSTED)
			down = true
		end
	elseif v.action ~= "down" and v.action ~= "recover" then
		v.action = "hitstun"
		v.actionTimer = K.HITSTUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = p.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = v.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
end
--[[
	*
	 * Guan Yu's ride (騎士衝擊): a constant-speed motorcycle dash of RIDE_DISTANCE along his facing (the attack direction when
	 * he has none), with or without the ball. He is invincible for the whole dash and any ball stays at his feet.
	 
]]
function startRide(state, p)
	local len = math.sqrt(p.facingX * p.facingX + p.facingY * p.facingY)
	if len > 0 then
		p.facingX /= len
		p.facingY /= len
	else
		p.facingX = attackDir(state, p.team)
		p.facingY = 0
	end
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	p.chargeTicks = 0
	p.rideHits = {}
	p.action = "ride"
	p.actionTimer = K.RIDE_TICKS
	p.vx = p.facingX * K.RIDE_SPEED
	p.vy = p.facingY * K.RIDE_SPEED
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "rideStart",
		playerIdx = p.idx,
		dirX = p.facingX,
		dirY = p.facingY,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * One ride tick: the velocity stays fixed and input is ignored. After moving, the bike hits its lane (see rideHitLane).
	 * A goal inside the mouth with the ball scores as a lunge does. The ride ends when its timer runs out, at the field edge,
	 * or after a goal. When the phase leaves play it also ends (rideEnd is still reported, like a lunge).
	 
]]
local rideHitLane, endRide
function updateRide(state, p)
	if state.match.phase ~= "play" then
		toNormal(p)
		local _events = state.events
		local _arg0 = {
			type = "rideEnd",
			playerIdx = p.idx,
		}
		table.insert(_events, _arg0)
		return nil
	end
	local nextX = p.x + p.vx * K.DT
	local nextY = p.y + p.vy * K.DT
	local atEdge = nextX < 0 or nextX > K.FIELD_W or nextY < 0 or nextY > K.FIELD_D
	local side = if attackDir(state, p.team) == 1 then 1 else 0
	local mouth = goalMouth(side)
	local onGoalLine = if side == 1 then nextX >= K.FIELD_W else nextX <= 0
	local inMouth = nextY >= mouth.yMin + K.BALL_RADIUS and nextY <= mouth.yMax - K.BALL_RADIUS
	integrate(p)
	p.actionTimer -= 1
	rideHitLane(state, p)
	if onGoalLine and inMouth and state.ball.ownerIdx == p.idx then
		ballIntoGoal(state, p, side, p.vx, p.vy)
		endRide(state, p)
	elseif atEdge or p.actionTimer <= 0 then
		endRide(state, p)
	end
end
--* Back to normal play, with the ride speed scaled down to the player's normal top speed, keeping its direction. 
function endRide(state, p)
	local maxSpeed = maxSpeedOf(state, p)
	local speed = math.sqrt(p.vx * p.vx + p.vy * p.vy)
	if speed > maxSpeed then
		p.vx = (p.vx / speed) * maxSpeed
		p.vy = (p.vy / speed) * maxSpeed
	end
	toNormal(p)
	local _events = state.events
	local _arg0 = {
		type = "rideEnd",
		playerIdx = p.idx,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Bike hits: every opponent that is not down, recovering or invincible, and not hit yet this dash, is hit once when its
	 * centre is within RIDE_LANE_HALF of the ride line and within the rider's radius + RIDE_CONTACT_PAD of him along the ride.
	 
]]
local rideBump
function rideHitLane(state, p)
	for _, v in state.players do
		if v.team == p.team or v.action == "down" or v.action == "recover" or isInvincible(v) then
			continue
		end
		local _rideHits = p.rideHits
		local _idx = v.idx
		if table.find(_rideHits, _idx) ~= nil then
			continue
		end
		local dx = v.x - p.x
		local dy = v.y - p.y
		-- Signed distance from the ride line, positive on the left of the ride direction (-facingY, facingX).
		local lateral = dy * p.facingX - dx * p.facingY
		local along = dx * p.facingX + dy * p.facingY
		if math.abs(lateral) > K.RIDE_LANE_HALF then
			continue
		end
		if math.abs(along) > p.radius + K.RIDE_CONTACT_PAD then
			continue
		end
		local _rideHits_1 = p.rideHits
		local _idx_1 = v.idx
		table.insert(_rideHits_1, _idx_1)
		rideBump(state, p, v, lateral)
	end
end
--[[
	*
	 * One ride victim: pushed away from the ride line and forward along the ride (a victim exactly on the line goes to the side
	 * by idx parity), stunned or knocked down when his stamina empties, and loses the ride's stamina share. He drops the ball
	 * if holding it, and a beam channel is cancelled.
	 
]]
local knockLooseBall
function rideBump(state, p, v, lateral)
	reportCastCancel(state, v)
	v.chargeTicks = 0
	local side = if lateral > 0 then 1 elseif lateral < 0 then -1 elseif v.idx % 2 == 0 then 1 else -1
	local massMult = math.min(1.5, math.max(0.7, p.mass / v.mass))
	local vx = (-p.facingY * side * K.RIDE_PUSH_SIDE + p.facingX * K.RIDE_PUSH_FORWARD) * massMult
	local vy = (p.facingX * side * K.RIDE_PUSH_SIDE + p.facingY * K.RIDE_PUSH_FORWARD) * massMult
	v.vx = vx
	v.vy = vy
	local cost = if p.specialBumpPct ~= nil then p.specialBumpPct * v.maxStamina else K.RAMPAGE_BUMP_STAMINA
	v.stamina = math.max(0, v.stamina - cost)
	local down = false
	if v.stamina <= 0 then
		setDown(v, K.DOWN_TICKS_EXHAUSTED)
		down = true
	else
		v.action = "hitstun"
		v.actionTimer = K.RIDE_HITSTUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = p.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	if state.ball.ownerIdx == v.idx then
		local len = math.sqrt(vx * vx + vy * vy)
		knockLooseBall(state, p, v, vx / len, vy / len)
	end
	local _events_1 = state.events
	local _arg0_1 = {
		type = "rideHit",
		playerIdx = p.idx,
		victimIdx = v.idx,
		x = p.x,
		y = p.y,
	}
	table.insert(_events_1, _arg0_1)
	if down then
		local _events_2 = state.events
		local _arg0_2 = {
			type = "down",
			playerIdx = v.idx,
		}
		table.insert(_events_2, _arg0_2)
	end
end
--* Unit direction from (x, y) to the centre of the goal the team attacks. Falls back to the attack direction on the line. 
local function aimAtGoalCentre(state, team, x, y)
	local dx = opponentGoalX(state, team) - x
	local dy = K.FIELD_D / 2 - y
	local len = math.sqrt(dx * dx + dy * dy)
	return if len > 0 then {
		x = dx / len,
		y = dy / len,
	} else {
		x = attackDir(state, team),
		y = 0,
	}
end
--[[
	*
	 * Zhuge Liang's beam (破魔光彈): the player turns to the goal, stands still and channels for BEAM_CAST_TICKS. The beam
	 * strikes when the channel ends (see updateCast).
	 
]]
function startBeamCast(state, p)
	local aim = aimAtGoalCentre(state, p.team, p.x, p.y)
	p.facingX = aim.x
	p.facingY = aim.y
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	p.chargeTicks = 0
	p.vx = 0
	p.vy = 0
	p.action = "cast"
	p.actionTimer = K.BEAM_CAST_TICKS
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "beamCharge",
		playerIdx = p.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * One beam channel tick: the player stands still and ignores input. The channel ends in beamStrike when its timer runs
	 * out. A hit interrupts it (see reportCastCancel), and it also ends back to normal if the phase leaves play.
	 
]]
local beamStrike
function updateCast(state, p)
	if state.match.phase ~= "play" then
		reportCastCancel(state, p)
		toNormal(p)
		return nil
	end
	p.vx = 0
	p.vy = 0
	p.actionTimer -= 1
	if p.actionTimer <= 0 then
		beamStrike(state, p)
	end
end
--* A channel that is cut short (the caster is hit, or the phase leaves play) reports beamCancel. Call before the action changes. 
function reportCastCancel(state, p)
	if p.action ~= "cast" then
		return nil
	end
	local _events = state.events
	local _arg0 = {
		type = "beamCancel",
		playerIdx = p.idx,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * The channel is done: the beam strikes one random opponent that is standing (not down or recovering) and not invincible.
	 * With no such opponent nothing happens. The caster goes back to normal and keeps the ball.
	 
]]
local beamStrikeVictim
function beamStrike(state, p)
	toNormal(p)
	local _exp = state.players
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(v)
		return v.team ~= p.team and v.action ~= "down" and v.action ~= "recover" and not isInvincible(v)
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	local candidates = _newValue
	if #candidates == 0 then
		return nil
	end
	local victim = candidates[rngInt(state, #candidates) + 1]
	local _events = state.events
	local _arg0 = {
		type = "beamStrike",
		playerIdx = p.idx,
		victimIdx = victim.idx,
	}
	table.insert(_events, _arg0)
	beamStrikeVictim(state, p, victim)
end
--* One beam victim: knocked away from the caster, down for DOWN_TICKS_KNOCKED, loses a share of stamina, drops the ball if holding it. 
function beamStrikeVictim(state, p, v)
	reportCastCancel(state, v)
	local dist = distance(p.x, p.y, v.x, v.y)
	local dirX = if dist > 0 then (v.x - p.x) / dist else p.facingX
	local dirY = if dist > 0 then (v.y - p.y) / dist else p.facingY
	local knock = (K.KNOCKBACK_SPEED * p.mass) / v.mass
	v.vx = dirX * knock
	v.vy = dirY * knock
	v.vz = HIT_VZ
	v.chargeTicks = 0
	local damage = K.BEAM_STRIKE_STAMINA_RATIO * v.maxStamina
	v.stamina = math.max(0, v.stamina - damage)
	setDown(v, K.DOWN_TICKS_KNOCKED)
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = p.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = damage,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "down",
		playerIdx = v.idx,
	}
	table.insert(_events_1, _arg0_1)
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, p, v, dirX, dirY)
	end
end
--[[
	*
	 * Ma Chao's summon (西涼鐵騎): the player keeps the ball and SUMMON_RIDERS riders appear on a circle around him, starting
	 * behind him. Each rider charges a different opponent where possible. The riders are moved by updateRiders.
	 
]]
local pickRiderTarget, riderHeading
function startSummon(state, p)
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "summonStart",
		playerIdx = p.idx,
		x = p.x,
		y = p.y,
	}
	table.insert(_events_1, _arg0_1)
	local baseAngle = math.atan2(-p.facingY, -p.facingX)
	local claimed = {}
	for i = 0, K.SUMMON_RIDERS - 1 do
		local angle = baseAngle + (i * 2 * math.pi) / K.SUMMON_RIDERS
		local x = math.min(K.FIELD_W, math.max(0, p.x + math.cos(angle) * K.RIDER_SPAWN_RADIUS))
		local y = math.min(K.FIELD_D, math.max(0, p.y + math.sin(angle) * K.RIDER_SPAWN_RADIUS))
		local rider = {
			id = state.tick * K.SUMMON_RIDERS + i,
			team = p.team,
			ownerIdx = p.idx,
			x = x,
			y = y,
			vx = 0,
			vy = 0,
			facingX = p.facingX,
			targetIdx = -1,
			slot = i,
			wanderAngle = rngNext(state) * 2 * math.pi,
			wanderTicks = K.RIDER_WANDER_TICKS,
			ticksLeft = K.SUMMON_TICKS,
			hit = {},
		}
		rider.targetIdx = pickRiderTarget(state, rider, claimed)
		if rider.targetIdx ~= -1 then
			local _targetIdx = rider.targetIdx
			table.insert(claimed, _targetIdx)
		end
		-- Starts at full speed toward its aim point (or in its roaming direction when there is no target).
		local heading = riderHeading(state, rider)
		rider.vx = heading.x * K.RIDER_SPEED
		rider.vy = heading.y * K.RIDER_SPEED
		local _exp = state.riders
		table.insert(_exp, rider)
		local _events_2 = state.events
		local _arg0_2 = {
			type = "riderSpawn",
			riderId = rider.id,
			x = x,
			y = y,
		}
		table.insert(_events_2, _arg0_2)
	end
end
--[[
	*
	 * Unit direction the rider steers along. With a target it aims at the target plus a lateral offset to the side of the
	 * rider's slot (the offset shrinks as the rider closes in), so riders curve in from different sides. Without one it
	 * follows the roaming direction.
	 
]]
function riderHeading(state, r)
	if r.targetIdx ~= -1 then
		local t = state.players[r.targetIdx + 1]
		local dx = t.x - r.x
		local dy = t.y - r.y
		local dist = math.sqrt(dx * dx + dy * dy)
		if dist > 0 then
			local side = if r.slot % 2 == 0 then 1 else -1
			local lateral = side * (1 + r.slot * K.RIDER_LATERAL_SLOT_GROWTH) * math.min(K.RIDER_LATERAL_MAX, dist * K.RIDER_LATERAL_RATIO)
			local perpX = -dy / dist
			local perpY = dx / dist
			local aimX = t.x + perpX * lateral - r.x
			local aimY = t.y + perpY * lateral - r.y
			local aimLen = math.sqrt(aimX * aimX + aimY * aimY)
			if aimLen > 0 then
				return {
					x = aimX / aimLen,
					y = aimY / aimLen,
				}
			end
		end
	end
	return {
		x = math.cos(r.wanderAngle),
		y = math.sin(r.wanderAngle),
	}
end
--* A rider may charge a player that is an opponent, standing, not invincible, and not already knocked down by it. 
local function isRiderTargetOk(v, r)
	local _condition = v.team ~= r.team and v.action ~= "down" and not isInvincible(v)
	if _condition then
		local _hit = r.hit
		local _idx = v.idx
		_condition = not (table.find(_hit, _idx) ~= nil)
	end
	return _condition
end
--[[
	*
	 * Nearest valid opponent to the rider (ties: lowest idx), skipping the idxs in `claimed`. If every valid opponent is
	 * claimed, the nearest valid one is returned anyway. -1 if no opponent is valid.
	 
]]
function pickRiderTarget(state, r, claimed)
	local best = -1
	local bestDist = math.huge
	for _, v in state.players do
		local _condition = not isRiderTargetOk(v, r)
		if not _condition then
			local _claimed = claimed
			local _idx = v.idx
			_condition = table.find(_claimed, _idx) ~= nil
		end
		if _condition then
			continue
		end
		local d = distance(r.x, r.y, v.x, v.y)
		if d < bestDist then
			best = v.idx
			bestDist = d
		end
	end
	if best ~= -1 or #claimed == 0 then
		return best
	end
	return pickRiderTarget(state, r, {})
end
--[[
	*
	 * One tick for every rider in play: steer toward its target (re-picking when the target is no longer valid), move and
	 * bounce off the field edges, knock down the first opponents it touches, and vanish when its timer runs out.
	 * Riders never collide with players, cannot be hit, and do not touch the ball except through a knocked-down carrier.
	 
]]
local separateRiders, advanceRider
local function updateRiders(state)
	separateRiders(state.riders)
	local _exp = state.riders
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(r)
		advanceRider(state, r)
		r.ticksLeft -= 1
		if r.ticksLeft > 0 then
			return true
		end
		local _events = state.events
		local _arg0 = {
			type = "riderEnd",
			riderId = r.id,
			x = r.x,
			y = r.y,
		}
		table.insert(_events, _arg0)
		return false
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	state.riders = _newValue
end
--* Pushes every pair of riders closer than RIDER_SEPARATION_DIST apart in velocity, harder the closer they are. 
function separateRiders(riders)
	for i = 0, #riders - 1 do
		do
			local j = i + 1
			local _shouldIncrement = false
			while true do
				if _shouldIncrement then
					j += 1
				else
					_shouldIncrement = true
				end
				if not (j < #riders) then
					break
				end
				local a = riders[i + 1]
				local b = riders[j + 1]
				local dx = b.x - a.x
				local dy = b.y - a.y
				local dist = math.sqrt(dx * dx + dy * dy)
				if dist >= K.RIDER_SEPARATION_DIST then
					continue
				end
				-- Exactly on top of each other: split along x, so the push is still defined.
				local nx = if dist > 0 then dx / dist else 1
				local ny = if dist > 0 then dy / dist else 0
				local push = K.RIDER_SEPARATION_ACCEL * (1 - dist / K.RIDER_SEPARATION_DIST) * K.DT
				a.vx -= nx * push
				a.vy -= ny * push
				b.vx += nx * push
				b.vy += ny * push
			end
		end
	end
end
--* Opponents already targeted by the other riders, so a rider can prefer a different one. 
local function claimedTargets(state, r)
	local claimed = {}
	for _, o in state.riders do
		if o ~= r and o.targetIdx ~= -1 then
			local _targetIdx = o.targetIdx
			table.insert(claimed, _targetIdx)
		end
	end
	return claimed
end
local riderKnockDown
function advanceRider(state, r)
	local current = if r.targetIdx ~= -1 then state.players[r.targetIdx + 1] else nil
	if current == nil or not isRiderTargetOk(current, r) then
		r.targetIdx = pickRiderTarget(state, r, claimedTargets(state, r))
	end
	if r.targetIdx == -1 then
		r.wanderTicks -= 1
		if r.wanderTicks <= 0 then
			r.wanderAngle = rngNext(state) * 2 * math.pi
			r.wanderTicks = K.RIDER_WANDER_TICKS
		end
	end
	local heading = riderHeading(state, r)
	r.vx += (heading.x * K.RIDER_SPEED - r.vx) * K.RIDER_TURN
	r.vy += (heading.y * K.RIDER_SPEED - r.vy) * K.RIDER_TURN
	r.x += r.vx * K.DT
	r.y += r.vy * K.DT
	if r.x < 0 then
		r.x = 0
		r.vx = math.abs(r.vx)
	elseif r.x > K.FIELD_W then
		r.x = K.FIELD_W
		r.vx = -math.abs(r.vx)
	end
	if r.y < 0 then
		r.y = 0
		r.vy = math.abs(r.vy)
	elseif r.y > K.FIELD_D then
		r.y = K.FIELD_D
		r.vy = -math.abs(r.vy)
	end
	if r.vx > 0 then
		r.facingX = 1
	elseif r.vx < 0 then
		r.facingX = -1
	end
	local owner = state.players[r.ownerIdx + 1]
	for _, v in state.players do
		local _condition = v.team == r.team or v.action == "down" or isInvincible(v)
		if not _condition then
			local _hit = r.hit
			local _idx = v.idx
			_condition = table.find(_hit, _idx) ~= nil
		end
		if _condition then
			continue
		end
		if distance(r.x, r.y, v.x, v.y) >= K.RIDER_HIT_RADIUS + v.radius then
			continue
		end
		riderKnockDown(state, r, owner, v)
	end
end
--[[
	*
	 * A rider knocks an opponent down with the same special hit a pierce uses, knocked away along the rider's direction.
	 * The hit takes the summoner's bump share of the victim's maxStamina (SPECIAL_HIT_STAMINA when he has none).
	 * A carrier loses the ball, credited to the summoner as the last touch.
	 
]]
local applySpecialHit
function riderKnockDown(state, r, owner, v)
	local speed = math.sqrt(r.vx * r.vx + r.vy * r.vy)
	local dirX = if speed > 0 then r.vx / speed else r.facingX
	local dirY = if speed > 0 then r.vy / speed else 0
	local _hit = r.hit
	local _idx = v.idx
	table.insert(_hit, _idx)
	local cost = if owner.specialBumpPct ~= nil then owner.specialBumpPct * v.maxStamina else K.SPECIAL_HIT_STAMINA
	applySpecialHit(state, owner, v, "pierce", dirX, dirY, cost)
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, owner, v, dirX, dirY)
	end
	local _events = state.events
	local _arg0 = {
		type = "riderHit",
		riderId = r.id,
		victimIdx = v.idx,
		x = r.x,
		y = r.y,
	}
	table.insert(_events, _arg0)
end
--* Removes every rider, emitting riderEnd for each. Called when the phase leaves play. 
local function clearRiders(state)
	for _, r in state.riders do
		local _events = state.events
		local _arg0 = {
			type = "riderEnd",
			riderId = r.id,
			x = r.x,
			y = r.y,
		}
		table.insert(_events, _arg0)
	end
	state.riders = {}
end
--* Counts the special cooldown down while the match is in play. 
function tickSpecialCooldown(state, p)
	if p.specialCooldown > 0 and state.match.phase == "play" then
		p.specialCooldown -= 1
	end
end
--[[
	*
	 * Zhang Fei's roar: a shockwave centred ROAR_FORWARD in front of the player. Every standing opponent in the circle
	 * (rampaging ones are immune) is knocked away from the roarer and stunned. The roarer keeps any ball it has. A ball that
	 * was free when the roar fired and lies in the circle is knocked away too (see roarBall).
	 
]]
local roarKnock, roarBall
function castRoar(state, p)
	p.stamina = math.max(0, p.stamina - K.SPECIAL_STAMINA_COST)
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	toNormal(p)
	local cx = p.x + p.facingX * K.ROAR_FORWARD
	local cy = p.y + p.facingY * K.ROAR_FORWARD
	-- Taken before the victims are knocked: a carrier dropped by this roar is not a free ball for it.
	local ballFree = state.ball.ownerIdx == -1
	local _events = state.events
	local _arg0 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "roar",
		playerIdx = p.idx,
		x = cx,
		y = cy,
		radius = K.ROAR_RADIUS,
	}
	table.insert(_events_1, _arg0_1)
	for _, v in state.players do
		if v.team == p.team or v.action == "down" or isInvincible(v) then
			continue
		end
		if distance(cx, cy, v.x, v.y) > K.ROAR_RADIUS then
			continue
		end
		roarKnock(state, p, v)
	end
	if ballFree then
		roarBall(state, p, cx, cy)
	end
end
--[[
	*
	 * The roar's hit on a free ball whose x, y lies in the circle, at any height. A special shot ends (specialEnd). A tiger
	 * ball held in Xu Chu's mouth is left alone; one in flight is cleared. The ball leaves the roarer at ROAR_BALL_SPEED,
	 * launched upward at ROAR_BALL_VZ, and the roarer is credited with the last touch.
	 
]]
function roarBall(state, p, cx, cy)
	local b = state.ball
	local _result = b.tiger
	if _result ~= nil then
		_result = _result.phase
	end
	if _result == "hold" then
		return nil
	end
	if distance(cx, cy, b.x, b.y) > K.ROAR_RADIUS then
		return nil
	end
	b.tiger = nil
	if b.special ~= nil then
		b.special = nil
		local _exp = state.events
		table.insert(_exp, {
			type = "specialEnd",
		})
	end
	local dist = distance(p.x, p.y, b.x, b.y)
	local dirX = if dist > 0 then (b.x - p.x) / dist else p.facingX
	local dirY = if dist > 0 then (b.y - p.y) / dist else p.facingY
	b.vx = dirX * K.ROAR_BALL_SPEED
	b.vy = dirY * K.ROAR_BALL_SPEED
	b.vz = K.ROAR_BALL_VZ
	b.lastTouchIdx = p.idx
	local _events = state.events
	local _arg0 = {
		type = "roarBall",
		playerIdx = p.idx,
		x = b.x,
		y = b.y,
	}
	table.insert(_events, _arg0)
end
--* One roar victim: pushed away from the roarer, stunned, loses stamina (down when empty), drops the ball if holding it. 
function roarKnock(state, p, v)
	reportCastCancel(state, v)
	local dist = distance(p.x, p.y, v.x, v.y)
	local dirX = if dist > 0 then (v.x - p.x) / dist else p.facingX
	local dirY = if dist > 0 then (v.y - p.y) / dist else p.facingY
	local massMult = math.min(1.4, math.max(0.8, p.mass / v.mass))
	v.vx = dirX * K.ROAR_KNOCK_SPEED * massMult
	v.vy = dirY * K.ROAR_KNOCK_SPEED * massMult
	v.vz = ROAR_VZ
	v.chargeTicks = 0
	v.stamina = math.max(0, v.stamina - K.ROAR_STAMINA)
	local down = false
	if v.stamina <= 0 then
		setDown(v, K.DOWN_TICKS_EXHAUSTED)
		down = true
	else
		v.action = "hitstun"
		v.actionTimer = K.ROAR_STUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = p.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = K.ROAR_STAMINA,
	}
	table.insert(_events, _arg0)
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = v.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, p, v, dirX, dirY)
	end
end
--[[
	*
	 * Zhang Liao's fear (遼來了): an instant cast, with or without the ball. Every opponent within FEAR_RADIUS that is not
	 * invincible is feared (see fearVictim). The caster keeps any ball it has.
	 
]]
local fearVictim
function castFear(state, p)
	p.stamina = math.max(0, p.stamina - K.SPECIAL_STAMINA_COST)
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	toNormal(p)
