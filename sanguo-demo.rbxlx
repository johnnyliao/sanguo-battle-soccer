end
--* Nearest standing opponent of `team` within range, or null. Ties go to the lowest idx. 
function nearestOpponent(state, team, x, y, range)
	local best = nil
	local bestDist = range
	for _, t in state.players do
		if t.team == team or t.action == "down" then
			continue
		end
		local d = dist(t.x, t.y, x, y)
		if d < bestDist then
			best = t
			bestDist = d
		end
