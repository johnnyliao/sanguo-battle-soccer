	local _arg0_1 = {
		type = "slashStart",
		playerIdx = p.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--* Actions in which a slash swing cannot fire: he is stunned, down, or locked into a special. 
local SLASH_BLOCKED_ACTIONS = {
	["down"] = true,
	["recover"] = true,
	["hitstun"] = true,
	["fear"] = true,
	["dive"] = true,
	["cast"] = true,
	["lunge"] = true,
	["leap"] = true,
	["ride"] = true,
}
--[[
	*
	 * Counts the slash buff down and runs a swing every SLASH_INTERVAL ticks from SLASH_FIRST_DELAY after the cast. A swing that
	 * falls while he cannot act (see SLASH_BLOCKED_ACTIONS) is lost; the timer keeps running. He may swing during a punch, tackle,
	 * charge or kick. The buff ends when its timer runs out.
	 
]]
local swingSlash
function tickSlash(state, p)
	if p.slashTicks == 0 then
		return nil
	end
	p.slashTicks -= 1
	local elapsed = K.SLASH_TICKS - p.slashTicks
	local due = elapsed >= K.SLASH_FIRST_DELAY and (elapsed - K.SLASH_FIRST_DELAY) % K.SLASH_INTERVAL == 0
	local _condition = due
	if _condition then
		local _action = p.action
		_condition = not (SLASH_BLOCKED_ACTIONS[_action] ~= nil)
	end
	if _condition then
		swingSlash(state, p)
	end
	if p.slashTicks == 0 then
		local _events = state.events
		local _arg0 = {
			type = "slashEnd",
			playerIdx = p.idx,
		}
		table.insert(_events, _arg0)
	end
end
--[[
	*
	 * One swing: emits slashSwing along the wave direction, a melee punch hit on every opponent in front of him, then one blade
	 * wave. He keeps moving and any ball he holds.
	 
]]
local slashAim, meleeSlash, fireBladeWave
function swingSlash(state, p)
	local aim = slashAim(state, p)
	local _events = state.events
	local _arg0 = {
		type = "slashSwing",
		playerIdx = p.idx,
		dirX = aim.dirX,
		dirY = aim.dirY,
	}
	table.insert(_events, _arg0)
	meleeSlash(state, p, aim.side)
	fireBladeWave(state, p, aim.dirX, aim.dirY)
end
--[[
	*
	 * The swing's melee: every opponent that is standing and not invincible, within SLASH_MELEE_REACH px of his front edge on the
	 * side (+1 or -1) he faces and within SLASH_MELEE_HALF_DEPTH px vertically, takes a normal punch hit.
	 
]]
function meleeSlash(state, p, side)
	local _exp = state.players
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(v)
		if v.team == p.team or v.action == "down" or v.action == "recover" or isInvincible(v) then
			return false
		end
		local ahead = (v.x - p.x) * side
		if ahead <= 0 or math.abs(v.y - p.y) > K.SLASH_MELEE_HALF_DEPTH then
			return false
		end
		return ahead - p.radius - v.radius <= K.SLASH_MELEE_REACH
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	local victims = _newValue
	for _, v in victims do
