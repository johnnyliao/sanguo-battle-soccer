--[[
	*
	 * Xiao Qiao's 吹飛 (櫻花龍捲): an instant cast, with or without the ball. The gust point is fixed at the cast: the nearest
	 * standing opponent on her facing side within GUST_TARGET_RANGE (his position now, not following him). With none in reach it
	 * is GUST_FALLBACK_DIST straight ahead, clamped to the field. She keeps acting normally.
	 
]]
function startGust(state, p)
	p.stamina -= K.SPECIAL_STAMINA_COST
	p.specialCooldown = K.SPECIAL_COOLDOWN_TICKS
	local attack = attackDir(state, p.team)
	local side = if p.facingX ~= 0 then math.sign(p.facingX) else attack
	local target = nil
	local bestDist = math.huge
	for _, v in state.players do
		if v.team == p.team or v.action == "down" or v.action == "recover" then
			continue
		end
		if (v.x - p.x) * side <= 0 then
			continue
		end
		local d = distance(p.x, p.y, v.x, v.y)
		if d <= K.GUST_TARGET_RANGE and d < bestDist then
			target = v
			bestDist = d
		end
	end
	local x
	local y
	if target ~= nil then
		x = target.x
		y = target.y
	else
		local len = math.sqrt(p.facingX * p.facingX + p.facingY * p.facingY)
		local ux = if len == 0 then attack else p.facingX / len
		local uy = if len == 0 then 0 else p.facingY / len
		x = math.min(K.FIELD_W, math.max(0, p.x + ux * K.GUST_FALLBACK_DIST))
		y = math.min(K.FIELD_D, math.max(0, p.y + uy * K.GUST_FALLBACK_DIST))
	end
	local _original = state.nextGustId
	state.nextGustId += 1
	local gustId = _original
	local _gusts = state.gusts
	local _arg0 = {
		id = gustId,
		ownerIdx = p.idx,
		team = p.team,
		x = x,
		y = y,
		ticks = 0,
	}
	table.insert(_gusts, _arg0)
	local _events = state.events
	local _arg0_1 = {
		type = "special",
		playerIdx = p.idx,
		kind = p.specialKind,
		name = p.specialName,
	}
	table.insert(_events, _arg0_1)
	local _events_1 = state.events
	local _arg0_2 = {
		type = "gustMark",
		playerIdx = p.idx,
		gustId = gustId,
		x = x,
		y = y,
		radius = K.GUST_RADIUS,
	}
	table.insert(_events_1, _arg0_2)
end
--[[
	*
