          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local exports = {}
-- Computer players: produce the same virtual button frames a human would.
for _k, _v in TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai", "ai") or {} do
	exports[_k] = _v
end
for _k, _v in TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai", "pkAi") or {} do
	exports[_k] = _v
end
return exports
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">ai</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _sim = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim")
local EASTWIND_RADIUS = _sim.EASTWIND_RADIUS
local EMPTY_INPUT = _sim.EMPTY_INPUT
local FEAR_RADIUS = _sim.FEAR_RADIUS
local FIELD_D = _sim.FIELD_D
local FIELD_W = _sim.FIELD_W
local GK_AREA_DEPTH = _sim.GK_AREA_DEPTH
local GOAL_HALF_W = _sim.GOAL_HALF_W
local GUST_RADIUS = _sim.GUST_RADIUS
local GUST_TARGET_RANGE = _sim.GUST_TARGET_RANGE
local LEAP_BACK_DISTANCE = _sim.LEAP_BACK_DISTANCE
local LEAP_FLY_DISTANCE = _sim.LEAP_FLY_DISTANCE
local LEAP_RADIUS = _sim.LEAP_RADIUS
local PORTAL_RADIUS = _sim.PORTAL_RADIUS
local RIDE_DISTANCE = _sim.RIDE_DISTANCE
local RIDE_LANE_HALF = _sim.RIDE_LANE_HALF
local ROAR_FORWARD = _sim.ROAR_FORWARD
local ROAR_RADIUS = _sim.ROAR_RADIUS
local SPECIAL_STAMINA_COST = _sim.SPECIAL_STAMINA_COST
local attackDir = _sim.attackDir
local goalMouth = _sim.goalMouth
local opponentGoalX = _sim.opponentGoalX
local ownGoalX = _sim.ownGoalX
local _pkAi = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai", "pkAi")
local computePkAIInputs = _pkAi.computePkAIInputs
local createPkAIState = _pkAi.createPkAIState
local nextRandom = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai", "random").nextRandom
--[[
	*
	 * Computer players. Each AI-controlled player gets one InputFrame per tick, built only from the
	 * public game state and its own AIState. Nothing here touches the sim's rng.
	 
]]
local PLAYER_COUNT = 10
local CENTER_Y = FIELD_D / 2
local EDGE_MARGIN = 20
local ATTACK_COOLDOWN = 40
local PUNCH_TRIGGER = 22
local TACKLE_TRIGGER = 45
local TACKLE_CHANCE = 0.05
local OPPORTUNIST_RANGE = 18
local OPPORTUNIST_CHANCE = 0.01
local SHOT_RANGE_FWD = 330
local SHOT_RANGE_DF = 250
--* Per-tick chance to use the special while eligible (the button fires instantly, so keep it rare). 
local SHOT_FULL_CHANCE = 0.02
local SPECIAL_RANGE = 480
local SHOT_MIN_STAMINA = 25
--* A special (rampage) is started from this far out, whatever the role. 
local CHARGE_SHOT_RANGE = 560
--* A rampaging owner fires its special once this close to the goal (lob kinds from further out). 
local RAMPAGE_FIRE_RANGE = 260
local RAMPAGE_FIRE_RANGE_LOB = 380
--* A rampaging owner fires when this few rampage ticks are left. 
local RAMPAGE_FIRE_LEFT = 15
--* Ma Chao's summon is called when at least SUMMON_AI_MIN_OPPONENTS standing opponents are within this range. 
local SUMMON_AI_RANGE = 200
local SUMMON_AI_MIN_OPPONENTS = 2
--* Fear (Zhang Liao): cast when an enemy carrier is within FEAR_RADIUS, or at least FEAR_MIN_OPPONENTS standing opponents are. 
local FEAR_MIN_OPPONENTS = 2
--* Portal (Da Qiao): cast when an enemy carrier is within PORTAL_RADIUS, or at least PORTAL_MIN_OPPONENTS standing opponents are. 
local PORTAL_MIN_OPPONENTS = 2
--* East wind (Zhou Yu): cast when an enemy carrier is within EASTWIND_RADIUS, or at least EASTWIND_MIN_OPPONENTS standing opponents are. 
local EASTWIND_MIN_OPPONENTS = 2
--* Ride (Guan Yu), off the ball: the lane starts this far ahead of him; two standing opponents in it, or an opponent carrier, cast it. 
local RIDE_LANE_MIN_AHEAD = 30
local RIDE_LANE_MIN_OPPONENTS = 2
--* Ride, owner: an opponent this close makes the ride an escape. 
local RIDE_OWNER_ESCAPE_RANGE = 90
--* Lunge (Zhao Yun), off the ball: cast when an opponent carrier is this far away, roughly in front of the lunger. 
local LUNGE_BALL_MIN = 60
local LUNGE_BALL_MAX = 190
local LUNGE_BALL_LATERAL = 50
--* Leap (Sima Yi): net distance the leap carries him along his facing (back-hop then flight). 
local LEAP_LAND = LEAP_FLY_DISTANCE - LEAP_BACK_DISTANCE
--* Leap, off the ball: the carrier must be this far ahead of him along his facing, and near the landing spot. 
local LEAP_BALL_MIN_AHEAD = 260
local LEAP_BALL_MAX_AHEAD = 380
local LEAP_TARGET_MIN_OPPONENTS = 2
--* Leap, owner: an opponent this close makes the leap an escape and advance. 
local LEAP_OWNER_ESCAPE_RANGE = 100
--* Tiger guard (Xu Chu), off the ball: per-tick chance once a threat holds (the window is short, so higher than the others). 
local TIGER_AI_CHANCE = 0.1
--* Tiger, off the ball: an opponent carrier this close (in x) to his own goal line. 
local TIGER_CARRIER_RANGE = 260
--* Tiger, off the ball: a moving loose ball last touched by an opponent, heading at his goal, this close (in x) to the goal line. 
local TIGER_SHOT_RANGE = 350
--* Arrowship (Sun Quan), off the ball: per-tick chance once a threat holds (the block window is short, like the tiger's). 
local ARROWSHIP_AI_CHANCE = 0.1
--* Arrowship, off the ball: a loose ball last touched by an opponent, heading at his goal this fast (|vx|) and this close (in x) to the goal line. 
local ARROWSHIP_SHOT_MIN_VX = 200
local ARROWSHIP_SHOT_RANGE = 250
--* Arrowship, off the ball: an opponent carrier this close to his own goal centre. 
local ARROWSHIP_CARRIER_RANGE = 200
--* Slash (Cao Cao), cast: an opponent this close, or an opponent carrier within SLASH_CARRIER_RANGE. 
local SLASH_CAST_RANGE = 140
local SLASH_CARRIER_RANGE = 200
--* Slash, buff: the enemy carrier within this range is chased in preference to the nearest opponent. 
local SLASH_CHASE_CARRIER_RANGE = 260
--* Slash, buff: holds this far from the chased opponent once facing him (inside the 120 px wave range). 
local SLASH_STANDOFF = 80
--* Ice field (Zhen Ji), off the ball: cast when an enemy carrier is this close, or ICE_OFF_BALL_MIN_OPPONENTS standing opponents are within ICE_OFF_BALL_RANGE. 
local ICE_CARRIER_RANGE = 90
local ICE_OFF_BALL_RANGE = 100
local ICE_OFF_BALL_MIN_OPPONENTS = 2
--* Ice field, owner: cast when an opponent is within ICE_OWNER_NEAR_RANGE (a chaser), or ICE_OWNER_MIN_OPPONENTS are within ICE_OWNER_RANGE. 
local ICE_OWNER_NEAR_RANGE = 70
local ICE_OWNER_RANGE = 110
local ICE_OWNER_MIN_OPPONENTS = 2
--* Sail (Sun Ce), owner: cast when an opponent is this close (break through), or when facing the goal with no standing opponent SAIL_OPEN_RANGE ahead and the goal within SAIL_OPEN_MAX_GOAL_DIST. 
local SAIL_ESCAPE_RANGE = 90
local SAIL_OPEN_RANGE = 120
local SAIL_OPEN_MAX_GOAL_DIST = 600
--* Sail, off the ball: cast when an enemy carrier is this close, so the boat sails into him and frees the ball. 
local SAIL_CARRIER_RANGE = 220
local PRESSURE_RANGE = 40
local PRESSURE_PASS_CHANCE = 0.04
local FORWARD_PASS_MIN_AHEAD = 80
local FORWARD_PASS_CHANCE = 0.01
local RECEIVER_FREE_RANGE = 50
local DRIBBLE_DASH_RANGE = 80
local DRIBBLE_DASH_LATERAL = 30
local GK_HOLD_MIN = 30
local GK_HOLD_SPAN = 31
local GK_FORWARD_STEP = 100
local GK_LINE_OFFSET = 18
local GK_MOUTH_MARGIN = 6
local DIVE_MIN_SPEED = 250
local DIVE_MAX_DIST_X = 120
local DIVE_MIN_DY = 14
local FW_AHEAD = 150
local MF_AHEAD = 60
local MF_BEHIND = 40
local MF_LANE = 70
local DF_BEHIND = 180
local DEFEND_LANE = 50
local DEFEND_FRAC = {
	DF = 0.35,
	MF = 0.6,
	FW = 0.75,
}
local DASH_STAMINA_FRAC = 0.4
local DRIBBLE_DASH_STAMINA_FRAC = 0.5
local STOP_DIST = 6
local NO_MOVE = {
	moveX = 0,
	moveY = 0,
}
local function createAIState(seed)
	local perPlayer = {}
	for i = 0, PLAYER_COUNT - 1 do
		table.insert(perPlayer, {
			holdTicks = 0,
			cooldown = 0,
			intent = "support",
		})
	end
	return {
		rng = bit32.rshift(seed, 0),
		perPlayer = perPlayer,
		pk = createPkAIState(),
	}
end
--* One InputFrame per player. Human-controlled slots get EMPTY_INPUT; the caller overwrites them. 
local decide
local function computeAIInputs(state, ai, humanMask)
	if state.match.phase == "pk" then
		return computePkAIInputs(state, ai, humanMask)
	end
	local _exp = state.players
	-- ▼ ReadonlyArray.map ▼
	local _newValue = table.create(#_exp)
	local _callback = function(p)
		local _result
		if humanMask[p.idx + 1] then
			local _object = table.clone(EMPTY_INPUT)
			setmetatable(_object, nil)
			_result = _object
		else
			_result = decide(state, ai, p)
		end
		return _result
	end
	for _k, _v in _exp do
		_newValue[_k] = _callback(_v, _k - 1, _exp)
	end
	-- ▲ ReadonlyArray.map ▲
	return _newValue
end
local frame, steerTo, activeFrame
function decide(state, ai, p)
	if state.match.phase ~= "play" then
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		return _object
	end
	local s = ai.perPlayer[p.idx + 1]
	if s.cooldown > 0 then
		s.cooldown -= 1
	end
	if s.holdTicks > 0 then
		s.holdTicks -= 1
	end
	-- Silenced (Sima Yi's leap): no attack, shot, pass, call or special. A silenced holder dribbles at the opponent goal;
	-- anyone else moves as usual with J, K and L held off.
	if p.silenceTicks > 0 and p.action == "normal" and state.ball.ownerIdx == p.idx then
		s.intent = "silencedDribble"
		return frame(steerTo(p, opponentGoalX(state, p.team), CENTER_Y))
	end
	local f = activeFrame(state, ai, p, s)
	local _result
	if p.silenceTicks > 0 then
		local _object = table.clone(f)
		setmetatable(_object, nil)
		_object.j = false
		_object.k = false
		_object.l = false
		_result = _object
	else
		_result = f
	end
	return _result
end
local roarFrame, sailFrame, rampageFrame, gkOwnerFrame, ownerFrame, slashChaseFrame, offBallSpecialFrame, freeFrame
function activeFrame(state, ai, p, s)
	-- A passenger on Sun Ce's sail: the sim ignores his input.
	if p.sailPassengerOf ~= -1 then
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		return _object
	end
	local roar = roarFrame(state, p, s)
	if roar ~= nil then
		return roar
	end
	if p.action ~= "normal" then
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		return _object
	end
	if p.sailTicks > 0 then
		return sailFrame(state, p, s)
	end
	if state.ball.ownerIdx == p.idx then
		if p.rampageTicks > 0 then
			return rampageFrame(state, p, s)
		end
		return if p.role == "GK" then gkOwnerFrame(state, ai, p, s) else ownerFrame(state, ai, p, s)
	end
	if p.specialMode == "slash" and p.slashTicks > 0 then
		local chase = slashChaseFrame(state, ai, p, s)
		if chase ~= nil then
			return chase
		end
	end
	local special = offBallSpecialFrame(state, ai, p, s)
	if special ~= nil then
		return special
	end
	return freeFrame(state, ai, p, s)
end
--[[
	*
	 * Zhang Fei's roar (the one special that is not a rampage). While the roar is worth it, L is pressed; the roar fires at
	 * once, with or without the ball. As goalkeeper, an incoming shot in the roar's reach is roared at with certainty, on
	 * the normal goalkeeper frame.
	 
]]
local roarShotIncoming, gkFreeFrame, roarWanted
function roarFrame(state, p, s)
	if p.specialMode ~= "roar" then
		return nil
	end
	if p.action ~= "normal" then
		return nil
	end
	if roarShotIncoming(state, p) then
		local normal = gkFreeFrame(state, p, s)
		s.intent = "roarShot"
		local _object = table.clone(normal)
		setmetatable(_object, nil)
		_object.l = not p.prevInput.l
		return _object
	end
	if not roarWanted(state, p) then
		return nil
	end
	s.intent = "roar"
	return frame(NO_MOVE, {
		l = not p.prevInput.l,
	})
end
--[[
	*
	 * Zhang Fei as goalkeeper can roar at an incoming shot: off cooldown, enough stamina, not silenced and L not held. The
	 * loose ball must have been last touched by an opponent, move toward his goal, cross that goal line inside the mouth
	 * along its straight xy path, and already be inside the roar circle. A roar fires on the tick it is pressed, before the
	 * ball moves, so a ball still outside the circle would not be knocked.
	 
]]
local crossesGoalMouth, dist
function roarShotIncoming(state, p)
	if p.role ~= "GK" or p.specialCooldown > 0 or p.stamina < SPECIAL_STAMINA_COST then
		return false
	end
	if p.silenceTicks > 0 or p.prevInput.l then
		return false
	end
	local ball = state.ball
	if ball.ownerIdx ~= -1 or ball.lastTouchIdx == -1 or state.players[ball.lastTouchIdx + 1].team == p.team then
		return false
	end
	local goalX = ownGoalX(state, p.team)
	local towardGoal = if goalX == 0 then ball.vx < 0 else ball.vx > 0
	if not towardGoal or not crossesGoalMouth(ball, goalX) then
		return false
	end
	local cx = p.x + p.facingX * ROAR_FORWARD
	local cy = p.y + p.facingY * ROAR_FORWARD
	return dist(ball.x, ball.y, cx, cy) <= ROAR_RADIUS
end
--* True if the ball's straight xy path crosses the goal line at goalX inside the goal mouth. Mirrors crossesOwnMouth in sim/step.ts. 
function crossesGoalMouth(ball, goalX)
	if ball.vx == 0 then
		return false
	end
	local mouth = goalMouth(if goalX == 0 then 0 else 1)
	local t = (mouth.x - ball.x) / ball.vx
	if t <= 0 then
		return false
	end
	local y = ball.y + ball.vy * t
	return y >= mouth.yMin and y <= mouth.yMax
end
--[[
	*
	 * Roar is worth using: off cooldown, enough stamina, and either two standing opponents in the roar circle or an
	 * opponent carrier in the circle inside the roarer's own area.
	 
]]
function roarWanted(state, p)
	if p.specialCooldown > 0 or p.stamina < SPECIAL_STAMINA_COST then
		return false
	end
	local cx = p.x + p.facingX * ROAR_FORWARD
	local cy = p.y + p.facingY * ROAR_FORWARD
	local ownGoal = ownGoalX(state, p.team)
	local inCircle = 0
	local carrierInCircle = false
	for _, t in state.players do
		if t.team == p.team or t.action == "down" or t.rampageTicks > 0 then
			continue
		end
		if dist(t.x, t.y, cx, cy) > ROAR_RADIUS then
			continue
		end
		inCircle += 1
		if t.idx == state.ball.ownerIdx then
			carrierInCircle = true
		end
	end
	local ballNearOwnGoal = math.abs(state.ball.x - ownGoal) < GK_AREA_DEPTH + 60
	return inCircle >= 2 or carrierInCircle or (inCircle >= 1 and ballNearOwnGoal)
end
local hasCaller, passFrame, opponentsWithin, slashWanted, leapOwnerWanted, leapLanding, rideOwnerWanted, sailOwnerWanted, gustWanted, portalWanted, eastwindWanted, opponentAhead, pickReceiver
function ownerFrame(state, ai, p, s)
	local team = p.team
	local dir = attackDir(state, team)
	local goalX = opponentGoalX(state, team)
	if hasCaller(state, p) then
		return passFrame(p, nil)
	end
	-- Zhuge Liang's beam: channelled on the same per-tick chance as the other specials.
	if p.specialMode == "beam" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "beam"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Ma Chao's summon: called on the same per-tick chance when opponents are close enough to be charged.
	if p.specialMode == "summon" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and opponentsWithin(state, p, SUMMON_AI_RANGE) >= SUMMON_AI_MIN_OPPONENTS and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "summon"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Cao Cao's slash: the blade buff needs no ball, so cast it when an opponent is close.
	if p.specialMode == "slash" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and slashWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "slash"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Zhang Liao's fear: freezes the opponents around him and makes this carrier drop the ball, so cast it when they are close.
	if p.specialMode == "fear" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and opponentsWithin(state, p, FEAR_RADIUS) >= FEAR_MIN_OPPONENTS and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "fear"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Sima Yi's leap while carrying: the ball travels with him, so cast it when it takes him toward goal out of trouble.
	if p.specialMode == "leap" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and leapOwnerWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "leap"
		local land = leapLanding(p)
		return frame(steerTo(p, land.x, land.y), {
			l = true,
		})
	end
	-- Guan Yu's ride while carrying: the ball stays at his feet, so cast it to escape a close opponent or drive it in.
	if p.specialMode == "ride" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and rideOwnerWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "ride"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Zhen Ji's icefield: slows the opponents around her and keeps them in the field, so cast it when they are close.
	if p.specialMode == "icefield" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and (opponentsWithin(state, p, ICE_OWNER_NEAR_RANGE) >= 1 or opponentsWithin(state, p, ICE_OWNER_RANGE) >= ICE_OWNER_MIN_OPPONENTS) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "icefield"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Sun Ce's sail while carrying: the boat takes the ball along, so cast it to break through or run at goal down an open lane.
	if p.specialMode == "sail" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and sailOwnerWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "sail"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Xiao Qiao's gust while carrying: the gust point stays put, so cast it on the opponent in front when a pair stands there.
	if p.specialMode == "gust" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and gustWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "gust"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Da Qiao's portal while carrying: the field stays where she cast it, so cast it when an enemy carrier or a pair of opponents is inside.
	if p.specialMode == "portal" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and portalWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "portal"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	-- Zhou Yu's east wind while carrying: the blast is instant, so cast it when a pair of opponents is pressing him.
	if p.specialMode == "eastwind" and not p.prevInput.l and p.specialCooldown == 0 and p.stamina >= SHOT_MIN_STAMINA and eastwindWanted(state, p) and nextRandom(ai) < SHOT_FULL_CHANCE then
		s.intent = "eastwind"
		return frame(NO_MOVE, {
			l = true,
		})
	end
	local goalDist = math.abs(goalX - p.x)
	local shotRange = if p.role == "DF" then SHOT_RANGE_DF else SHOT_RANGE_FWD
	local inShotRange = goalDist < shotRange
	local inChargeRange = goalDist < CHARGE_SHOT_RANGE
	if inChargeRange and p.facingX * dir > 0 then
		local special = (p.specialMode == "rampage" or p.specialMode == "lunge") and not p.prevInput.l and p.stamina >= SHOT_MIN_STAMINA and p.specialCooldown == 0 and goalDist < SPECIAL_RANGE and nextRandom(ai) < SHOT_FULL_CHANCE
		if special then
			s.intent = "special"
			return frame(steerTo(p, goalX, CENTER_Y), {
				l = true,
			})
		end
		if inShotRange and not p.prevInput.j then
			s.intent = "tap"
			return frame(steerTo(p, goalX, CENTER_Y), {
				j = true,
			})
		end
	end
	if opponentAhead(state, p, PRESSURE_RANGE, math.huge) and nextRandom(ai) < PRESSURE_PASS_CHANCE then
		s.intent = "pass"
		return passFrame(p, pickReceiver(state, p, -math.huge))
	end
	local forward = pickReceiver(state, p, FORWARD_PASS_MIN_AHEAD)
	if forward ~= nil and nextRandom(ai) < FORWARD_PASS_CHANCE then
		s.intent = "pass"
		return passFrame(p, forward)
	end
	s.intent = "dribble"
	local ty = CENTER_Y + (p.y - CENTER_Y) * 0.6
	local dash = p.stamina > DRIBBLE_DASH_STAMINA_FRAC * p.maxStamina and not opponentAhead(state, p, DRIBBLE_DASH_RANGE, DRIBBLE_DASH_LATERAL)
	return frame(steerTo(p, goalX, ty), {
		dash = dash,
	})
end
--[[
	*
	 * Special cast without the ball (only for specialNoBall players), on the per-tick chance once the situation for its
	 * kind holds. Returns null when no special is cast this tick.
	 
]]
local tigerThreat, arrowshipWanted, rideLaneOpponents, sign, opponentsNear
function offBallSpecialFrame(state, ai, p, s)
	if not p.specialNoBall or p.prevInput.l or p.specialCooldown > 0 or p.stamina < SHOT_MIN_STAMINA then
		return nil
	end
	-- Xu Chu's tiger guard: the goalkeeper's normal frame (freeFrame) with L added on top, so his movement is unchanged.
	if p.specialMode == "tiger" then
		if not tigerThreat(state, p) or nextRandom(ai) >= TIGER_AI_CHANCE then
			return nil
		end
		local normal = freeFrame(state, ai, p, s)
		s.intent = "tiger"
		local _object = table.clone(normal)
		setmetatable(_object, nil)
		_object.l = true
		return _object
	end
	-- Sun Quan's arrowship: the same shape as the tiger guard, on the goalkeeper's normal frame with L added on top.
	if p.specialMode == "arrowship" then
		if not arrowshipWanted(state, p) or nextRandom(ai) >= ARROWSHIP_AI_CHANCE then
			return nil
		end
		local normal = freeFrame(state, ai, p, s)
		s.intent = "arrowship"
		local _object = table.clone(normal)
		setmetatable(_object, nil)
		_object.l = true
		return _object
	end
	local carrier = if state.ball.ownerIdx == -1 then nil else state.players[state.ball.ownerIdx + 1]
	local enemyCarrier = if carrier ~= nil and carrier.team ~= p.team then carrier else nil
	local wanted = false
	local steer = NO_MOVE
	local _exp = p.specialMode
	repeat
		if _exp == "ride" then
			local inLane = rideLaneOpponents(state, p)
			-- ▼ ReadonlyArray.find ▼
			local _callback = function(t)
				return t.idx == state.ball.ownerIdx
			end
			local _result
			for _i, _v in inLane do
				if _callback(_v, _i - 1, inLane) == true then
					_result = _v
					break
				end
			end
			-- ▲ ReadonlyArray.find ▲
			local _condition = _result
			if _condition == nil then
				_condition = nil
			end
			local laneCarrier = _condition
			wanted = laneCarrier ~= nil or #inLane >= RIDE_LANE_MIN_OPPONENTS
			-- Facing already points down the lane, so only a carrier needs steering to keep him in the bike's path.
			steer = if laneCarrier ~= nil then steerTo(p, laneCarrier.x, laneCarrier.y) else NO_MOVE
			break
		end
		if _exp == "fear" then
			wanted = (enemyCarrier ~= nil and dist(p.x, p.y, enemyCarrier.x, enemyCarrier.y) <= FEAR_RADIUS) or opponentsWithin(state, p, FEAR_RADIUS) >= FEAR_MIN_OPPONENTS
			break
		end
		if _exp == "beam" then
			wanted = enemyCarrier ~= nil and math.abs(enemyCarrier.x - ownGoalX(state, p.team)) < FIELD_W / 2
			break
		end
		if _exp == "lunge" then
			if enemyCarrier ~= nil then
				local dx = enemyCarrier.x - p.x
				local dy = enemyCarrier.y - p.y
				local d = dist(p.x, p.y, enemyCarrier.x, enemyCarrier.y)
				wanted = d >= LUNGE_BALL_MIN and d <= LUNGE_BALL_MAX and math.abs(dy) < LUNGE_BALL_LATERAL and sign(p.facingX) == sign(dx)
				steer = steerTo(p, enemyCarrier.x, enemyCarrier.y)
			end
			break
		end
		if _exp == "leap" then
			if enemyCarrier ~= nil then
				local land = leapLanding(p)
				local ahead = (enemyCarrier.x - p.x) * p.facingX + (enemyCarrier.y - p.y) * p.facingY
				wanted = ahead >= LEAP_BALL_MIN_AHEAD and ahead <= LEAP_BALL_MAX_AHEAD and (dist(enemyCarrier.x, enemyCarrier.y, land.x, land.y) < LEAP_RADIUS or opponentsNear(state, p.team, land.x, land.y, LEAP_RADIUS) >= LEAP_TARGET_MIN_OPPONENTS)
				steer = steerTo(p, land.x, land.y)
			end
			break
		end
		if _exp == "summon" then
			wanted = opponentsWithin(state, p, SUMMON_AI_RANGE) >= SUMMON_AI_MIN_OPPONENTS
			break
		end
		if _exp == "slash" then
			wanted = slashWanted(state, p)
			break
		end
		if _exp == "icefield" then
			wanted = (enemyCarrier ~= nil and dist(p.x, p.y, enemyCarrier.x, enemyCarrier.y) <= ICE_CARRIER_RANGE) or opponentsWithin(state, p, ICE_OFF_BALL_RANGE) >= ICE_OFF_BALL_MIN_OPPONENTS
			break
		end
		if _exp == "sail" then
			if enemyCarrier ~= nil then
				wanted = dist(p.x, p.y, enemyCarrier.x, enemyCarrier.y) <= SAIL_CARRIER_RANGE
				steer = steerTo(p, enemyCarrier.x, enemyCarrier.y)
			end
			break
		end
		if _exp == "gust" then
			wanted = gustWanted(state, p)
			break
		end
		if _exp == "portal" then
			wanted = portalWanted(state, p)
			break
		end
		if _exp == "eastwind" then
			wanted = eastwindWanted(state, p)
			break
		end
		return nil
	until true
	if not wanted or nextRandom(ai) >= SHOT_FULL_CHANCE then
		return nil
	end
	s.intent = "offBall"
	return frame(steer, {
		l = true,
	})
end
--[[
	*
	 * Xu Chu's tiger guard is worth casting: no guard running yet, and either an opponent carries the ball within
	 * TIGER_CARRIER_RANGE of his goal line, or a moving loose ball last touched by an opponent heads at his goal from
	 * within TIGER_SHOT_RANGE.
	 
]]
function tigerThreat(state, p)
	if p.tigerTicks > 0 then
		return false
	end
	local goalX = ownGoalX(state, p.team)
	local ball = state.ball
	if ball.ownerIdx ~= -1 then
		local carrier = state.players[ball.ownerIdx + 1]
		return carrier.team ~= p.team and math.abs(carrier.x - goalX) < TIGER_CARRIER_RANGE
	end
	if ball.lastTouchIdx == -1 or state.players[ball.lastTouchIdx + 1].team == p.team then
		return false
	end
	local towardGoal = if goalX == 0 then ball.vx < 0 else ball.vx > 0
	return towardGoal and math.abs(ball.x - goalX) < TIGER_SHOT_RANGE
end
--[[
	*
	 * Sun Quan's arrowship is worth casting: no ship up yet, and either a loose ball last touched by an opponent heads at his
	 * goal at ARROWSHIP_SHOT_MIN_VX or faster from within ARROWSHIP_SHOT_RANGE of the goal line, or an opponent carrier
	 * stands within ARROWSHIP_CARRIER_RANGE of his own goal centre.
	 
]]
function arrowshipWanted(state, p)
	if p.arrowshipUp then
		return false
	end
	local goalX = ownGoalX(state, p.team)
	local ball = state.ball
	if ball.ownerIdx ~= -1 then
		local carrier = state.players[ball.ownerIdx + 1]
		return carrier.team ~= p.team and dist(carrier.x, carrier.y, goalX, CENTER_Y) <= ARROWSHIP_CARRIER_RANGE
	end
	if ball.lastTouchIdx == -1 or state.players[ball.lastTouchIdx + 1].team == p.team then
		return false
	end
	local towardGoal = if goalX == 0 then ball.vx < 0 else ball.vx > 0
	return towardGoal and math.abs(ball.vx) >= ARROWSHIP_SHOT_MIN_VX and math.abs(ball.x - goalX) <= ARROWSHIP_SHOT_RANGE
end
--* Where a leap from p lands if cast now: LEAP_LAND along his facing (the sim normalises facing on the cast). 
function leapLanding(p)
	return {
		x = p.x + p.facingX * LEAP_LAND,
		y = p.y + p.facingY * LEAP_LAND,
	}
end
--[[
	*
	 * Owner leap: he faces the opponent goal, the landing spot is on the field, and either an opponent is within
	 * LEAP_OWNER_ESCAPE_RANGE of him (escape and advance) or LEAP_TARGET_MIN_OPPONENTS sit within LEAP_RADIUS of the landing.
	 
]]
function leapOwnerWanted(state, p)
	if p.facingX * attackDir(state, p.team) <= 0 then
		return false
	end
	local land = leapLanding(p)
	if land.x < 0 or land.x > FIELD_W or land.y < 0 or land.y > FIELD_D then
		return false
	end
	return opponentsWithin(state, p, LEAP_OWNER_ESCAPE_RANGE) >= 1 or opponentsNear(state, p.team, land.x, land.y, LEAP_RADIUS) >= LEAP_TARGET_MIN_OPPONENTS
end
--[[
	*
	 * Owner ride: he faces the opponent goal, and either an opponent is within RIDE_OWNER_ESCAPE_RANGE of him (escape) or
	 * the goal line is within RIDE_DISTANCE with his y inside the goal mouth (drive it in).
	 
]]
function rideOwnerWanted(state, p)
	if p.facingX * attackDir(state, p.team) <= 0 then
		return false
	end
	if opponentsWithin(state, p, RIDE_OWNER_ESCAPE_RANGE) >= 1 then
		return true
	end
	local goalX = opponentGoalX(state, p.team)
	return math.abs(goalX - p.x) < RIDE_DISTANCE and math.abs(p.y - CENTER_Y) < GOAL_HALF_W
end
--[[
	*
	 * Standing opponents whose centre lies in Guan Yu's ride lane: from RIDE_LANE_MIN_AHEAD to RIDE_DISTANCE ahead along his
	 * facing, and within RIDE_LANE_HALF of the line.
	 
]]
function rideLaneOpponents(state, p)
	local _exp = state.players
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(t)
		if t.team == p.team or t.action == "down" then
			return false
		end
		local dx = t.x - p.x
		local dy = t.y - p.y
		local along = dx * p.facingX + dy * p.facingY
		if along < RIDE_LANE_MIN_AHEAD or along > RIDE_DISTANCE then
			return false
		end
		return math.abs(dx * p.facingY - dy * p.facingX) <= RIDE_LANE_HALF
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	return _newValue
end
--[[
	*
	 * Sun Ce's sail, owner: an opponent stands within SAIL_ESCAPE_RANGE (break through), or he faces the opponent goal, the
	 * goal is within SAIL_OPEN_MAX_GOAL_DIST, and no standing opponent is SAIL_OPEN_RANGE ahead of him.
	 
]]
function sailOwnerWanted(state, p)
	if opponentsWithin(state, p, SAIL_ESCAPE_RANGE) >= 1 then
		return true
	end
	local goalX = opponentGoalX(state, p.team)
	return p.facingX * attackDir(state, p.team) > 0 and math.abs(goalX - p.x) < SAIL_OPEN_MAX_GOAL_DIST and not opponentAhead(state, p, SAIL_OPEN_RANGE, math.huge)
end
--[[
	*
	 * Sun Ce while the sail runs: no punch, tackle or pass. With the ball he drives at the opponent goal and taps J (a shot)
	 * once in shot range facing it. Without it he steers the boat at the enemy carrier, else the loose ball, else the goal.
	 
]]
function sailFrame(state, p, s)
	local goalX = opponentGoalX(state, p.team)
	if state.ball.ownerIdx == p.idx then
		local goalDist = math.abs(goalX - p.x)
		local shotRange = if p.role == "DF" then SHOT_RANGE_DF else SHOT_RANGE_FWD
		local steer = steerTo(p, goalX, CENTER_Y)
		if goalDist < shotRange and p.facingX * attackDir(state, p.team) > 0 and not p.prevInput.j then
			s.intent = "sailShot"
			return frame(steer, {
				j = true,
			})
		end
		s.intent = "sailDrive"
		return frame(steer)
	end
	local ball = state.ball
	local carrier = if ball.ownerIdx == -1 then nil else state.players[ball.ownerIdx + 1]
	local enemyCarrier = if carrier ~= nil and carrier.team ~= p.team then carrier else nil
	s.intent = "sailSteer"
	if enemyCarrier ~= nil then
		return frame(steerTo(p, enemyCarrier.x, enemyCarrier.y))
	end
	if ball.ownerIdx == -1 then
		return frame(steerTo(p, ball.x, ball.y))
	end
	return frame(steerTo(p, goalX, CENTER_Y))
end
--[[
	*
	 * The gust target as the sim picks it: the nearest standing opponent on p's facing side within GUST_TARGET_RANGE (ties go
	 * to the lowest idx), or null when none is in reach.
	 
]]
local function gustTarget(state, p)
	local side = if p.facingX ~= 0 then sign(p.facingX) else attackDir(state, p.team)
	local best = nil
	local bestDist = math.huge
	for _, t in state.players do
		if t.team == p.team or t.action == "down" or t.action == "recover" then
			continue
		end
		if (t.x - p.x) * side <= 0 then
			continue
		end
		local d = dist(t.x, t.y, p.x, p.y)
		if d <= GUST_TARGET_RANGE and d < bestDist then
			best = t
			bestDist = d
		end
	end
	return best
end
--[[
	*
	 * Xiao Qiao's gust is worth casting at its target: the target is the enemy carrier, or another standing opponent stands
	 * within GUST_RADIUS of him (at least two victims). Off the ball and as the owner alike.
	 
]]
function gustWanted(state, p)
	local target = gustTarget(state, p)
	if target == nil then
		return false
	end
	if target.idx == state.ball.ownerIdx then
		return true
	end
	for _, t in state.players do
		if t == target or t.team == p.team or t.action == "down" or t.action == "recover" then
			continue
		end
		if dist(t.x, t.y, target.x, target.y) <= GUST_RADIUS then
			return true
		end
	end
	return false
end
--[[
	*
	 * Da Qiao's portal is worth casting at her position: an enemy carrier stands within PORTAL_RADIUS of her, or at least
	 * PORTAL_MIN_OPPONENTS standing opponents do. Off the ball and as the owner alike.
	 
]]
function portalWanted(state, p)
	local carrier = if state.ball.ownerIdx == -1 then nil else state.players[state.ball.ownerIdx + 1]
	if carrier ~= nil and carrier.team ~= p.team and dist(p.x, p.y, carrier.x, carrier.y) <= PORTAL_RADIUS then
		return true
	end
	return opponentsWithin(state, p, PORTAL_RADIUS) >= PORTAL_MIN_OPPONENTS
end
--[[
	*
	 * Zhou Yu's east wind is worth casting at his position: an enemy carrier stands within EASTWIND_RADIUS of him, or at
	 * least EASTWIND_MIN_OPPONENTS standing opponents do. Off the ball and as the carrier alike.
	 
]]
function eastwindWanted(state, p)
	local carrier = if state.ball.ownerIdx == -1 then nil else state.players[state.ball.ownerIdx + 1]
	if carrier ~= nil and carrier.team ~= p.team and dist(p.x, p.y, carrier.x, carrier.y) <= EASTWIND_RADIUS then
		return true
	end
	return opponentsWithin(state, p, EASTWIND_RADIUS) >= EASTWIND_MIN_OPPONENTS
end
--[[
	*
	 * Cao Cao's slash is worth casting: no blade buff running, and either an opponent stands within SLASH_CAST_RANGE or an
	 * opponent carrier is within SLASH_CARRIER_RANGE.
	 
]]
function slashWanted(state, p)
	if p.slashTicks > 0 then
		return false
	end
	if opponentsWithin(state, p, SLASH_CAST_RANGE) >= 1 then
		return true
	end
	local carrier = if state.ball.ownerIdx == -1 then nil else state.players[state.ball.ownerIdx + 1]
	return carrier ~= nil and carrier.team ~= p.team and carrier.action ~= "down" and dist(p.x, p.y, carrier.x, carrier.y) < SLASH_CARRIER_RANGE
end
--[[
	*
	 * Cao Cao's slash buff, off the ball: target the enemy carrier if within SLASH_CHASE_CARRIER_RANGE, else the nearest
	 * standing opponent. Closes in, then holds once about SLASH_STANDOFF px away and facing him, so the waves reach him.
	 * A carrier inside a punch or tackle trigger is attacked by chaseFrame. Null when no opponent stands.
	 
]]
local nearestOpponent, chaseFrame, facingDot
function slashChaseFrame(state, ai, p, s)
	local carrier = if state.ball.ownerIdx == -1 then nil else state.players[state.ball.ownerIdx + 1]
	local enemyCarrier = if carrier ~= nil and carrier.team ~= p.team and carrier.action ~= "down" and dist(p.x, p.y, carrier.x, carrier.y) <= SLASH_CHASE_CARRIER_RANGE then carrier else nil
	local target = enemyCarrier or nearestOpponent(state, p.team, p.x, p.y, math.huge)
	if target == nil then
		return nil
	end
	if target == enemyCarrier then
		local chase = chaseFrame(state, ai, p, s, target)
		if chase.j then
			return chase
		end
	end
	s.intent = "slashChase"
	local d = dist(p.x, p.y, target.x, target.y)
	if d <= SLASH_STANDOFF and facingDot(p, target.x, target.y) > 0.5 then
		return frame(NO_MOVE)
	end
	local dashOk = p.stamina > DASH_STAMINA_FRAC * p.maxStamina
	return frame(steerTo(p, target.x, target.y), {
		dash = dashOk and d > 160,
	})
end
--* Rampaging owner: dribble straight at the goal centre, and fire the special once close enough or when the rampage is nearly over. 
function rampageFrame(state, p, s)
	s.intent = "rampage"
	local goalX = opponentGoalX(state, p.team)
	local goalDist = math.abs(goalX - p.x)
	local fireRange = if p.specialKind == "lob" then RAMPAGE_FIRE_RANGE_LOB else RAMPAGE_FIRE_RANGE
	local fire = goalDist < fireRange or p.rampageTicks < RAMPAGE_FIRE_LEFT
	return frame(steerTo(p, goalX, CENTER_Y), {
		j = fire,
	})
end
function gkOwnerFrame(state, ai, p, s)
	if s.intent ~= "gkHold" then
		s.intent = "gkHold"
		s.holdTicks = GK_HOLD_MIN + math.floor(nextRandom(ai) * GK_HOLD_SPAN)
	end
	-- Facing up-field both while holding and on the pass press, so the owned ball never sits behind the goal line.
	local upField = steerTo(p, p.x + attackDir(state, p.team) * GK_FORWARD_STEP, CENTER_Y)
	if s.holdTicks > 0 then
		return frame(upField)
	end
	return frame(upField, {
		k = not p.prevInput.k,
	})
end
--* Ball is loose or the other team has it. 
local supportFrame, chaseRank, defendFrame
function freeFrame(state, ai, p, s)
	local ball = state.ball
	local victim = nearestOpponent(state, p.team, p.x, p.y, OPPORTUNIST_RANGE)
	if victim ~= nil and victim.idx ~= ball.ownerIdx and victim.rampageTicks == 0 and s.cooldown == 0 and not p.prevInput.j and nextRandom(ai) < OPPORTUNIST_CHANCE then
		s.cooldown = ATTACK_COOLDOWN
		s.intent = "attack"
		return frame(steerTo(p, victim.x, victim.y), {
			j = true,
		})
	end
	if p.role == "GK" then
		return gkFreeFrame(state, p, s)
	end
	local owner = if ball.ownerIdx == -1 then nil else state.players[ball.ownerIdx + 1]
	if owner ~= nil and owner.team == p.team then
		return supportFrame(state, p, s)
	end
	local chasers = if owner == nil then 2 else 1
	if chaseRank(state, p) < chasers then
		return chaseFrame(state, ai, p, s, owner)
	end
	return defendFrame(state, p, s)
end
local isClosestToBall, clamp
function gkFreeFrame(state, p, s)
	s.intent = "gk"
	local ball = state.ball
	local goalX = ownGoalX(state, p.team)
	local inward = if goalX == 0 then 1 else -1
	if ball.ownerIdx == -1 then
		local towardGoal = if goalX == 0 then ball.vx < 0 else ball.vx > 0
		local speed = math.sqrt(ball.vx * ball.vx + ball.vy * ball.vy)
		if towardGoal and speed > DIVE_MIN_SPEED and math.abs(ball.x - goalX) < DIVE_MAX_DIST_X then
			local t = (goalX - ball.x) / ball.vx
			local projY = ball.y + ball.vy * t
			if math.abs(projY - p.y) > DIVE_MIN_DY and p.z == 0 and p.vz == 0 and not p.prevInput.j then
				s.intent = "dive"
				return frame(steerTo(p, p.x, projY), {
					j = true,
				})
			end
		end
		if math.abs(ball.x - goalX) < GK_AREA_DEPTH and isClosestToBall(state, p) then
			s.intent = "gkChase"
			return frame(steerTo(p, ball.x, ball.y))
		end
	end
	local ty = clamp(ball.y, CENTER_Y - (GOAL_HALF_W - GK_MOUTH_MARGIN), CENTER_Y + (GOAL_HALF_W - GK_MOUTH_MARGIN))
	return frame(steerTo(p, goalX + inward * GK_LINE_OFFSET, ty))
end
--* Our team has the ball and this player is not the carrier. 
function supportFrame(state, p, s)
	s.intent = "support"
	local ball = state.ball
	local dir = attackDir(state, p.team)
	local tx
	local ty
	if p.role == "FW" then
		tx = ball.x + dir * FW_AHEAD
		ty = clamp(ball.y, CENTER_Y - GOAL_HALF_W, CENTER_Y + GOAL_HALF_W)
	elseif p.role == "MF" then
		if p.idx % 5 == 2 then
			tx = ball.x + dir * MF_AHEAD
			ty = CENTER_Y - MF_LANE
		else
			tx = ball.x - dir * MF_BEHIND
			ty = CENTER_Y + MF_LANE
		end
	else
		tx = ball.x - dir * DF_BEHIND
		ty = CENTER_Y + (ball.y - CENTER_Y) * 0.5
	end
	tx = clamp(tx, EDGE_MARGIN, FIELD_W - EDGE_MARGIN)
	ty = clamp(ty, EDGE_MARGIN, FIELD_D - EDGE_MARGIN)
	local far = dist(p.x, p.y, tx, ty) > 120
	return frame(steerTo(p, tx, ty), {
		dash = far and p.stamina > DASH_STAMINA_FRAC * p.maxStamina,
	})
end
--* Chaser for a loose ball (owner null) or for an opponent carrier (punch / slide tackle when close). 
function chaseFrame(state, ai, p, s, owner)
	s.intent = "chase"
	local dashOk = p.stamina > DASH_STAMINA_FRAC * p.maxStamina
	if owner == nil then
		local ball = state.ball
		local d = dist(p.x, p.y, ball.x, ball.y)
		return frame(steerTo(p, ball.x, ball.y), {
			dash = dashOk and d > 40,
		})
	end
	local move = steerTo(p, owner.x, owner.y)
	local d = dist(p.x, p.y, owner.x, owner.y)
	-- A rampaging carrier is not attacked: the chaser keeps closing in but does not punch or tackle.
	if s.cooldown == 0 and not p.prevInput.j and owner.rampageTicks == 0 then
		if d < PUNCH_TRIGGER and facingDot(p, owner.x, owner.y) > 0.5 then
			s.cooldown = ATTACK_COOLDOWN
			s.intent = "punch"
			return frame(move, {
				j = true,
			})
		end
		if d < TACKLE_TRIGGER and nextRandom(ai) < TACKLE_CHANCE then
			s.cooldown = ATTACK_COOLDOWN
			s.intent = "tackle"
			return frame(move, {
				dash = true,
				j = true,
			})
		end
	end
	return frame(move, {
		dash = dashOk and d > 60,
	})
end
--* Holds a spot between the ball and our own goal, by role. 
function defendFrame(state, p, s)
	s.intent = "defend"
	local ball = state.ball
	local goalX = ownGoalX(state, p.team)
	local frac = if p.role == "DF" then DEFEND_FRAC.DF elseif p.role == "MF" then DEFEND_FRAC.MF else DEFEND_FRAC.FW
	local lane = if p.role == "MF" then (if p.idx % 5 == 2 then -DEFEND_LANE else DEFEND_LANE) else 0
	local tx = clamp(goalX + (ball.x - goalX) * frac, EDGE_MARGIN, FIELD_W - EDGE_MARGIN)
	local ty = clamp(CENTER_Y + (ball.y - CENTER_Y) * 0.6 + lane, EDGE_MARGIN, FIELD_D - EDGE_MARGIN)
	local far = dist(p.x, p.y, tx, ty) > 120
	return frame(steerTo(p, tx, ty), {
		dash = far and p.stamina > DASH_STAMINA_FRAC * p.maxStamina,
	})
end
--* Pass frame: steer toward the receiver (sets facing), then press K. 
function passFrame(p, receiver)
	local move = if receiver == nil then NO_MOVE else steerTo(p, receiver.x, receiver.y)
	return frame(move, {
		k = not p.prevInput.k,
	})
end
function frame(move, extra)
	if extra == nil then
		extra = {}
	end
	local _object = table.clone(EMPTY_INPUT)
	setmetatable(_object, nil)
	_object.moveX = move.moveX
	_object.moveY = move.moveY
	for _k, _v in extra do
		_object[_k] = _v
	end
	return _object
end
--* 8-way direction toward (tx, ty). An axis is held when it carries most of the distance. 
function steerTo(p, tx, ty)
	local dx = tx - p.x
	local dy = ty - p.y
