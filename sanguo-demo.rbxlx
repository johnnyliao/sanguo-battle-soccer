            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local FIELD_D = _constants.FIELD_D
local FIELD_W = _constants.FIELD_W
local KICKOFF_TICKS = _constants.KICKOFF_TICKS
local STAMINA_BASE = _constants.STAMINA_BASE
local STAMINA_PER_STAT = _constants.STAMINA_PER_STAT
local TICK_HZ = _constants.TICK_HZ
local _field = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "field")
local attackDir = _field.attackDir
local formationPosition = _field.formationPosition
local resetForKickoff = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "match").resetForKickoff
local EMPTY_INPUT = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "types").EMPTY_INPUT
local DEFAULT_HALF_SECONDS = 120
local function createInitialState(setup, sizeParams)
	local _condition = setup.halfSeconds
	if _condition == nil then
		_condition = DEFAULT_HALF_SECONDS
	end
	local halfTicks = math.floor(_condition * TICK_HZ + 0.5)
	local _object = {
		tick = 0,
	}
	local _left = "rng"
	local _condition_1 = (bit32.rshift(setup.seed, 0))
	if not (_condition_1 ~= 0 and _condition_1 == _condition_1 and _condition_1) then
		_condition_1 = 0x9e3779b9
	end
	_object[_left] = _condition_1
	_object.players = {}
	_object.riders = {}
	_object.waves = {}
	_object.iceFields = {}
	_object.nextIceId = 1
	_object.gusts = {}
	_object.nextGustId = 1
	_object.portals = {}
	_object.nextPortalId = 1
	_object.eastwinds = {}
	_object.nextEastWindId = 1
	_object.arrowships = {}
	_object.nextArrowShipId = 1
	_object.ball = {
		x = FIELD_W / 2,
		y = FIELD_D / 2,
		z = 0,
		vx = 0,
		vy = 0,
		vz = 0,
		ownerIdx = -1,
		lastTouchIdx = -1,
		special = nil,
		tiger = nil,
	}
	_object.match = {
		phase = "kickoff",
		phaseTimer = KICKOFF_TICKS,
		half = 1,
		clockTicks = halfTicks,
		halfTicks = halfTicks,
		score = { 0, 0 },
		swapped = false,
		kickoffTeam = 0,
		firstKickoffTeam = 0,
		lastGoal = nil,
		pk = nil,
	}
	_object.events = {}
	local state = _object
	for t = 0, 1 do
		local team = t
		local dir = attackDir(state, team)
		for slot = 0, 4 do
			local def = setup.teams[team + 1][slot + 1]
			local size = sizeParams[def.size]
			local pos = formationPosition(slot, dir)
			local maxStamina = STAMINA_BASE + def.stats.stamina * STAMINA_PER_STAT
			local _object_1 = {
				idx = team * 5 + slot,
				charId = def.id,
				name = def.name,
				team = team,
				role = def.role,
				size = def.size,
			}
			local _left_1 = "stats"
			local _object_2 = table.clone(def.stats)
			setmetatable(_object_2, nil)
			_object_1[_left_1] = _object_2
			_object_1.radius = size.radius
			_object_1.mass = size.mass
			_object_1.x = pos.x
			_object_1.y = pos.y
			_object_1.z = 0
			_object_1.vx = 0
			_object_1.vy = 0
			_object_1.vz = 0
			_object_1.facingX = dir
			_object_1.facingY = 0
			_object_1.stamina = maxStamina
			_object_1.maxStamina = maxStamina
			_object_1.action = "normal"
			_object_1.actionTimer = 0
			_object_1.hitDone = false
			_object_1.callPassTicks = 0
			_object_1.noTouchTicks = 0
			_object_1.chargeTicks = 0
			_object_1.rampageTicks = 0
			_object_1.bumpCooldown = 0
			_object_1.silenceTicks = 0
			_object_1.tigerTicks = 0
			_object_1.slashTicks = 0
			_object_1.rideHits = {}
			_object_1.arrowshipUp = false
			_object_1.sailTicks = 0
			_object_1.sailPassenger = -1
			_object_1.sailPassengerOf = -1
			_object_1.specialMode = def.special.mode or "rampage"
			_object_1.specialCooldown = 0
			_object_1.specialBuffer = 0
			_object_1.specialKind = def.special.kind
			_object_1.specialName = def.special.name
			local _left_2 = "specialNoBall"
			local _condition_2 = def.special.noBall
			if _condition_2 == nil then
				_condition_2 = false
			end
			_object_1[_left_2] = _condition_2
			local _left_3 = "specialBumpPct"
			local _condition_3 = def.special.bumpPct
			if _condition_3 == nil then
				_condition_3 = nil
			end
			_object_1[_left_3] = _condition_3
			local _left_4 = "prevInput"
			local _object_3 = table.clone(EMPTY_INPUT)
			setmetatable(_object_3, nil)
			_object_1[_left_4] = _object_3
			local player = _object_1
			local _exp = state.players
			table.insert(_exp, player)
		end
	end
	resetForKickoff(state)
	if setup.startInPlay then
		state.match.phase = "play"
		state.match.phaseTimer = 0
	end
	return state
end
return {
	createInitialState = createInitialState,
}
]]></string>
