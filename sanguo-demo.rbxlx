        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">PlayerView</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _theme = TS.import(script, script.Parent, "theme")
local characterOf = _theme.characterOf
local colorFromHex = _theme.colorFromHex
local countryColor = _theme.countryColor
local FONT = _theme.FONT
local STUDS_PER_PX = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "scale").STUDS_PER_PX
local DIMS = {
	S = {
		bw = 1.4,
		bh = 1.9,
		bd = 1.0,
		head = 0.9,
	},
	M = {
		bw = 1.7,
		bh = 2.4,
		bd = 1.2,
		head = 1.1,
	},
	L = {
		bw = 2.1,
		bh = 2.9,
		bd = 1.4,
		head = 1.3,
	},
}
local function newPart(parent, name, size, color)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end
--* A blocky player: team-coloured body, lighter head, dark visor on the front, and a name / stamina billboard. 
local PlayerView
do
	PlayerView = setmetatable({}, {
		__tostring = function()
			return "PlayerView"
		end,
	})
	PlayerView.__index = PlayerView
	function PlayerView.new(...)
		local self = setmetatable({}, PlayerView)
		return self:constructor(...) or self
	end
	function PlayerView:constructor(parent, charIdx, isMine, showStamina)
		self.lastRatio = -1
		self.lastRampage = false
		local def = characterOf(charIdx)
		self.charIdx = charIdx
		self.dims = DIMS[def.size]
		local d = self.dims
		local teamColor = countryColor(def.country)
		self.model = Instance.new("Model")
		self.model.Name = def.name
		self.body = newPart(self.model, "Body", Vector3.new(d.bw, d.bh, d.bd), teamColor)
		self.head = newPart(self.model, "Head", Vector3.new(d.head, d.head, d.head), teamColor:Lerp(Color3.new(1, 1, 1), 0.55))
		self.visor = newPart(self.model, "Visor", Vector3.new(d.head * 0.7, d.head * 0.25, 0.1), Color3.fromRGB(30, 30, 30))
		self.model.Parent = parent
		local gui = Instance.new("BillboardGui")
		gui.Name = "Tag"
		gui.Size = UDim2.fromOffset(120, 52)
		gui.StudsOffset = Vector3.new(0, d.head / 2 + 1.3, 0)
		gui.AlwaysOnTop = true
		gui.LightInfluence = 0
		gui.Adornee = self.head
		if isMine then
			local marker = Instance.new("TextLabel")
			marker.BackgroundTransparency = 1
			marker.Size = UDim2.fromOffset(120, 16)
			marker.Position = UDim2.fromOffset(0, 0)
			marker.Font = FONT
			marker.Text = "▼"
			marker.TextSize = 18
			marker.TextColor3 = colorFromHex(0xffd84a)
			marker.TextStrokeTransparency = 0.3
			marker.Parent = gui
		end
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1
		name.Size = UDim2.fromOffset(120, 20)
		name.Position = UDim2.fromOffset(0, 16)
		name.Font = FONT
		name.Text = def.name
		name.TextSize = 18
		name.TextColor3 = if isMine then colorFromHex(0xffd84a) else teamColor:Lerp(Color3.new(1, 1, 1), 0.45)
		name.TextStrokeTransparency = 0.3
		name.Parent = gui
		if showStamina then
			local back = Instance.new("Frame")
			back.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
			back.BackgroundTransparency = 0.3
			back.BorderSizePixel = 0
			back.Size = UDim2.fromOffset(64, 7)
			back.Position = UDim2.fromOffset(28, 38)
			back.Parent = gui
			local fill = Instance.new("Frame")
			fill.BackgroundColor3 = Color3.fromRGB(80, 220, 90)
			fill.BorderSizePixel = 0
			fill.Size = UDim2.fromScale(1, 1)
			fill.Parent = back
			self.fill = fill
		end
		gui.Parent = self.head
	end
	function PlayerView:update(x, y, z, facing, down, rampage, stamina, maxStamina)
		local d = self.dims
		local lift = if down then d.bd / 2 else 0
		local pos = Vector3.new(x * STUDS_PER_PX, z * STUDS_PER_PX + lift, y * STUDS_PER_PX)
		local _vector3 = Vector3.new(math.cos(facing), 0, math.sin(facing))
		local base = CFrame.lookAt(pos, pos + _vector3)
		if down then
			local _base = base
			local _arg0 = CFrame.Angles(math.rad(90), 0, 0)
			base = _base * _arg0
		end
		local _base = base
		local _cFrame = CFrame.new(0, d.bh / 2, 0)
		self.body.CFrame = _base * _cFrame
		local _base_1 = base
		local _cFrame_1 = CFrame.new(0, d.bh + d.head / 2, 0)
		self.head.CFrame = _base_1 * _cFrame_1
		local _base_2 = base
		local _cFrame_2 = CFrame.new(0, d.bh + d.head * 0.55, -d.head / 2)
		self.visor.CFrame = _base_2 * _cFrame_2
		if rampage ~= self.lastRampage then
			self.lastRampage = rampage
			self.body.Material = if rampage then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
		if self.fill ~= nil and maxStamina > 0 then
			local ratio = math.clamp(stamina / maxStamina, 0, 1)
			if math.abs(ratio - self.lastRatio) > 0.01 then
				self.lastRatio = ratio
				self.fill.Size = UDim2.fromScale(ratio, 1)
				self.fill.BackgroundColor3 = if ratio > 0.5 then Color3.fromRGB(80, 220, 90) elseif ratio > 0.25 then Color3.fromRGB(240, 200, 60) else Color3.fromRGB(230, 70, 60)
			end
		end
	end
	function PlayerView:destroy()
		self.model:Destroy()
	end
end
return {
	PlayerView = PlayerView,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">controls</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _input = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "input")
local ButtonLatch = _input.ButtonLatch
local buildInputFrame = _input.buildInputFrame
local DashDetector = _input.DashDetector
local inputsEqual = _input.inputsEqual
local FONT = TS.import(script, script.Parent, "theme").FONT
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local SEND_INTERVAL = 0.1
local STICK_RADIUS = 70
local STICK_DEADZONE = 0.4
local PAD_DEADZONE = 0.4
local function isPress(input)
	return input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1
end
--[[
	*
	 * Keyboard, gamepad and touch input. step() builds one InputFrame per call and hands it to `send` when it changed
	 * or when 100 ms passed since the last send. Quick presses are latched so a tap shorter than one frame is not lost.
	 
]]
local Controls
do
	Controls = setmetatable({}, {
		__tostring = function()
			return "Controls"
		end,
	})
	Controls.__index = Controls
	function Controls.new(...)
		local self = setmetatable({}, Controls)
		return self:constructor(...) or self
	end
	function Controls:constructor(gui, send)
		self.gui = gui
		self.send = send
		self.active = false
		self.keys = {}
		self.latch = ButtonLatch.new()
		self.dash = DashDetector.new()
		self.padX = 0
		self.padY = 0
		self.last = nil
		self.lastSent = -math.huge
		self.touchMoveX = 0
		self.touchMoveY = 0
		self.touchDash = false
		self.touchHeld = {
			j = false,
			k = false,
			l = false,
		}
		self.stickTouch = nil
		self.stickOrigin = Vector2.new(0, 0)
		UserInputService.InputBegan:Connect(function(input)
			return self:onBegan(input)
		end)
		UserInputService.InputEnded:Connect(function(input)
			return self:onEnded(input)
		end)
		UserInputService.InputChanged:Connect(function(input)
			return self:onChanged(input)
		end)
		self:buildHints()
		if UserInputService.TouchEnabled then
			self:buildTouch()
		end
	end
	function Controls:setActive(active)
		if self.active == active then
			return nil
		end
		self.active = active
		self.last = nil
		self.latch:clear()
	end
	function Controls:setSpecialCooldown(sec)
		local text = if sec > 0 then string.format("%.1f", sec) else "就緒"
		if self.specialLabel ~= nil then
			self.specialLabel.Text = `L 大招 {text}`
		end
		if self.specialButton ~= nil then
			self.specialButton.Text = if sec > 0 then `大招\n{text}` else "大招"
			self.specialButton.BackgroundColor3 = if sec > 0 then Color3.fromRGB(70, 70, 80) else Color3.fromRGB(150, 60, 190)
		end
	end
	function Controls:onBegan(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Gamepad1 then
			local _keys = self.keys
			local _keyCode = input.KeyCode
			_keys[_keyCode] = true
			local k = input.KeyCode
			if k == Enum.KeyCode.J or k == Enum.KeyCode.ButtonA then
				self.latch:press("j")
			elseif k == Enum.KeyCode.K or k == Enum.KeyCode.ButtonX then
				self.latch:press("k")
			elseif k == Enum.KeyCode.L or k == Enum.KeyCode.ButtonY then
				self.latch:press("l")
			end
		end
	end
	function Controls:onEnded(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.Gamepad1 then
			local _keys = self.keys
			local _keyCode = input.KeyCode
			_keys[_keyCode] = nil
		end
		if input == self.stickTouch then
			self:endStick()
		end
	end
	function Controls:onChanged(input)
		if input.UserInputType == Enum.UserInputType.Gamepad1 and input.KeyCode == Enum.KeyCode.Thumbstick1 then
			self.padX = input.Position.X
			self.padY = input.Position.Y
		end
		if input == self.stickTouch then
			self:moveStick(Vector2.new(input.Position.X, input.Position.Y))
		end
	end
	function Controls:down(...)
		local codes = { ... }
		for _, c in codes do
			if self.keys[c] ~= nil then
				return true
			end
		end
		return false
	end
	function Controls:step(now)
		local K = Enum.KeyCode
		local left = self:down(K.A, K.Left) or self.padX < -PAD_DEADZONE or self:down(K.DPadLeft)
		local right = self:down(K.D, K.Right) or self.padX > PAD_DEADZONE or self:down(K.DPadRight)
		local up = self:down(K.W, K.Up) or self.padY > PAD_DEADZONE or self:down(K.DPadUp)
		local downKey = self:down(K.S, K.Down) or self.padY < -PAD_DEADZONE or self:down(K.DPadDown)
		local heldJ = self:down(K.J, K.ButtonA) or self.touchHeld.j
		local heldK = self:down(K.K, K.ButtonX) or self.touchHeld.k
		local heldL = self:down(K.L, K.ButtonY) or self.touchHeld.l
		local base = buildInputFrame({
			left = left,
			right = right,
			up = up,
			down = downKey,
			j = false,
			k = false,
			l = false,
			dashButton = false,
		}, false)
		local doubleTap = self.dash:update(base.moveX, base.moveY, now)
		local shift = self:down(K.LeftShift, K.RightShift, K.ButtonR1)
		local moveX = if left ~= right then base.moveX else self.touchMoveX
		local moveY = if up ~= downKey then base.moveY else self.touchMoveY
		local frame = {
			moveX = moveX,
			moveY = moveY,
			dash = doubleTap or shift or self.touchDash,
			j = self.latch:consume("j", heldJ),
			k = self.latch:consume("k", heldK),
			l = self.latch:consume("l", heldL),
		}
		if not self.active then
			return nil
		end
		if self.last == nil or not inputsEqual(frame, self.last) or now - self.lastSent >= SEND_INTERVAL then
			self.last = frame
			self.lastSent = now
			self.send(frame)
		end
	end
	function Controls:buildHints()
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			return nil
		end
		local l = Instance.new("TextLabel")
		l.BackgroundTransparency = 1
		l.Size = UDim2.fromOffset(520, 22)
		l.Position = UDim2.new(0, 12, 1, -30)
		l.Font = FONT
		l.TextSize = 16
		l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextColor3 = Color3.fromRGB(235, 235, 235)
		l.TextStrokeTransparency = 0.4
		l.Text = "WASD/方向鍵 移動　Shift/連按 衝刺　J 攻擊射門(按住蓄力)　K 傳球/叫球　L 大招"
		l.Parent = self.gui
		local cd = Instance.new("TextLabel")
		cd.BackgroundTransparency = 1
		cd.Size = UDim2.fromOffset(220, 26)
		cd.Position = UDim2.new(1, -232, 1, -36)
		cd.Font = FONT
		cd.TextSize = 22
		cd.TextXAlignment = Enum.TextXAlignment.Right
		cd.TextColor3 = Color3.fromRGB(255, 232, 140)
		cd.TextStrokeTransparency = 0.4
		cd.Text = "L 大招 就緒"
		cd.Parent = self.gui
		self.specialLabel = cd
	end
	function Controls:buildTouch()
		-- Left half of the screen is the joystick drag area.
		local zone = Instance.new("Frame")
		zone.Name = "StickZone"
		zone.BackgroundTransparency = 1
		zone.Size = UDim2.fromScale(0.5, 1)
		zone.Active = true
		zone.Parent = self.gui
		zone.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Touch or self.stickTouch ~= nil then
				return nil
			end
			self.stickTouch = input
			self.stickOrigin = Vector2.new(input.Position.X, input.Position.Y)
			self:showStick(true)
			self:moveStick(self.stickOrigin)
		end)
		local base = Instance.new("Frame")
		base.Name = "StickBase"
		base.AnchorPoint = Vector2.new(0.5, 0.5)
		base.Size = UDim2.fromOffset(STICK_RADIUS * 2, STICK_RADIUS * 2)
		base.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		base.BackgroundTransparency = 0.8
		base.BorderSizePixel = 0
		base.Visible = false
		local baseCorner = Instance.new("UICorner")
		baseCorner.CornerRadius = UDim.new(1, 0)
		baseCorner.Parent = base
		base.Parent = self.gui
		self.stickBase = base
		local knob = Instance.new("Frame")
		knob.Name = "StickKnob"
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.fromOffset(56, 56)
		knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		knob.BackgroundTransparency = 0.4
		knob.BorderSizePixel = 0
		knob.Visible = false
		local knobCorner = Instance.new("UICorner")
		knobCorner.CornerRadius = UDim.new(1, 0)
		knobCorner.Parent = knob
		knob.Parent = self.gui
		self.stickKnob = knob
		self:makeButton("j", "攻擊\n射門", 120, UDim2.new(1, -90, 1, -90), Color3.fromRGB(210, 70, 60))
		self:makeButton("k", "傳球\n叫球", 84, UDim2.new(1, -225, 1, -55), Color3.fromRGB(60, 140, 210))
		self.specialButton = self:makeButton("l", "大招", 84, UDim2.new(1, -150, 1, -185), Color3.fromRGB(150, 60, 190))
	end
	function Controls:makeButton(action, text, size, pos, color)
		local b = Instance.new("TextButton")
		b.Name = `Btn_{action}`
		b.AnchorPoint = Vector2.new(0.5, 0.5)
		b.Size = UDim2.fromOffset(size, size)
		b.Position = pos
		b.BackgroundColor3 = color
		b.BackgroundTransparency = 0.25
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Font = FONT
		b.TextSize = if size > 100 then 28 else 22
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Text = text
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = b
		b.InputBegan:Connect(function(input)
			if not isPress(input) then
				return nil
			end
			self.touchHeld[action] = true
			self.latch:press(action)
		end)
		b.InputEnded:Connect(function(input)
			if isPress(input) then
				self.touchHeld[action] = false
			end
		end)
		b.Parent = self.gui
		return b
	end
	function Controls:drawAt(x, y)
		local inset = GuiService:GetGuiInset()
		return UDim2.fromOffset(x + inset.X, y + inset.Y)
	end
	function Controls:showStick(visible)
		if self.stickBase ~= nil then
			self.stickBase.Visible = visible
			self.stickBase.Position = self:drawAt(self.stickOrigin.X, self.stickOrigin.Y)
		end
		if self.stickKnob ~= nil then
			self.stickKnob.Visible = visible
			self.stickKnob.Position = self:drawAt(self.stickOrigin.X, self.stickOrigin.Y)
		end
	end
	function Controls:moveStick(pos)
		local _pos = pos
		local _stickOrigin = self.stickOrigin
		local d = _pos - _stickOrigin
		local mag = d.Magnitude
		local _result
		if mag > STICK_RADIUS then
			local _arg0 = STICK_RADIUS / mag
			_result = d * _arg0
		else
			_result = d
		end
		local shown = _result
		if self.stickKnob ~= nil then
			self.stickKnob.Position = self:drawAt(self.stickOrigin.X + shown.X, self.stickOrigin.Y + shown.Y)
		end
		local nx = shown.X / STICK_RADIUS
		local ny = shown.Y / STICK_RADIUS
		self.touchMoveX = if nx > STICK_DEADZONE then 1 elseif nx < -STICK_DEADZONE then -1 else 0
		self.touchMoveY = if ny > STICK_DEADZONE then 1 elseif ny < -STICK_DEADZONE then -1 else 0
		-- Pushed to the edge of the stick = dash.
		self.touchDash = mag >= STICK_RADIUS
	end
	function Controls:endStick()
		self.stickTouch = nil
		self.touchMoveX = 0
		self.touchMoveY = 0
		self.touchDash = false
		self:showStick(false)
	end
end
return {
	Controls = Controls,
}
]]></string>
          </Properties>
