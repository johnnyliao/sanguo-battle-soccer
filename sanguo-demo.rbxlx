        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">specialText</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
--* Short shot names used in the rampage effect text ("按攻擊射{name}球"). 
local SHOT_NAME = {
	straight = "直線高速",
	zigzag = "蛇行",
	lob = "高吊下墜",
	pierce = "穿人擊倒",
	beam = "光彈",
}
--[[
	*
	 * Team-select text for a special: when it can be used (condition) and what it does (effect, one short sentence).
	 * Matches the rules in CLAUDE.md; the 12 s cooldown is shown by the caller.
	 
]]
local function specialDescription(def)
	local _binding = def.special
	local kind = _binding.kind
	local mode = _binding.mode
	if mode == nil then
		mode = "rampage"
	end
	local noBall = _binding.noBall
	if noBall == nil then
		noBall = false
	end
	local condition = if noBall then "持球或不持球" else "持球"
	repeat
		if mode == "rampage" then
			return {
				condition = condition,
				effect = `無敵撞飛敵人，可帶球進門或射{SHOT_NAME[kind]}球`,
			}
		end
		if mode == "roar" then
			return {
				condition = "持球或不持球",
				effect = "震開周圍敵人暈眩、震飛範圍內的球，持球者掉球",
			}
		end
		if mode == "lunge" then
			return {
				condition = condition,
				effect = "無敵突進撞開敵人，撞敵扣20%、每撞一人回20%",
			}
		end
		if mode == "beam" then
			return {
				condition = condition,
				effect = "集氣後隨機擊倒一名敵人1秒、扣30%，持球者掉球",
			}
		end
		if mode == "summon" then
			return {
				condition = condition,
				effect = "5名鐵騎追擊3秒，撞倒扣10%，持球者掉球",
			}
		end
		if mode == "fear" then
			return {
				condition = condition,
				effect = "周圍200px敵定身3秒、扣10%，持球者掉球",
			}
		end
		if mode == "leap" then
			return {
				condition = "持球或不持球",
				effect = "後跳飛撲，落地周圍敵扣15%並沉默2秒",
			}
		end
		if mode == "tiger" then
			return {
				condition = "持球或不持球",
				effect = "5秒吞射正門，吐球砸敵扣80%暈3秒；沒吞則震退扣10%",
			}
		end
		if mode == "slash" then
			return {
				condition = "持球或不持球",
				effect = "5秒每0.2秒揮刀，刀氣命中扣5%、回補自己5%",
			}
		end
		if mode == "ride" then
			return {
				condition = "持球或不持球",
				effect = "騎車衝刺，撞開路上敵人扣 20%",
			}
		end
		if mode == "sail" then
			return {
				condition = "持球或不持球",
				effect = "上船滑行4秒移速+50%，撞敵擊飛1秒扣80%；可載隊友",
			}
		end
		if mode == "gust" then
			return {
				condition = "持球或不持球",
				effect = "最近敵人腳下0.5秒後櫻花龍捲，周圍敵擊飛1秒扣50%",
			}
		end
		if mode == "portal" then
			return {
				condition = "持球或不持球",
				effect = "開法陣0.5秒後召喚隊友到身邊；陣內敵緩速70%持續扣血",
			}
		end
		if mode == "eastwind" then
			return {
				condition = "持球或不持球",
				effect = "東風吹開周圍敵人，3秒內陣中敵緩速85%每秒扣10%",
			}
		end
		if mode == "arrowship" then
			return {
				condition = "持球或不持球",
				effect = "門前戰船擋射門與攻擊2秒，之後萬箭射回擊退扣30%",
			}
		end
		if mode == "icefield" then
			return {
				condition = "持球或不持球",
				effect = "原地冰雨4秒(半徑110)，內敵緩速85%、每0.5秒扣5%",
			}
		end
	until true
end
return {
	specialDescription = specialDescription,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">types</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
-- Shared character data types (pure TS, used by src/sim and src/data).
--* Special shot behaviour: straight fast / zigzag / high lob that drops / pierce (knocks down players it hits) / beam (flat, knocks down every opponent in its path, cannot be saved). 
return nil
