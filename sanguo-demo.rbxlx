		attackerIdx = tiger.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = v.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
end
--[[
	*
	 * Ends every tiger guard (silently, no roar) and any tiger ball when the phase leaves play. Called from step after the
	 * match phase is updated.
	 
