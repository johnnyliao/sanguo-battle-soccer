        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">field</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local FIELD_D = _constants.FIELD_D
local FIELD_W = _constants.FIELD_W
local GK_AREA_DEPTH = _constants.GK_AREA_DEPTH
local GOAL_H = _constants.GOAL_H
local GOAL_HALF_W = _constants.GOAL_HALF_W
local MOUTH_Y_MIN = FIELD_D / 2 - GOAL_HALF_W
local MOUTH_Y_MAX = FIELD_D / 2 + GOAL_HALF_W
--* side 0 = left goal (x = 0), side 1 = right goal (x = FIELD_W). 
local function goalMouth(side)
	return {
		x = if side == 0 then 0 else FIELD_W,
		yMin = MOUTH_Y_MIN,
		yMax = MOUTH_Y_MAX,
		zMax = GOAL_H,
	}
end
--* True if a point at depth y and height z is within the goal mouth opening. 
local function isInGoalMouth(y, z)
	return y >= MOUTH_Y_MIN and y <= MOUTH_Y_MAX and z < GOAL_H
end
--* Direction a team attacks this half: +1 toward x = FIELD_W, -1 toward x = 0. Team 0 attacks +1 until the side swap. 
local function attackDir(state, team)
	if team == 0 then
		return if state.match.swapped then -1 else 1
	end
	return if state.match.swapped then 1 else -1
end
--* x of the goal the team attacks. 
local function opponentGoalX(state, team)
	return if attackDir(state, team) == 1 then FIELD_W else 0
end
--* x of the goal the team defends. 
local function ownGoalX(state, team)
	return if attackDir(state, team) == 1 then 0 else FIELD_W
end
--* True if the player is within the goalkeeper area in front of its own goal. 
local function inOwnArea(state, p)
	return math.abs(p.x - ownGoalX(state, p.team)) < GK_AREA_DEPTH
end
-- Formation offsets measured from the team's own goal line (x), for a team attacking +x. slot order GK,DF,MF,MF,FW.
local FORMATION = { {
	x = 40,
	y = FIELD_D / 2,
}, {
	x = 250,
	y = FIELD_D / 2,
}, {
	x = 420,
	y = FIELD_D / 2 - 60,
}, {
	x = 420,
	y = FIELD_D / 2 + 60,
}, {
	x = 540,
	y = FIELD_D / 2,
} }
--* Formation spot for a slot, mirrored when the team attacks -x (dir -1). 
local function formationPosition(slot, dir)
	local p = FORMATION[slot + 1]
	return {
		x = if dir == 1 then p.x else FIELD_W - p.x,
		y = p.y,
	}
end
return {
	goalMouth = goalMouth,
	isInGoalMouth = isInGoalMouth,
	attackDir = attackDir,
	opponentGoalX = opponentGoalX,
	ownGoalX = ownGoalX,
	inOwnArea = inOwnArea,
	formationPosition = formationPosition,
}
]]></string>
          </Properties>
