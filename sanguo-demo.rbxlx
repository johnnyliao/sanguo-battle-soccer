        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">scale</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
-- Sim px to Roblox studs. Pure math, no Roblox services (unit-tested under Lune).
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local FIELD_D = _constants.FIELD_D
local FIELD_W = _constants.FIELD_W
--* 1 stud = 10 sim px. 
local STUDS_PER_PX = 0.1
local FIELD_STUDS_W = FIELD_W * STUDS_PER_PX
local FIELD_STUDS_D = FIELD_D * STUDS_PER_PX
local function pxToStud(px)
	return px * STUDS_PER_PX
end
--* Sim (x, y, z) to world (X, Y, Z): sim x is world X, sim y (depth) is world Z, sim z (height) is world Y. 
local function simToWorld(x, y, z)
	return { x * STUDS_PER_PX, z * STUDS_PER_PX, y * STUDS_PER_PX }
end
return {
	pxToStud = pxToStud,
	simToWorld = simToWorld,
	STUDS_PER_PX = STUDS_PER_PX,
	FIELD_STUDS_W = FIELD_STUDS_W,
	FIELD_STUDS_D = FIELD_STUDS_D,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">slots</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
-- Human slot assignment (pure). Slot 0 = team 0 (the country the first player picked), slot 1 = the opponent team.
local COUNTRIES = { "wei", "shu", "wu" }
local function isCountry(v)
	return v == "wei" or v == "shu" or v == "wu"
end
--* Slot index of a user, or -1 for a spectator. 
local function slotOf(slots, userId)
	if slots[1] == userId then
		return 0
	end
	if slots[2] == userId then
		return 1
	end
	return -1
end
--* Gives the user the lowest free slot (no change if already seated). Returns the slot, or -1 if both are taken. 
local function assignSlot(slots, userId)
	local existing = slotOf(slots, userId)
	if existing ~= -1 then
		return existing
	end
	if slots[1] == nil then
		slots[1] = userId
		return 0
	end
	if slots[2] == nil then
		slots[2] = userId
		return 1
	end
	return -1
end
local function releaseSlot(slots, userId)
	if slots[1] == userId then
		slots[1] = nil
	end
	if slots[2] == userId then
		slots[2] = nil
	end
end
--* Player index a slot controls: the FW (slot order GK, DF, MF, MF, FW) of that team. 
local function humanIdxForSlot(slot)
	return if slot < 0 then -1 else slot * 5 + 4
end
--* Per-player flags: true where a human controls the player (an empty slot stays AI). 
local function humanMask(slots, playerCount)
	local mask = {}
	do
		local i = 0
		local _shouldIncrement = false
		while true do
			if _shouldIncrement then
				i += 1
			else
				_shouldIncrement = true
			end
			if not (i < playerCount) then
				break
			end
			table.insert(mask, false)
		end
	end
	for s = 0, 1 do
		if slots[s + 1] ~= nil then
			mask[humanIdxForSlot(s) + 1] = true
		end
	end
	return mask
end
--* Opponent of the picked country. `r` is a uniform number in [0, 1). 
local function pickOpponent(country, r)
	local others = {}
	for _, c in COUNTRIES do
		if c ~= country then
			table.insert(others, c)
		end
	end
	return others[math.min(#others - 1, math.floor(r * #others)) + 1]
end
return {
	isCountry = isCountry,
	slotOf = slotOf,
	assignSlot = assignSlot,
	releaseSlot = releaseSlot,
	humanIdxForSlot = humanIdxForSlot,
	humanMask = humanMask,
	pickOpponent = pickOpponent,
	COUNTRIES = COUNTRIES,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">snapshot</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
-- Compact snapshot encoding (pure; uses the Luau `buffer` type only). One snapshot is about 180 bytes, well under the
-- 900 byte limit of an UnreliableRemoteEvent.
local CHARACTERS = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "data", "characters").CHARACTERS
local PLAYER_ACTIONS = { "normal", "punch", "tackle", "hitstun", "down", "recover", "charge", "dive", "lunge", "cast", "fear", "leap", "tiger", "slash", "ride", "icefield" }
local MATCH_PHASES = { "kickoff", "play", "goal", "halftime", "fulltime", "pk" }
local HEADER_BYTES = 19
local PLAYER_BYTES = 16
local PLAYER_COUNT = 10
local SNAPSHOT_BYTES = HEADER_BYTES + PLAYER_BYTES * PLAYER_COUNT
local function charIndex(charId)
	for i = 0, #CHARACTERS - 1 do
		if CHARACTERS[i + 1].id == charId then
			return i
		end
	end
	return 0
end
local function clampInt(v, lo, hi)
	return math.min(hi, math.max(lo, math.floor(v + 0.5)))
end
--* Position values are stored in tenths of a px (error up to 0.05 px). 
local function q10(v)
	return clampInt(v * 10, -32768, 32767)
end
local function encodeSnapshot(state)
	local b = buffer.create(SNAPSHOT_BYTES)
	local m = state.match
	buffer.writeu32(b, 0, state.tick)
	local _phase = m.phase
	buffer.writeu8(b, 4, (table.find(MATCH_PHASES, _phase) or 0) - 1)
	buffer.writeu8(b, 5, m.half)
	buffer.writeu16(b, 6, clampInt(m.clockTicks, 0, 65535))
	buffer.writeu8(b, 8, clampInt(m.score[1], 0, 255))
	buffer.writeu8(b, 9, clampInt(m.score[2], 0, 255))
	buffer.writei16(b, 10, q10(state.ball.x))
	buffer.writei16(b, 12, q10(state.ball.y))
	buffer.writei16(b, 14, q10(state.ball.z))
	buffer.writei8(b, 16, state.ball.ownerIdx)
	-- bytes 17..18 reserved (zero)
	for i = 0, PLAYER_COUNT - 1 do
		local p = state.players[i + 1]
		local o = HEADER_BYTES + i * PLAYER_BYTES
		buffer.writei16(b, o, q10(p.x))
		buffer.writei16(b, o + 2, q10(p.y))
		buffer.writei16(b, o + 4, q10(p.z))
		local angle = math.atan2(p.facingY, p.facingX)
		buffer.writeu8(b, o + 6, math.floor(((angle + math.pi) / (2 * math.pi)) * 256) % 256)
		local _exp = o + 7
		local _action = p.action
		buffer.writeu8(b, _exp, math.max(0, (table.find(PLAYER_ACTIONS, _action) or 0) - 1))
		buffer.writeu16(b, o + 8, clampInt(p.stamina * 10, 0, 65535))
		buffer.writeu16(b, o + 10, clampInt(p.maxStamina * 10, 0, 65535))
		buffer.writeu16(b, o + 12, clampInt(p.specialCooldown, 0, 65535))
		local flags = (if p.action == "down" then 1 else 0) + (if p.team == 1 then 2 else 0) + (if p.rampageTicks > 0 then 4 else 0)
		buffer.writeu8(b, o + 14, flags)
		buffer.writeu8(b, o + 15, charIndex(p.charId))
	end
	return b
end
--* Returns undefined when the buffer has the wrong size or an out-of-range enum code. 
local function decodeSnapshot(b)
	if buffer.len(b) ~= SNAPSHOT_BYTES then
		return nil
	end
	local phase = MATCH_PHASES[buffer.readu8(b, 4) + 1]
	local half = buffer.readu8(b, 5)
	if phase == nil or (half ~= 1 and half ~= 2) then
		return nil
	end
	local players = {}
	for i = 0, PLAYER_COUNT - 1 do
		local o = HEADER_BYTES + i * PLAYER_BYTES
		local action = PLAYER_ACTIONS[buffer.readu8(b, o + 7) + 1]
		local flags = buffer.readu8(b, o + 14)
		local charIdx = buffer.readu8(b, o + 15)
		if action == nil or charIdx >= #CHARACTERS then
			return nil
		end
		local _arg0 = {
			x = buffer.readi16(b, o) / 10,
			y = buffer.readi16(b, o + 2) / 10,
			z = buffer.readi16(b, o + 4) / 10,
			facing = (buffer.readu8(b, o + 6) / 256) * 2 * math.pi - math.pi,
			action = action,
			stamina = buffer.readu16(b, o + 8) / 10,
			maxStamina = buffer.readu16(b, o + 10) / 10,
			specialCooldown = buffer.readu16(b, o + 12),
			down = (bit32.band(flags, 1)) ~= 0,
			team = if (bit32.band(flags, 2)) ~= 0 then 1 else 0,
			charIdx = charIdx,
			rampage = (bit32.band(flags, 4)) ~= 0,
		}
		table.insert(players, _arg0)
	end
	return {
		tick = buffer.readu32(b, 0),
		phase = phase,
		half = half,
		clockTicks = buffer.readu16(b, 6),
		score = { buffer.readu8(b, 8), buffer.readu8(b, 9) },
		ball = {
			x = buffer.readi16(b, 10) / 10,
			y = buffer.readi16(b, 12) / 10,
			z = buffer.readi16(b, 14) / 10,
			ownerIdx = buffer.readi8(b, 16),
		},
		players = players,
	}
end
return {
	charIndex = charIndex,
	encodeSnapshot = encodeSnapshot,
	decodeSnapshot = decodeSnapshot,
	PLAYER_ACTIONS = PLAYER_ACTIONS,
	MATCH_PHASES = MATCH_PHASES,
	SNAPSHOT_BYTES = SNAPSHOT_BYTES,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">timestep</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
-- Fixed-timestep accumulator (pure). Same policy as the web game: clamp the frame time, cap the steps, drop any backlog.
local FixedStepper
do
	FixedStepper = setmetatable({}, {
		__tostring = function()
			return "FixedStepper"
		end,
	})
	FixedStepper.__index = FixedStepper
	function FixedStepper.new(...)
		local self = setmetatable({}, FixedStepper)
		return self:constructor(...) or self
	end
	function FixedStepper:constructor(stepSec, maxSteps, maxFrameSec)
		if stepSec == nil then
			stepSec = 1 / 60
		end
		if maxSteps == nil then
			maxSteps = 5
		end
		if maxFrameSec == nil then
			maxFrameSec = 0.25
		end
		self.stepSec = stepSec
		self.maxSteps = maxSteps
		self.maxFrameSec = maxFrameSec
		self.acc = 0
	end
	function FixedStepper:advance(dt)
		if dt > 0 then
			self.acc += math.min(dt, self.maxFrameSec)
		end
		local steps = 0
		-- 1e-9 absorbs float drift so 60 frames of 1/60 s give exactly 60 steps.
		while self.acc >= self.stepSec - 1e-9 and steps < self.maxSteps do
			self.acc -= self.stepSec
			steps += 1
		end
		if self.acc >= self.stepSec - 1e-9 then
			self.acc = 0
		end
		if self.acc < 0 then
			self.acc = 0
		end
		return steps
	end
	function FixedStepper:reset()
		self.acc = 0
	end
end
return {
	FixedStepper = FixedStepper,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="23">
