        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">field</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _scale = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "scale")
local FIELD_STUDS_D = _scale.FIELD_STUDS_D
local FIELD_STUDS_W = _scale.FIELD_STUDS_W
local STUDS_PER_PX = _scale.STUDS_PER_PX
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local GK_AREA_DEPTH = _constants.GK_AREA_DEPTH
local GOAL_DEPTH = _constants.GOAL_DEPTH
local GOAL_HALF_W = _constants.GOAL_HALF_W
local GOAL_H = _constants.GOAL_H
local function makePart(parent, name, size, cf, color, transparency)
	if transparency == nil then
		transparency = 0
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	p.Transparency = transparency
	p.Parent = parent
	return p
end
local WHITE = Color3.fromRGB(245, 245, 245)
local function buildGoal(parent, side)
	local x0 = if side == 0 then 0 else FIELD_STUDS_W
	local out = if side == 0 then -1 else 1
	local zc = FIELD_STUDS_D / 2
	local halfW = GOAL_HALF_W * STUDS_PER_PX
	local h = GOAL_H * STUDS_PER_PX
	local depth = GOAL_DEPTH * STUDS_PER_PX
	local t = 0.3
	local xb = x0 + out * depth
	for _, sz in { -1, 1 } do
		makePart(parent, "Post", Vector3.new(t, h, t), CFrame.new(x0, h / 2, zc + sz * halfW), WHITE)
		makePart(parent, "BackPost", Vector3.new(t, h, t), CFrame.new(xb, h / 2, zc + sz * halfW), WHITE)
		makePart(parent, "SideNet", Vector3.new(depth, h, 0.05), CFrame.new((x0 + xb) / 2, h / 2, zc + sz * halfW), WHITE, 0.75)
		makePart(parent, "SideBar", Vector3.new(depth, t, t), CFrame.new((x0 + xb) / 2, h, zc + sz * halfW), WHITE)
	end
	makePart(parent, "Crossbar", Vector3.new(t, t, halfW * 2 + t), CFrame.new(x0, h, zc), WHITE)
	makePart(parent, "BackBar", Vector3.new(t, t, halfW * 2 + t), CFrame.new(xb, h, zc), WHITE)
	makePart(parent, "BackNet", Vector3.new(0.05, h, halfW * 2), CFrame.new(xb, h / 2, zc), WHITE, 0.75)
	makePart(parent, "RoofNet", Vector3.new(depth, 0.05, halfW * 2), CFrame.new((x0 + xb) / 2, h, zc), WHITE, 0.8)
end
--* Builds the pitch under Workspace: grass, lines, two goals and a dark out-of-bounds border. Returns the folder. 
local function buildField()
	local folder = Instance.new("Folder")
	folder.Name = "SanguoField"
	local W = FIELD_STUDS_W
	local D = FIELD_STUDS_D
	-- Out of bounds: dark ground around the pitch, just below the grass.
	makePart(folder, "OutOfBounds", Vector3.new(W + 60, 1, D + 40), CFrame.new(W / 2, -0.6, D / 2), Color3.fromRGB(34, 36, 40))
	-- Grass in alternating stripes.
	local stripes = 12
	local sw = W / stripes
	for i = 0, stripes - 1 do
		local color = if i % 2 == 0 then Color3.fromRGB(78, 164, 84) else Color3.fromRGB(68, 150, 74)
		makePart(folder, "Grass", Vector3.new(sw, 1, D), CFrame.new(sw * i + sw / 2, -0.5, D / 2), color)
	end
	-- White lines, 0.06 studs thick on top of the grass.
	local lt = 0.25
	local line = function(sx, sz, cx, cz, yaw)
		if yaw == nil then
			yaw = 0
		end
		local _exp = Vector3.new(sx, 0.06, sz)
		local _cFrame = CFrame.new(cx, 0.03, cz)
		local _arg0 = CFrame.Angles(0, yaw, 0)
		makePart(folder, "Line", _exp, _cFrame * _arg0, WHITE)
	end
	line(W, lt, W / 2, lt / 2)
	line(W, lt, W / 2, D - lt / 2)
	line(lt, D, lt / 2, D / 2)
	line(lt, D, W - lt / 2, D / 2)
	line(lt, D, W / 2, D / 2)
	local area = GK_AREA_DEPTH * STUDS_PER_PX
	line(lt, D, area, D / 2)
	line(lt, D, W - area, D / 2)
	-- Centre circle from short segments.
	local segs = 28
	local radius = 4
	local segLen = (2 * math.pi * radius) / segs + 0.08
	for i = 0, segs - 1 do
		local a = (i / segs) * 2 * math.pi
		line(segLen, lt, W / 2 + math.cos(a) * radius, D / 2 + math.sin(a) * radius, -(a + math.pi / 2))
	end
	buildGoal(folder, 0)
	buildGoal(folder, 1)
	folder.Parent = game:GetService("Workspace")
	return folder
end
return {
	buildField = buildField,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">fx</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local STUDS_PER_PX = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "scale").STUDS_PER_PX
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local ICE = Color3.fromRGB(150, 220, 255)
local PORTAL = Color3.fromRGB(170, 90, 255)
local EASTWIND = Color3.fromRGB(140, 255, 190)
local ROAR = Color3.fromRGB(255, 160, 60)
local FEAR = Color3.fromRGB(150, 60, 200)
local GUST = Color3.fromRGB(255, 160, 200)
local HIT = Color3.fromRGB(255, 240, 150)
local SPECIAL = Color3.fromRGB(120, 230, 255)
local SHIP = Color3.fromRGB(122, 84, 48)
local DISC_H = 0.12
--* Simple visuals for specials. All coordinates arrive in sim px. 
local FxManager
do
	FxManager = setmetatable({}, {
		__tostring = function()
			return "FxManager"
		end,
	})
	FxManager.__index = FxManager
	function FxManager.new(...)
		local self = setmetatable({}, FxManager)
		return self:constructor(...) or self
	end
	function FxManager:constructor(parent, posOf)
		self.parent = parent
		self.posOf = posOf
		self.fields = {}
	end
	function FxManager:disc(x, y, radiusPx, color, transparency, lift)
		local p = Instance.new("Part")
		p.Name = "Fx"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Shape = Enum.PartType.Cylinder
		p.Material = Enum.Material.Neon
		p.Color = color
		p.Transparency = transparency
		local d = radiusPx * STUDS_PER_PX * 2
		p.Size = Vector3.new(DISC_H, d, d)
		-- A cylinder's axis is X: turn it so the axis is vertical and the disc lies flat.
		local _cFrame = CFrame.new(x * STUDS_PER_PX, lift, y * STUDS_PER_PX)
		local _arg0 = CFrame.Angles(0, 0, math.rad(90))
		p.CFrame = _cFrame * _arg0
		p.Parent = self.parent
		return p
	end
	function FxManager:ring(x, y, radiusPx, color, seconds)
		if seconds == nil then
			seconds = 0.6
		end
		local p = self:disc(x, y, 4, color, 0.35, 0.2)
		local d = radiusPx * STUDS_PER_PX * 2
		local tween = TweenService:Create(p, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(DISC_H, d, d),
			Transparency = 1,
		})
		tween:Play()
		Debris:AddItem(p, seconds + 0.2)
	end
	function FxManager:startField(key, e, color, transparency, lift)
		if e.x == nil or e.y == nil or e.r == nil then
			return nil
		end
		self:removeField(key)
		local p = self:disc(e.x, e.y, e.r, color, transparency, lift)
		p.Name = key
		local _fields = self.fields
		local _key = key
		_fields[_key] = p
		Debris:AddItem(p, 15)
	end
	function FxManager:removeField(key)
		local _fields = self.fields
		local _key = key
		local p = _fields[_key]
		if p ~= nil then
			p:Destroy()
			local _fields_1 = self.fields
			local _key_1 = key
			_fields_1[_key_1] = nil
		end
	end
	function FxManager:handle(e)
		local _condition = e.id
		if _condition == nil then
			_condition = 0
		end
		local id = _condition
		local _exp = e.t
		repeat
			if _exp == "iceStart" then
				self:startField(`ice{id}`, e, ICE, 0.55, 0.1)
				break
			end
			if _exp == "iceEnd" then
				self:removeField(`ice{id}`)
				break
			end
			if _exp == "portalStart" then
				self:startField(`portal{id}`, e, PORTAL, 0.55, 0.12)
				break
			end
			if _exp == "portalEnd" then
				self:removeField(`portal{id}`)
				break
			end
			if _exp == "eastwindStart" then
				self:startField(`wind{id}`, e, EASTWIND, 0.6, 0.14)
				break
			end
			if _exp == "eastwindEnd" then
				self:removeField(`wind{id}`)
				break
			end
			if _exp == "arrowshipStart" then
				if e.x == nil or e.y == nil or e.w == nil then
					break
				end
				local key = `ship{id}`
				self:removeField(key)
				local p = Instance.new("Part")
				p.Name = key
				p.Anchored = true
				p.CanCollide = false
				p.CanQuery = false
				p.CanTouch = false
				p.Material = Enum.Material.Wood
				p.Color = SHIP
				p.Size = Vector3.new(1.2, 4, e.w * STUDS_PER_PX * 2)
				p.CFrame = CFrame.new(e.x * STUDS_PER_PX, 2, e.y * STUDS_PER_PX)
				p.Parent = self.parent
				self.fields[key] = p
				Debris:AddItem(p, 15)
				break
			end
			if _exp == "arrowshipEnd" then
				self:removeField(`ship{id}`)
				break
			end
			if _exp == "roar" then
				if e.x ~= nil and e.y ~= nil and e.r ~= nil then
					self:ring(e.x, e.y, e.r, ROAR)
				end
				break
			end
			if _exp == "fear" then
				if e.x ~= nil and e.y ~= nil and e.r ~= nil then
					self:ring(e.x, e.y, e.r, FEAR, 0.8)
				end
				break
			end
			if _exp == "gustBlow" then
				if e.x ~= nil and e.y ~= nil and e.r ~= nil then
					self:ring(e.x, e.y, e.r, GUST)
				end
				break
			end
			if _exp == "hit" then
				local victim = if e.v ~= nil then self.posOf(e.v[1]) else nil
				if victim ~= nil then
					self:ring(victim[1], victim[2], 14, HIT, 0.3)
				end
				break
			end
			if _exp == "special" then
				local caster = if e.p ~= nil then self.posOf(e.p) else nil
				if caster ~= nil then
					self:ring(caster[1], caster[2], 30, SPECIAL, 0.5)
				end
				break
			end
			break
		until true
	end
	function FxManager:clear()
		for _, p in self.fields do
			p:Destroy()
		end
		table.clear(self.fields)
	end
end
return {
	FxManager = FxManager,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">hud</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local COUNTRIES = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "slots").COUNTRIES
local _theme = TS.import(script, script.Parent, "theme")
local countryColor = _theme.countryColor
local countryName = _theme.countryName
local FONT = _theme.FONT
local hexString = _theme.hexString
local function label(parent, size, pos, textSize, color)
	if color == nil then
		color = Color3.new(1, 1, 1)
	end
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Size = size
	l.Position = pos
	l.Font = FONT
	l.TextSize = textSize
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.4
	l.RichText = true
	l.Text = ""
	l.Parent = parent
	return l
end
--* Score, clock, toasts, the country pick panel and the result overlay. 
local Hud
do
	Hud = setmetatable({}, {
		__tostring = function()
			return "Hud"
		end,
	})
	Hud.__index = Hud
	function Hud.new(...)
		local self = setmetatable({}, Hud)
		return self:constructor(...) or self
	end
	function Hud:constructor(onPick)
		self.pickButtons = {}
		self.toastToken = 0
		self.resultToken = 0
		local gui = Instance.new("ScreenGui")
		gui.Name = "SanguoHud"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 5
		self.gui = gui
		self.score = label(gui, UDim2.fromOffset(420, 40), UDim2.new(0.5, -210, 0, 8), 32)
		self.clock = label(gui, UDim2.fromOffset(260, 24), UDim2.new(0.5, -130, 0, 50), 20, Color3.fromRGB(230, 230, 230))
		self.toastLabel = label(gui, UDim2.fromOffset(640, 44), UDim2.new(0.5, -320, 0, 92), 30, Color3.fromRGB(255, 232, 140))
		local pick = Instance.new("Frame")
		pick.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
		pick.BackgroundTransparency = 0.25
		pick.BorderSizePixel = 0
		pick.Size = UDim2.fromOffset(460, 220)
		pick.AnchorPoint = Vector2.new(0.5, 0.5)
		pick.Position = UDim2.fromScale(0.5, 0.5)
		pick.Visible = false
		pick.Parent = gui
		self.pickPanel = pick
		self.pickTitle = label(pick, UDim2.fromOffset(460, 60), UDim2.fromOffset(0, 12), 30)
		local order = COUNTRIES
		-- ▼ ReadonlyArray.forEach ▼
		local _callback = function(c, i)
			local b = Instance.new("TextButton")
			b.Size = UDim2.fromOffset(120, 100)
			b.Position = UDim2.fromOffset(25 + i * 145, 90)
			b.BackgroundColor3 = countryColor(c)
			b.BorderSizePixel = 0
			b.Font = FONT
			b.Text = countryName(c)
			b.TextSize = 54
			b.TextColor3 = Color3.new(1, 1, 1)
			b.AutoButtonColor = true
			b.Parent = pick
			b.Activated:Connect(function()
				return onPick(c)
			end)
			local _exp = self.pickButtons
			table.insert(_exp, b)
		end
		for _k, _v in order do
			_callback(_v, _k - 1, order)
		end
		-- ▲ ReadonlyArray.forEach ▲
		local result = Instance.new("Frame")
		result.BackgroundColor3 = Color3.fromRGB(15, 18, 24)
		result.BackgroundTransparency = 0.2
		result.BorderSizePixel = 0
		result.Size = UDim2.fromOffset(460, 200)
		result.AnchorPoint = Vector2.new(0.5, 0.5)
		result.Position = UDim2.fromScale(0.5, 0.45)
		result.Visible = false
		result.Parent = gui
		self.resultPanel = result
		self.resultLabel = label(result, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0), 32)
		local player = game:GetService("Players").LocalPlayer
		gui.Parent = player:WaitForChild("PlayerGui")
	end
	function Hud:scoreText(teams, score)
		local c0 = hexString(countryColor(teams[1]))
		local c1 = hexString(countryColor(teams[2]))
		return `<font color="{c0}">{countryName(teams[1])}</font>  {score[1]} - {score[2]}  <font color="{c1}">{countryName(teams[2])}</font>`
	end
	function Hud:setScore(teams, score)
		self.score.Text = if teams == nil then "" else self:scoreText(teams, score)
	end
	function Hud:setClock(text)
		self.clock.Text = text
	end
	function Hud:toast(text, seconds)
		if seconds == nil then
			seconds = 2
		end
		self.toastToken += 1
		local token = self.toastToken
		self.toastLabel.Text = text
		task.delay(seconds, function()
			if self.toastToken == token then
				self.toastLabel.Text = ""
			end
		end)
	end
	function Hud:showPick(canPick)
		self.pickPanel.Visible = true
		self.pickTitle.Text = if canPick then "選擇你的國家" else "等待第一位玩家選擇國家…"
		for _, b in self.pickButtons do
			b.Visible = canPick
		end
	end
	function Hud:hidePick()
		self.pickPanel.Visible = false
	end
	function Hud:showResult(teams, score, pk, seconds)
		self.resultToken += 1
		local token = self.resultToken
		self.resultPanel.Visible = true
		local body = if teams == nil then `{score[1]} - {score[2]}` else self:scoreText(teams, score)
		local pkLine = if pk ~= nil then `\nPK {pk[1]} - {pk[2]}` else ""
		local render = function(left)
			self.resultLabel.Text = `比賽結束\n{body}{pkLine}\n<font size="20">{left} 秒後重新開始</font>`
		end
		local left = math.ceil(seconds)
		render(left)
		task.spawn(function()
			while left > 0 and self.resultToken == token do
				task.wait(1)
				left -= 1
				if self.resultToken == token and left >= 0 then
					render(left)
				end
			end
		end)
	end
	function Hud:hideResult()
		self.resultToken += 1
		self.resultPanel.Visible = false
	end
end
return {
	Hud = Hud,
}
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="58">
          <Properties>
            <string name="Name">main</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _camera = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "camera")
local cameraFov = _camera.cameraFov
local cameraTargetX = _camera.cameraTargetX
local smooth = _camera.smooth
local SnapshotBuffer = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "interp").SnapshotBuffer
local _remotes = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "remotes")
local REMOTES_FOLDER = _remotes.REMOTES_FOLDER
local REMOTE_EVENTS = _remotes.REMOTE_EVENTS
local REMOTE_INPUT = _remotes.REMOTE_INPUT
local REMOTE_LOBBY = _remotes.REMOTE_LOBBY
local REMOTE_PICK = _remotes.REMOTE_PICK
local REMOTE_READY = _remotes.REMOTE_READY
local REMOTE_SNAP = _remotes.REMOTE_SNAP
local _scale = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "scale")
local FIELD_STUDS_D = _scale.FIELD_STUDS_D
local FIELD_STUDS_W = _scale.FIELD_STUDS_W
local STUDS_PER_PX = _scale.STUDS_PER_PX
local decodeSnapshot = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "snapshot").decodeSnapshot
local isCountry = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "slots").isCountry
local TICK_HZ = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants").TICK_HZ
local Controls = TS.import(script, script.Parent, "controls").Controls
local buildField = TS.import(script, script.Parent, "field").buildField
local FxManager = TS.import(script, script.Parent, "fx").FxManager
local Hud = TS.import(script, script.Parent, "hud").Hud
local PlayerView = TS.import(script, script.Parent, "PlayerView").PlayerView
local countryName = TS.import(script, script.Parent, "theme").countryName
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local RENDER_DELAY = 0.1
local VISIBLE_STUDS = 45
local CAM_DIST = 40
local CAM_PITCH = math.rad(35)
local CAM_MARGIN = 4
local CAM_FOLLOW_RATE = 4
local BALL_DIAMETER = 1.1
local remotes = ReplicatedStorage:WaitForChild(REMOTES_FOLDER)
local lobbyRemote = remotes:WaitForChild(REMOTE_LOBBY)
local eventsRemote = remotes:WaitForChild(REMOTE_EVENTS)
local snapRemote = remotes:WaitForChild(REMOTE_SNAP)
local readyRemote = remotes:WaitForChild(REMOTE_READY)
local pickRemote = remotes:WaitForChild(REMOTE_PICK)
local inputRemote = remotes:WaitForChild(REMOTE_INPUT)
-- ---- world -------------------------------------------------------------------------------------------------------------
buildField()
local dynamic = Instance.new("Folder")
dynamic.Name = "SanguoDynamic"
dynamic.Parent = Workspace
local ball = Instance.new("Part")
ball.Name = "Ball"
ball.Shape = Enum.PartType.Ball
ball.Size = Vector3.new(BALL_DIAMETER, BALL_DIAMETER, BALL_DIAMETER)
ball.Color = Color3.fromRGB(250, 250, 250)
ball.Material = Enum.Material.SmoothPlastic
ball.Anchored = true
ball.CanCollide = false
ball.CanQuery = false
ball.CanTouch = false
ball.Position = Vector3.new(FIELD_STUDS_W / 2, BALL_DIAMETER / 2, FIELD_STUDS_D / 2)
ball.Parent = dynamic
local ballShadow = Instance.new("Part")
ballShadow.Name = "BallShadow"
ballShadow.Shape = Enum.PartType.Cylinder
ballShadow.Color = Color3.fromRGB(0, 0, 0)
ballShadow.Transparency = 0.55
ballShadow.Material = Enum.Material.SmoothPlastic
ballShadow.Anchored = true
ballShadow.CanCollide = false
ballShadow.CanQuery = false
ballShadow.CanTouch = false
ballShadow.CastShadow = false
ballShadow.Size = Vector3.new(0.05, BALL_DIAMETER, BALL_DIAMETER)
ballShadow.Parent = dynamic
-- ---- state -------------------------------------------------------------------------------------------------------------
local snapshots = SnapshotBuffer.new()
local lobby = nil
local teams = nil
local views = {}
local lastPhase = ""
local lastScore = { -1, -1 }
local latest = nil
local camX = FIELD_STUDS_W / 2
local hud = Hud.new(function(country)
	return pickRemote:FireServer(country)
end)
local controls = Controls.new(hud.gui, function(frame)
	return inputRemote:FireServer(frame)
end)
local fx = FxManager.new(dynamic, function(idx)
	local _p = latest
	if _p ~= nil then
		_p = _p.players[idx + 1]
	end
	local p = _p
	return if p == nil then nil else { p.x, p.y }
end)
local function clearMatchVisuals()
	for _, v in views do
		local _result = v
		if _result ~= nil then
			_result:destroy()
		end
	end
	views = {}
	fx:clear()
	snapshots:reset()
	latest = nil
	lastPhase = ""
	lastScore = { -1, -1 }
	hud:setClock("")
	controls:setSpecialCooldown(0)
end
-- ---- remotes -----------------------------------------------------------------------------------------------------------
lobbyRemote.OnClientEvent:Connect(function(msg)
	local _prevMode = lobby
	if _prevMode ~= nil then
		_prevMode = _prevMode.mode
	end
	local prevMode = _prevMode
	lobby = msg
	if msg.teams ~= nil and isCountry(msg.teams[1]) and isCountry(msg.teams[2]) then
		teams = { msg.teams[1], msg.teams[2] }
	else
		teams = nil
	end
	controls:setActive(msg.mode == "play" and msg.humanIdx >= 0)
	if msg.mode == "pick" then
		clearMatchVisuals()
		hud:hideResult()
		hud:setScore(nil, { 0, 0 })
		hud:showPick(msg.canPick)
	elseif msg.mode == "play" then
		hud:hidePick()
		hud:hideResult()
		if prevMode ~= "play" then
			clearMatchVisuals()
		else
			-- A role change mid-match (a seat was freed): rebuild the tags so the marker moves.
			for _, v in views do
				local _result = v
				if _result ~= nil then
					_result:destroy()
				end
			end
			views = {}
		end
	else
		hud:hidePick()
		local _exp = teams
		local _exp_1 = msg.score or { 0, 0 }
		local _exp_2 = msg.pk
		local _condition = msg.restartSec
		if _condition == nil then
			_condition = 5
		end
		hud:showResult(_exp, _exp_1, _exp_2, _condition)
	end
end)
snapRemote.OnClientEvent:Connect(function(data)
	local snap = decodeSnapshot(data)
	if snap ~= nil then
		snapshots:push(os.clock(), snap)
	end
end)
eventsRemote.OnClientEvent:Connect(function(list)
	for _, e in list do
		fx:handle(e)
		if e.t == "goal" then
			local side = if e.team == 0 or e.team == 1 then (if teams ~= nil then countryName(teams[e.team + 1]) else "") else ""
			local _condition = e.n
			if _condition == nil then
				_condition = ""
			end
			hud:toast(`進球！ {side} {_condition}`, 3)
		elseif e.t == "special" then
			local _condition = e.m
			if _condition == nil then
				_condition = ""
			end
			local _condition_1 = e.n
			if _condition_1 == nil then
				_condition_1 = ""
			end
			hud:toast(`{_condition}：{_condition_1}`, 2)
		elseif e.t == "pkResult" then
			hud:toast(if e.n == "goal" then "PK 進球！" elseif e.n == "save" then "PK 撲救！" else "PK 射失", 2)
		elseif e.t == "whistle" and e.n == "half" then
			hud:toast("中場休息", 2)
		end
	end
end)
-- ---- per-frame update ---------------------------------------------------------------------------------------------------
local function ensureViews(s)
	local _result = lobby
	if _result ~= nil then
		_result = _result.humanIdx
	end
	local _condition = _result
	if _condition == nil then
		_condition = -1
	end
	local myIdx = _condition
	local myTeam = if myIdx >= 0 then math.floor(myIdx / 5) else 0
	for i = 0, #s.players - 1 do
		local p = s.players[i + 1]
		local existing = views[i + 1]
		if existing == nil or existing.charIdx ~= p.charIdx then
			local _result_1 = existing
			if _result_1 ~= nil then
				_result_1:destroy()
			end
			views[i + 1] = PlayerView.new(dynamic, p.charIdx, i == myIdx, p.team == myTeam)
		end
	end
end
local function clockText(s)
	if s.phase == "pk" then
		return "PK 大戰"
	end
	local secs = math.ceil(s.clockTicks / TICK_HZ)
	local half = if s.half == 1 then "上半場" else "下半場"
	return `{half}  {string.format("%02d:%02d", math.floor(secs / 60), secs % 60)}`
end
local function render(s)
	ensureViews(s)
	for i = 0, #s.players - 1 do
		local p = s.players[i + 1]
		local _result = views[i + 1]
		if _result ~= nil then
			_result:update(p.x, p.y, p.z, p.facing, p.down, p.rampage, p.stamina, p.maxStamina)
		end
	end
	local bx = s.ball.x * STUDS_PER_PX
	local bz = s.ball.y * STUDS_PER_PX
	local by = BALL_DIAMETER / 2 + s.ball.z * STUDS_PER_PX
	ball.Position = Vector3.new(bx, by, bz)
	local shadowD = BALL_DIAMETER * math.max(0.4, 1 - s.ball.z * STUDS_PER_PX * 0.08)
	ballShadow.Size = Vector3.new(0.05, shadowD, shadowD)
	local _cFrame = CFrame.new(bx, 0.07, bz)
	local _arg0 = CFrame.Angles(0, 0, math.rad(90))
	ballShadow.CFrame = _cFrame * _arg0
	if teams ~= nil and (s.score[1] ~= lastScore[1] or s.score[2] ~= lastScore[2]) then
		lastScore = { s.score[1], s.score[2] }
		hud:setScore(teams, s.score)
	end
	hud:setClock(clockText(s))
	if s.phase ~= lastPhase then
		if s.phase == "kickoff" then
			hud:toast("開球", 1.2)
		elseif s.phase == "pk" then
			hud:toast("PK 大戰（自動進行）", 2.5)
		end
		lastPhase = s.phase
	end
	local _result = lobby
	if _result ~= nil then
		_result = _result.humanIdx
	end
	local _condition = _result
	if _condition == nil then
		_condition = -1
	end
	local myIdx = _condition
	if myIdx >= 0 then
		controls:setSpecialCooldown(s.players[myIdx + 1].specialCooldown / TICK_HZ)
	end
end
local function updateCamera(camera, dt, s)
	local aspect = camera.ViewportSize.X / math.max(1, camera.ViewportSize.Y)
	camera.FieldOfView = cameraFov(VISIBLE_STUDS, CAM_DIST, aspect)
	local target = if s ~= nil then cameraTargetX(s.ball.x * STUDS_PER_PX, VISIBLE_STUDS / 2, FIELD_STUDS_W, CAM_MARGIN) else FIELD_STUDS_W / 2
	camX = smooth(camX, target, dt, CAM_FOLLOW_RATE)
	local look = Vector3.new(camX, 0, FIELD_STUDS_D / 2 + 1)
	local _vector3 = Vector3.new(0, math.sin(CAM_PITCH) * CAM_DIST, math.cos(CAM_PITCH) * CAM_DIST)
	local pos = look + _vector3
	camera.CFrame = CFrame.lookAt(pos, look)
end
local camera = Workspace.CurrentCamera
while camera == nil do
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
	camera = Workspace.CurrentCamera
end
local cam = camera
RunService:BindToRenderStep("SanguoCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	cam.CameraType = Enum.CameraType.Scriptable
	local s = snapshots:sample(os.clock(), RENDER_DELAY)
	if s ~= nil then
		latest = s
		render(s)
	end
	updateCamera(cam, dt, s)
end)
RunService.Heartbeat:Connect(function()
	return controls:step(os.clock())
end)
-- Everything is connected: ask the server for the lobby state.
readyRemote:FireServer()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">theme</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _data = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "data")
local CHARACTERS = _data.CHARACTERS
local COUNTRY_INFO = _data.COUNTRY_INFO
local function colorFromHex(c)
	return Color3.fromRGB(math.floor(c / 65536) % 256, math.floor(c / 256) % 256, c % 256)
end
local function countryColor(country)
	return colorFromHex(COUNTRY_INFO[country].color)
end
local function countryName(country)
	return COUNTRY_INFO[country].name
end
local function hexString(c)
	return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end
local function characterOf(charIdx)
	return CHARACTERS[charIdx + 1]
end
local FONT = Enum.Font.SourceSansBold
return {
	colorFromHex = colorFromHex,
	countryColor = countryColor,
	countryName = countryName,
	hexString = hexString,
	characterOf = characterOf,
	FONT = FONT,
}
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="60">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
