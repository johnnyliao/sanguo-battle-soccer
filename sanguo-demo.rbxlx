        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">camera</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
-- Camera math (pure).
--* Vertical FOV in degrees so that `visibleWidth` studs are visible across the screen at `dist` studs from the camera. 
local function cameraFov(visibleWidth, dist, aspect)
	local halfH = math.atan(visibleWidth / 2 / dist)
	local halfV = math.atan(math.tan(halfH) / aspect)
	return math.min(70, math.max(20, math.deg(halfV * 2)))
end
--* Camera centre X: follows the ball, but the view edge never goes more than `margin` studs past the field ends. 
local function cameraTargetX(ballX, halfVisible, fieldW, margin)
	local lo = halfVisible - margin
	local hi = fieldW + margin - halfVisible
	if lo >= hi then
		return fieldW / 2
	end
	return math.min(hi, math.max(lo, ballX))
end
--* Frame-rate independent exponential smoothing toward a target. 
local function smooth(current, target, dt, rate)
	return current + (target - current) * (1 - math.exp(-rate * dt))
end
return {
	cameraFov = cameraFov,
	cameraTargetX = cameraTargetX,
	smooth = smooth,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">events</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
-- Sim events forwarded to clients for visuals (pure). Coordinates stay in sim px; the client converts to studs.
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local FEAR_RADIUS = _constants.FEAR_RADIUS
local GUST_RADIUS = _constants.GUST_RADIUS
--* Picks the events that matter for visuals out of state.events (the events of the tick that was just stepped). 
local function toWireEvents(state)
	local out = {}
	local tick = state.tick
	local nameOf = function(idx)
		return if idx >= 0 and idx < #state.players then state.players[idx + 1].name else ""
	end
	for _, e in state.events do
		local _exp = e.type
		repeat
			if _exp == "goal" then
				local _arg0 = {
					t = "goal",
					tick = tick,
					team = e.team,
					p = e.scorerIdx,
					n = nameOf(e.scorerIdx),
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "special" then
				local _arg0 = {
					t = "special",
					tick = tick,
					p = e.playerIdx,
					m = nameOf(e.playerIdx),
					n = e.name,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "down" then
				local _arg0 = {
					t = "down",
					tick = tick,
					p = e.playerIdx,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "hit" then
				local _arg0 = {
					t = "hit",
					tick = tick,
					p = e.attackerIdx,
					v = { e.victimIdx },
					n = e.kind,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "iceStart" then
				local _arg0 = {
					t = "iceStart",
					tick = tick,
					p = e.playerIdx,
					id = e.fieldId,
					x = e.x,
					y = e.y,
					r = e.radius,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "iceEnd" then
				local _arg0 = {
					t = "iceEnd",
					tick = tick,
					id = e.fieldId,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "portalStart" then
				local _arg0 = {
					t = "portalStart",
					tick = tick,
					p = e.playerIdx,
					id = e.portalId,
					x = e.x,
					y = e.y,
					r = e.radius,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "portalEnd" then
				local _arg0 = {
					t = "portalEnd",
					tick = tick,
					id = e.portalId,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "eastwindStart" then
				local _arg0 = {
					t = "eastwindStart",
					tick = tick,
					p = e.playerIdx,
					id = e.windId,
					x = e.x,
					y = e.y,
					r = e.radius,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "eastwindEnd" then
				local _arg0 = {
					t = "eastwindEnd",
					tick = tick,
					id = e.windId,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "arrowshipStart" then
				local _arg0 = {
					t = "arrowshipStart",
					tick = tick,
					p = e.playerIdx,
					id = e.shipId,
					x = e.x,
					y = e.y,
					d = e.dir,
					w = e.halfSpan,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "arrowshipEnd" then
				local _arg0 = {
					t = "arrowshipEnd",
					tick = tick,
					id = e.shipId,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "gustBlow" then
				local _arg0 = {
					t = "gustBlow",
					tick = tick,
					id = e.gustId,
					x = e.x,
					y = e.y,
					r = GUST_RADIUS,
					v = e.victimIdxs,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "roar" then
				local _arg0 = {
					t = "roar",
					tick = tick,
					p = e.playerIdx,
					x = e.x,
					y = e.y,
					r = e.radius,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "fear" then
				local caster = state.players[e.playerIdx + 1]
				local _arg0 = {
					t = "fear",
					tick = tick,
					p = e.playerIdx,
					x = caster.x,
					y = caster.y,
					r = FEAR_RADIUS,
					v = e.victimIdxs,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "whistle" then
				local _arg0 = {
					t = "whistle",
					tick = tick,
					n = e.reason,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "pkStart" then
				local _arg0 = {
					t = "pkStart",
					tick = tick,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "pkResult" then
				local _arg0 = {
					t = "pkResult",
					tick = tick,
					team = e.team,
					n = e.outcome,
				}
				table.insert(out, _arg0)
				break
			end
			if _exp == "matchEnd" then
				local _arg0 = {
					t = "matchEnd",
					tick = tick,
				}
				table.insert(out, _arg0)
				break
			end
			break
		until true
	end
	return out
end
return {
	toWireEvents = toWireEvents,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">input</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
-- Input handling shared by client and server (pure, no Roblox services).
local EMPTY_INPUT = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "types").EMPTY_INPUT
local function isAxis(v)
	local _v = v
	local _condition = type(_v) == "number"
	if _condition then
		_condition = (v == -1 or v == 0 or v == 1)
	end
	return _condition
end
--* Validates an untrusted remote payload. Returns a clean InputFrame, or undefined if any field has a wrong type or range. 
local function sanitizeInput(raw)
	local _raw = raw
	if not (type(_raw) == "table") then
		return nil
	end
	local t = raw
	local moveX = t.moveX
	local moveY = t.moveY
	local dash = t.dash
	local j = t.j
	local k = t.k
	local l = t.l
	if not isAxis(moveX) or not isAxis(moveY) then
		return nil
	end
	if not (type(dash) == "boolean") or not (type(j) == "boolean") or not (type(k) == "boolean") or not (type(l) == "boolean") then
		return nil
	end
	return {
		moveX = if moveX == 0 then 0 else moveX,
		moveY = if moveY == 0 then 0 else moveY,
		dash = dash,
		j = j,
		k = k,
		l = l,
	}
end
local function inputsEqual(a, b)
	return a.moveX == b.moveX and a.moveY == b.moveY and a.dash == b.dash and a.j == b.j and a.k == b.k and a.l == b.l
end
--[[
	*
	 * Server side: keeps the latest frame per slot and latches button presses (j, k, l) so a press and release that both
	 * arrive between two sim ticks still reaches the sim as one pressed tick. Mirrors the web game's ButtonLatch.
	 
]]
local InputLatch
do
	InputLatch = setmetatable({}, {
		__tostring = function()
			return "InputLatch"
		end,
	})
	InputLatch.__index = InputLatch
	function InputLatch.new(...)
		local self = setmetatable({}, InputLatch)
		return self:constructor(...) or self
	end
	function InputLatch:constructor()
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		self.latest = _object
		self.pressedJ = false
		self.pressedK = false
		self.pressedL = false
	end
	function InputLatch:receive(f)
		if f.j and not self.latest.j then
			self.pressedJ = true
		end
		if f.k and not self.latest.k then
			self.pressedK = true
		end
		if f.l and not self.latest.l then
			self.pressedL = true
		end
		self.latest = f
	end
	function InputLatch:consume()
		local _object = table.clone(self.latest)
		setmetatable(_object, nil)
		_object.j = self.latest.j or self.pressedJ
		_object.k = self.latest.k or self.pressedK
		_object.l = self.latest.l or self.pressedL
		local f = _object
		self.pressedJ = false
		self.pressedK = false
		self.pressedL = false
		return f
	end
	function InputLatch:reset()
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		self.latest = _object
		self.pressedJ = false
		self.pressedK = false
		self.pressedL = false
	end
end
--* Client side: keeps a quick press alive until the next sample. 
local ButtonLatch
do
	ButtonLatch = setmetatable({}, {
		__tostring = function()
			return "ButtonLatch"
		end,
	})
	ButtonLatch.__index = ButtonLatch
	function ButtonLatch.new(...)
		local self = setmetatable({}, ButtonLatch)
		return self:constructor(...) or self
	end
	function ButtonLatch:constructor()
		self.latched = {}
	end
	function ButtonLatch:press(key)
		local _latched = self.latched
		local _key = key
		_latched[_key] = true
	end
	function ButtonLatch:consume(key, held)
		local _latched = self.latched
		local _key = key
		-- ▼ Set.delete ▼
		local _valueExisted = _latched[_key] ~= nil
		_latched[_key] = nil
		-- ▲ Set.delete ▲
		local wasPressed = _valueExisted
		return held or wasPressed
	end
	function ButtonLatch:clear()
		table.clear(self.latched)
	end
end
--* Double-tap window in seconds (press, release, press again within it). The web game uses 15 ticks at 60 Hz. 
local DOUBLE_TAP_SEC = 0.25
local DIRS = { "left", "right", "up", "down" }
--* Double-tap dash detector (port of the web game's DashDetector, time-based). Call update() once per sample. 
local DashDetector
do
	DashDetector = setmetatable({}, {
		__tostring = function()
			return "DashDetector"
		end,
	})
	DashDetector.__index = DashDetector
	function DashDetector.new(...)
		local self = setmetatable({}, DashDetector)
		return self:constructor(...) or self
	end
	function DashDetector:constructor()
		self.held = {
			left = false,
			right = false,
			up = false,
			down = false,
		}
		self.lastRelease = {
			left = -math.huge,
			right = -math.huge,
			up = -math.huge,
			down = -math.huge,
		}
		self.dashDir = nil
	end
	function DashDetector:update(moveX, moveY, now)
		local pressed = {
			left = moveX < 0,
			right = moveX > 0,
			up = moveY < 0,
			down = moveY > 0,
		}
		for _, dir in DIRS do
			if pressed[dir] and not self.held[dir] then
				if now - self.lastRelease[dir] <= DOUBLE_TAP_SEC then
					self.dashDir = dir
				end
			elseif not pressed[dir] and self.held[dir] then
				self.lastRelease[dir] = now
				if self.dashDir == dir then
					self.dashDir = nil
				end
			end
			self.held[dir] = pressed[dir]
		end
		return self.dashDir ~= nil
	end
end
--* Raw held state plus the double-tap dash result to an InputFrame. 
local function buildInputFrame(raw, dash)
	local moveX = if raw.left == raw.right then 0 elseif raw.left then -1 else 1
	local moveY = if raw.up == raw.down then 0 elseif raw.up then -1 else 1
	return {
		moveX = moveX,
		moveY = moveY,
		dash = dash or raw.dashButton,
		j = raw.j,
		k = raw.k,
		l = raw.l,
	}
end
return {
	sanitizeInput = sanitizeInput,
	inputsEqual = inputsEqual,
	buildInputFrame = buildInputFrame,
	InputLatch = InputLatch,
	ButtonLatch = ButtonLatch,
	DashDetector = DashDetector,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">interp</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
-- Snapshot interpolation buffer (pure). Renders slightly behind the newest snapshot using the server tick timeline.
--* Moves larger than this between two snapshots (px) are teleports (kickoff reset, portal), not interpolated. 
local TELEPORT_PX = 150
local MAX_KEPT = 40
--* A tick this far behind the newest means the server restarted its match: start a new timeline. 
local RESTART_TICKS = 120
local function lerp(a, b, t)
	return a + (b - a) * t
end
local function lerpAngle(a, b, t)
	local d = (b - a) % (2 * math.pi)
	if d > math.pi then
		d -= 2 * math.pi
	end
	if d < -math.pi then
		d += 2 * math.pi
	end
	return a + d * t
end
local function lerpSnapshot(a, b, t)
	local nearer = if t < 0.5 then a else b
	local _exp = a.players
	-- ▼ ReadonlyArray.map ▼
	local _newValue = table.create(#_exp)
	local _callback = function(pa, i)
		local pb = b.players[i + 1]
		local base = if t < 0.5 then pa else pb
		local dx = pb.x - pa.x
		local dy = pb.y - pa.y
		if dx * dx + dy * dy > TELEPORT_PX * TELEPORT_PX then
			return base
		end
		local _object = table.clone(base)
		setmetatable(_object, nil)
		_object.x = lerp(pa.x, pb.x, t)
		_object.y = lerp(pa.y, pb.y, t)
		_object.z = lerp(pa.z, pb.z, t)
		_object.facing = lerpAngle(pa.facing, pb.facing, t)
		_object.stamina = lerp(pa.stamina, pb.stamina, t)
		return _object
	end
	for _k, _v in _exp do
		_newValue[_k] = _callback(_v, _k - 1, _exp)
	end
	-- ▲ ReadonlyArray.map ▲
	local players = _newValue
	local bdx = b.ball.x - a.ball.x
	local bdy = b.ball.y - a.ball.y
	local ball = if bdx * bdx + bdy * bdy > TELEPORT_PX * TELEPORT_PX then nearer.ball else {
		x = lerp(a.ball.x, b.ball.x, t),
		y = lerp(a.ball.y, b.ball.y, t),
		z = lerp(a.ball.z, b.ball.z, t),
		ownerIdx = nearer.ball.ownerIdx,
	}
	return {
		tick = nearer.tick,
		phase = nearer.phase,
		half = nearer.half,
		clockTicks = nearer.clockTicks,
		score = nearer.score,
		ball = ball,
		players = players,
	}
end
local SnapshotBuffer
do
	SnapshotBuffer = setmetatable({}, {
		__tostring = function()
			return "SnapshotBuffer"
		end,
	})
	SnapshotBuffer.__index = SnapshotBuffer
	function SnapshotBuffer.new(...)
		local self = setmetatable({}, SnapshotBuffer)
		return self:constructor(...) or self
	end
	function SnapshotBuffer:constructor()
		self.snaps = {}
		self.offset = nil
	end
	function SnapshotBuffer:push(recvTime, snap)
		local last = self.snaps[#self.snaps]
		if last ~= nil then
			if snap.tick <= last.tick and last.tick - snap.tick < RESTART_TICKS then
				return false
			end
			if snap.tick < last.tick then
				self:reset()
			end
		end
		local off = recvTime - snap.tick / 60
		self.offset = if self.offset == nil or off < self.offset then off else self.offset + (off - self.offset) * 0.02
		local _snaps = self.snaps
		local _snap = snap
		table.insert(_snaps, _snap)
		if #self.snaps > MAX_KEPT then
			table.remove(self.snaps, 1)
		end
		return true
	end
	function SnapshotBuffer:reset()
		self.snaps = {}
		self.offset = nil
	end
	function SnapshotBuffer:sample(now, delay)
		local n = #self.snaps
		if n == 0 or self.offset == nil then
			return nil
		end
		local serverTime = now - self.offset - delay
		local first = self.snaps[1]
		if n == 1 or serverTime <= first.tick / 60 then
			return first
		end
		local last = self.snaps[n]
		if serverTime >= last.tick / 60 then
			return last
		end
		do
			local i = n - 1
			local _shouldIncrement = false
			while true do
				if _shouldIncrement then
					i -= 1
				else
					_shouldIncrement = true
				end
				if not (i > 0) then
					break
				end
				local a = self.snaps[i]
				local b = self.snaps[i + 1]
				local ta = a.tick / 60
				local tb = b.tick / 60
				if serverTime >= ta and serverTime <= tb then
					return lerpSnapshot(a, b, if tb > ta then (serverTime - ta) / (tb - ta) else 1)
				end
			end
		end
		return last
	end
end
return {
	lerpSnapshot = lerpSnapshot,
	SnapshotBuffer = SnapshotBuffer,
}
]]></string>
          </Properties>
