local function endTigerWindows(state)
	for _, p in state.players do
		if p.tigerTicks == 0 then
			continue
		end
		p.tigerTicks = 0
		local _events = state.events
		local _arg0 = {
			type = "tigerEnd",
			playerIdx = p.idx,
		}
		table.insert(_events, _arg0)
	end
	state.ball.tiger = nil
end
--[[
	*
	 * Cao Cao's slash (霸刀連斬): an instant cast, with or without the ball. He keeps full control while the buff runs (see
