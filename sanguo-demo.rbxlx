		if b.special ~= nil then
			b.special = nil
			local _exp = state.events
			table.insert(_exp, {
				type = "specialEnd",
			})
		end
		b.tiger = nil
		s.arrows += 1
		local _events = state.events
		local _arg0 = {
			type = "arrowshipBlock",
			shipId = s.id,
			arrows = s.arrows,
			kind = "ball",
			x = s.x,
			y = b.y,
		}
		table.insert(_events, _arg0)
		return nil
	end
end
