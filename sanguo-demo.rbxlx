            <string name="Name">pkAi</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _sim = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim")
local EMPTY_INPUT = _sim.EMPTY_INPUT
local pkMeterValue = _sim.pkMeterValue
local nextRandom = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai", "random").nextRandom
--* Per-kick choices, made once at the first aim tick of each kick (kicks taken so far identify the kick). 
local function createPkAIState()
	return {
		kickNo = -1,
		waitTicks = 0,
		aimCol = 1,
		aimHigh = false,
		targetPower = 1,
		guessCol = 1,
		guessHigh = false,
	}
end
local WAIT_MIN = 30
local WAIT_SPAN = 31
local POWER_BASE = 0.7
local POWER_SPAN = 0.2
local POWER_NOISE_PER_TECH = 0.02
local SHOOT_HIGH_CHANCE = 0.4
local KEEPER_CENTER_CHANCE = 0.45
local KEEPER_LEFT_CUT = 0.725
local KEEPER_HIGH_CHANCE = 0.35
--* Input frames for a penalty shootout tick. Only the shooter and keeper of the current kick act. 
local chooseKick, shooterFrame, keeperFrame
local function computePkAIInputs(state, ai, humanMask)
	local _exp = state.players
	-- ▼ ReadonlyArray.map ▼
	local _newValue = table.create(#_exp)
	local _callback = function()
		local _object = table.clone(EMPTY_INPUT)
		setmetatable(_object, nil)
		return _object
	end
	for _k, _v in _exp do
		_newValue[_k] = _callback(_v, _k - 1, _exp)
	end
	-- ▲ ReadonlyArray.map ▲
	local frames = _newValue
	local pk = state.match.pk
	if pk == nil or pk.stage ~= "aim" then
		return frames
	end
	local kickNo = #pk.kicks[1] + #pk.kicks[2]
	if ai.pk.kickNo ~= kickNo then
		chooseKick(state, ai, pk, kickNo)
	end
	local shooter = state.players[pk.shooterIdx + 1]
	local keeper = state.players[pk.keeperIdx + 1]
	if not humanMask[shooter.idx + 1] then
		frames[shooter.idx + 1] = shooterFrame(pk, ai)
	end
	if not humanMask[keeper.idx + 1] then
		frames[keeper.idx + 1] = keeperFrame(ai)
	end
	return frames
end
local clamp
function chooseKick(state, ai, pk, kickNo)
	local shooter = state.players[pk.shooterIdx + 1]
	local s = ai.pk
	s.kickNo = kickNo
	s.aimCol = math.floor(nextRandom(ai) * 3)
	s.aimHigh = nextRandom(ai) < SHOOT_HIGH_CHANCE
	local base = POWER_BASE + nextRandom(ai) * POWER_SPAN
	local noise = (nextRandom(ai) * 2 - 1) * (10 - shooter.stats.technique) * POWER_NOISE_PER_TECH
	s.targetPower = clamp(base + noise, 0, 1)
	s.waitTicks = WAIT_MIN + math.floor(nextRandom(ai) * WAIT_SPAN)
	local r = nextRandom(ai)
	s.guessCol = if r < KEEPER_CENTER_CHANCE then 1 elseif r < KEEPER_LEFT_CUT then 0 else 2
	s.guessHigh = nextRandom(ai) < KEEPER_HIGH_CHANCE
end
--* Waits, presses J, holds the aim, and releases when the meter reaches the target. 
function shooterFrame(pk, ai)
	local s = ai.pk
	local _object = table.clone(EMPTY_INPUT)
	setmetatable(_object, nil)
	_object.moveY = (s.aimCol - 1)
	_object.k = s.aimHigh
	local aim = _object
	if pk.meterTicks < 0 then
		if s.waitTicks > 0 then
			s.waitTicks -= 1
			return aim
		end
		local _object_1 = table.clone(aim)
		setmetatable(_object_1, nil)
		_object_1.j = true
		return _object_1
	end
	local release = pkMeterValue(pk.meterTicks) >= s.targetPower
	local _object_1 = table.clone(aim)
	setmetatable(_object_1, nil)
	_object_1.j = not release
	return _object_1
end
function keeperFrame(ai)
	local s = ai.pk
	local _object = table.clone(EMPTY_INPUT)
	setmetatable(_object, nil)
	_object.moveY = (s.guessCol - 1)
	_object.k = s.guessHigh
	return _object
end
function clamp(v, lo, hi)
	return math.min(hi, math.max(lo, v))
end
return {
	createPkAIState = createPkAIState,
	computePkAIInputs = computePkAIInputs,
}
]]></string>
