end
--[[
	*
	 * One tick for every blade wave in play: it flies on, hits the first opponent whose body circle it touches (skipping
	 * invincible, down and recovering players), and ends on that hit or when it has flown SLASH_WAVE_RANGE.
	 
]]
local advanceBladeWave
local function updateBladeWaves(state)
	local _exp = state.waves
	-- ▼ ReadonlyArray.filter ▼
	local _newValue = {}
	local _callback = function(w)
		return advanceBladeWave(state, w)
	end
	local _length = 0
	for _k, _v in _exp do
		if _callback(_v, _k - 1, _exp) == true then
			_length += 1
			_newValue[_length] = _v
		end
	end
	-- ▲ ReadonlyArray.filter ▲
	state.waves = _newValue
end
--* Moves one blade wave. Returns false on the tick it ends (its end event is already pushed). 
local slashVictim
function advanceBladeWave(state, w)
	local step = K.SLASH_WAVE_SPEED * K.DT
	w.x += w.dirX * step
	w.y += w.dirY * step
	w.travelled += step
	local _exp = state.players
	-- ▼ ReadonlyArray.find ▼
	local _callback = function(v)
		return v.team ~= w.team and v.action ~= "down" and v.action ~= "recover" and not isInvincible(v) and distance(w.x, w.y, v.x, v.y) < v.radius
	end
	local _result
	for _i, _v in _exp do
		if _callback(_v, _i - 1, _exp) == true then
			_result = _v
			break
		end
	end
	-- ▲ ReadonlyArray.find ▲
	local victim = _result
	if victim ~= nil then
		slashVictim(state, state.players[w.ownerIdx + 1], victim)
		local _events = state.events
		local _arg0 = {
			type = "slashWaveEnd",
			waveId = w.id,
			x = w.x,
			y = w.y,
			hitIdx = victim.idx,
		}
		table.insert(_events, _arg0)
		return false
	end
	if w.travelled >= K.SLASH_WAVE_RANGE then
		local _events = state.events
		local _arg0 = {
			type = "slashWaveEnd",
			waveId = w.id,
			x = w.x,
			y = w.y,
			hitIdx = -1,
		}
		table.insert(_events, _arg0)
		return false
	end
	return true
end
--[[
	*
	 * One blade wave hit: cancels a beam channel, loses SLASH_DAMAGE_RATIO of maxStamina and is stunned for SLASH_HITSTUN_TICKS.
	 * Going to zero stamina knocks him down instead. He keeps any ball he holds. The caster restores SLASH_HEAL_RATIO of his own
	 * maxStamina, capped at maxStamina.
	 
]]
function slashVictim(state, p, v)
	reportCastCancel(state, v)
	v.chargeTicks = 0
	local cost = K.SLASH_DAMAGE_RATIO * v.maxStamina
	v.stamina = math.max(0, v.stamina - cost)
	local down = false
	if v.stamina <= 0 then
		setDown(v, K.DOWN_TICKS_EXHAUSTED)
		down = true
	else
		v.action = "hitstun"
		v.actionTimer = K.SLASH_HITSTUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = p.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = v.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
	local before = p.stamina
	p.stamina = math.min(p.maxStamina, p.stamina + K.SLASH_HEAL_RATIO * p.maxStamina)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "slashHeal",
		playerIdx = p.idx,
		amount = p.stamina - before,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * Ends every slash buff (emitting slashEnd) and clears every blade wave (each reported as a miss) when the phase leaves
	 * play. Called from step after the match phase is updated.
	 
