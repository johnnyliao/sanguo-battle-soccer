--[[
	*
	 * Enemies cannot cross a ship line within its span: each enemy whose centre is inside the span is held on the field side,
	 * DRIBBLE_OFFSET beyond its body so a carried ball stays on the field side too. Runs every tick after the player collisions.
	 
]]
local function clampArrowshipBarrier(state)
	for _, s in state.arrowships do
		for _1, v in state.players do
			if v.team == s.team or math.abs(v.y - s.y) > K.ARROWSHIP_HALF_SPAN then
				continue
			end
			local minForward = v.radius + K.DRIBBLE_OFFSET
			if s.dir * (v.x - s.x) >= minForward then
				continue
			end
			v.x = s.x + s.dir * minForward
			if v.vx * s.dir < 0 then
				v.vx = 0
			end
		end
	end
end
--[[
	*
	 * A ball whose path this tick crossed a ship line (from prevX on the field side to the goal side), inside the span and at or
	 * below ARROWSHIP_BLOCK_MAX_Z, is stopped just on the field side. Its goal-ward velocity is reversed and damped, the other
	 * components are damped, and it becomes a loose ball (a special shot or tiger ball ends). Any owner state and team counts.
	 * A ball held in Xu Chu's mouth does not move and is skipped. Runs after updateBall.
	 
]]
local function blockArrowshipBall(state, prevX)
	local b = state.ball
	local _result = b.tiger
	if _result ~= nil then
		_result = _result.phase
	end
	local _condition = _result == "hold"
	if not _condition then
		_condition = b.z > K.ARROWSHIP_BLOCK_MAX_Z
	end
	if _condition then
		return nil
	end
	for _, s in state.arrowships do
		if math.abs(b.y - s.y) > K.ARROWSHIP_HALF_SPAN then
			continue
		end
		local wasField = s.dir * (prevX - s.x) >= 0
		local nowGoal = s.dir * (b.x - s.x) < 0
		if not wasField or not nowGoal then
			continue
		end
		b.x = s.x + s.dir * (K.BALL_RADIUS + 1)
		b.vx = s.dir * math.abs(b.vx) * K.ARROWSHIP_BALL_DAMP
		b.vy *= K.ARROWSHIP_BALL_DAMP
		b.vz *= K.ARROWSHIP_BALL_DAMP
