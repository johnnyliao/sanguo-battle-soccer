local _array_1 = getTeam("shu")
local _Length = #_array_1
table.move(_array_1, 1, _Length, _length + 1, _array)
_length += _Length
local _array_2 = getTeam("wei")
local _Length_1 = #_array_2
table.move(_array_2, 1, _Length_1, _length + 1, _array)
_length += _Length_1
local _array_3 = getTeam("wu")
table.move(_array_3, 1, #_array_3, _length + 1, _array)
local CHARACTERS = _array
local COUNTRY_INFO = {
	shu = {
		name = "蜀",
		color = 0x2fa84f,
	},
	wei = {
		name = "魏",
		color = 0x2f6fd8,
	},
	wu = {
		name = "吳",
		color = 0xd83a2f,
	},
}
local SIZE_PARAMS = {
	S = {
		radius = 7,
		mass = 0.8,
	},
	M = {
		radius = 9,
		mass = 1.0,
	},
	L = {
		radius = 12,
		mass = 1.4,
	},
}
return {
	normalizeTeam = normalizeTeam,
	getTeam = getTeam,
	RAW_CHARACTERS = RAW_CHARACTERS,
	CHARACTERS = CHARACTERS,
	COUNTRY_INFO = COUNTRY_INFO,
	SIZE_PARAMS = SIZE_PARAMS,
}
]]></string>
          </Properties>
