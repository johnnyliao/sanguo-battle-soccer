  <Item class="ServerStorage" referent="47">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="48">
      <Properties>
        <string name="Name">Tools</string>
      </Properties>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">headless</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _ai = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai")
local computeAIInputs = _ai.computeAIInputs
local createAIState = _ai.createAIState
local _data = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "data")
local getTeam = _data.getTeam
local SIZE_PARAMS = _data.SIZE_PARAMS
local _sim = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim")
local createInitialState = _sim.createInitialState
local step = _sim.step
--* Fixed scenario. The reference run in the web project must use the same values. 
local SEED = 12345
local HALF_SECONDS = 120
local TICKS = 14400
--* C-style %.16e text for a double (0 printed as "0" so -0 and 0 match). 
local function num(x)
	if x == 0 then
		return "0"
	end
	return string.format("%.16e", x)
end
--* One line per tick with every value the sim changes, all as exact float text. 
local function line(state, aiRng)
	local parts = { num(state.tick), num(state.rng), num(aiRng), state.match.phase, num(state.match.phaseTimer), num(state.match.clockTicks), num(state.match.score[1]), num(state.match.score[2]), num(state.ball.x), num(state.ball.y), num(state.ball.z), num(state.ball.vx), num(state.ball.vy), num(state.ball.vz), num(state.ball.ownerIdx) }
	for _, p in state.players do
		local _arg0 = num(p.x)
		local _arg1 = num(p.y)
		local _arg2 = num(p.z)
		local _arg3 = num(p.vx)
		local _arg4 = num(p.vy)
		local _arg5 = num(p.stamina)
		local _action = p.action
		local _arg7 = num(p.actionTimer)
		-- ▼ Array.push ▼
		table.insert(parts, _arg0)
		table.insert(parts, _arg1)
		table.insert(parts, _arg2)
		table.insert(parts, _arg3)
		table.insert(parts, _arg4)
		table.insert(parts, _arg5)
		table.insert(parts, _action)
		table.insert(parts, _arg7)
		-- ▲ Array.push ▲
	end
	return table.concat(parts, " ")
end
local state = createInitialState({
	seed = SEED,
	teams = { getTeam("shu"), getTeam("wu") },
	halfSeconds = HALF_SECONDS,
}, SIZE_PARAMS)
local ai = createAIState(bit32.rshift((bit32.bxor(SEED, 0x5bd1e995)), 0))
local _exp = state.players
-- ▼ ReadonlyArray.map ▼
local _newValue = table.create(#_exp)
local _callback = function()
	return false
end
for _k, _v in _exp do
	_newValue[_k] = _callback(_v, _k - 1, _exp)
end
-- ▲ ReadonlyArray.map ▲
local humanMask = _newValue
local eventCounts = {}
print(line(state, ai.rng))
for i = 0, TICKS - 1 do
	local inputs = computeAIInputs(state, ai, humanMask)
	step(state, inputs)
	for _, e in state.events do
		local _exp_1 = e.type
		local _type = e.type
		local _condition = eventCounts[_type]
		if _condition == nil then
			_condition = 0
		end
		eventCounts[_exp_1] = _condition + 1
	end
	print(line(state, ai.rng))
end
local kinds = {}
for k in eventCounts do
	table.insert(kinds, k)
end
table.sort(kinds, function(a, b)
	return a < b
end)
print("SUMMARY phase=" .. state.match.phase .. " half=" .. num(state.match.half) .. " score=" .. num(state.match.score[1]) .. "-" .. num(state.match.score[2]) .. " tick=" .. num(state.tick))
for _, k in kinds do
	local _exp_1 = "EVENT " .. k .. " "
	local _condition = eventCounts[k]
	if _condition == nil then
		_condition = 0
	end
	print(_exp_1 .. num(_condition))
end
return nil
]]></string>
