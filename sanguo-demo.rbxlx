        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">matchSim</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
-- One running match: sim state + AI + human input latches (pure, no Roblox services). The server drives it once per tick.
local _ai = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "ai")
local computeAIInputs = _ai.computeAIInputs
local createAIState = _ai.createAIState
local _data = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "data")
local getTeam = _data.getTeam
local SIZE_PARAMS = _data.SIZE_PARAMS
local _sim = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim")
local autoPkOrders = _sim.autoPkOrders
local createInitialState = _sim.createInitialState
local step = _sim.step
local toWireEvents = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "events").toWireEvents
local _slots = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "slots")
local humanIdxForSlot = _slots.humanIdxForSlot
local humanMask = _slots.humanMask
local InputLatch = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "input").InputLatch
local MatchSim
do
	MatchSim = setmetatable({}, {
		__tostring = function()
			return "MatchSim"
		end,
	})
	MatchSim.__index = MatchSim
	function MatchSim.new(...)
		local self = setmetatable({}, MatchSim)
		return self:constructor(...) or self
	end
	function MatchSim:constructor(home, away, seed, halfSeconds)
		self.home = home
		self.away = away
		self.latches = { InputLatch.new(), InputLatch.new() }
		self.ended = false
		self.pkScore = nil
		self.state = createInitialState({
			seed = seed,
			teams = { getTeam(home), getTeam(away) },
			halfSeconds = halfSeconds,
		}, SIZE_PARAMS)
		self.ai = createAIState(bit32.rshift((bit32.bxor(seed, 0x5bd1e995)), 0))
	end
	function MatchSim:receive(slot, frame)
		if slot == 0 or slot == 1 then
			self.latches[slot + 1]:receive(frame)
		end
	end
	function MatchSim:resetSlot(slot)
		if slot == 0 or slot == 1 then
			self.latches[slot + 1]:reset()
		end
	end
	function MatchSim:step(slots)
		if self.ended then
			return {}
		end
		local state = self.state
		local pk = state.match.phase == "pk"
		-- The shootout has no human UI in this demo: the AI takes every kick for both teams.
		if pk and state.match.pk ~= nil and state.match.pk.stage == "order" then
			autoPkOrders(state, -1)
		end
		local mask = if pk then humanMask({ nil, nil }, #state.players) else humanMask(slots, #state.players)
		local inputs = computeAIInputs(state, self.ai, mask)
		if not pk then
			for s = 0, 1 do
				if slots[s + 1] ~= nil then
					inputs[humanIdxForSlot(s) + 1] = self.latches[s + 1]:consume()
				end
			end
		end
		step(state, inputs)
		local wire = toWireEvents(state)
		for _, e in state.events do
			if e.type == "matchEnd" then
				self.ended = true
				local p = state.match.pk
				if p ~= nil then
					self.pkScore = { p.score[1], p.score[2] }
				end
			end
		end
		return wire
	end
end
return {
	MatchSim = MatchSim,
}
]]></string>
          </Properties>
        </Item>
