	local victimIdxs = {}
	for _, v in state.players do
		if v.team == p.team or isInvincible(v) then
			continue
		end
		if distance(p.x, p.y, v.x, v.y) > K.FEAR_RADIUS then
			continue
		end
		fearVictim(state, p, v)
		local _idx = v.idx
		table.insert(victimIdxs, _idx)
	end
	local _events_1 = state.events
	local _arg0_1 = {
		type = "fear",
		playerIdx = p.idx,
		victimIdxs = victimIdxs,
	}
	table.insert(_events_1, _arg0_1)
end
--[[
	*
	 * One fear victim: cancels a beam channel, loses a share of stamina, drops the ball if holding it. Going to zero stamina
	 * knocks him down (a down player keeps his timer). Otherwise he is feared for FEAR_TICKS, unless he is already down or recovering.
	 
]]
function fearVictim(state, p, v)
	reportCastCancel(state, v)
	local dist = distance(p.x, p.y, v.x, v.y)
	local dirX = if dist > 0 then (v.x - p.x) / dist else p.facingX
	local dirY = if dist > 0 then (v.y - p.y) / dist else p.facingY
	v.chargeTicks = 0
	v.stamina = math.max(0, v.stamina - K.FEAR_STAMINA_RATIO * v.maxStamina)
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, p, v, dirX, dirY)
	end
	if v.stamina <= 0 then
		if v.action ~= "down" then
			setDown(v, K.DOWN_TICKS_EXHAUSTED)
			local _events = state.events
			local _arg0 = {
				type = "down",
				playerIdx = v.idx,
			}
			table.insert(_events, _arg0)
		end
		return nil
	end
	if v.action == "down" or v.action == "recover" then
		return nil
	end
	v.vx = 0
	v.vy = 0
	v.vz = 0
	v.action = "fear"
	v.actionTimer = K.FEAR_TICKS
end
--* Feared: standing still, ignoring input, until the fear timer ends and he returns to normal. 
function updateFear(p)
	p.vx = 0
	p.vy = 0
	p.actionTimer -= 1
	if p.actionTimer <= 0 then
		toNormal(p)
	end
end
--[[
