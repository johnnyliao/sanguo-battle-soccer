          <string name="Name">Match</string>
          <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local sanitizeInput = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "input").sanitizeInput
local MatchSim = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "matchSim").MatchSim
local _remotes = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "remotes")
local REMOTES_FOLDER = _remotes.REMOTES_FOLDER
local REMOTE_EVENTS = _remotes.REMOTE_EVENTS
local REMOTE_INPUT = _remotes.REMOTE_INPUT
local REMOTE_LOBBY = _remotes.REMOTE_LOBBY
local REMOTE_PICK = _remotes.REMOTE_PICK
local REMOTE_READY = _remotes.REMOTE_READY
local REMOTE_SNAP = _remotes.REMOTE_SNAP
local encodeSnapshot = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "snapshot").encodeSnapshot
local _slots = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "slots")
local assignSlot = _slots.assignSlot
local humanIdxForSlot = _slots.humanIdxForSlot
local isCountry = _slots.isCountry
local pickOpponent = _slots.pickOpponent
local releaseSlot = _slots.releaseSlot
local slotOf = _slots.slotOf
local FixedStepper = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "logic", "timestep").FixedStepper
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SNAP_INTERVAL = 1 / 30
local RESULT_SECONDS = 5
--* Server-side match service: lobby (country pick), 60 Hz sim loop, input intake, 30 Hz snapshots, event forwarding. 
local MatchService
do
	MatchService = setmetatable({}, {
		__tostring = function()
			return "MatchService"
		end,
	})
	MatchService.__index = MatchService
	function MatchService.new(...)
		local self = setmetatable({}, MatchService)
		return self:constructor(...) or self
	end
	function MatchService:constructor()
		self.rng = Random.new(os.time())
		self.stepper = FixedStepper.new(1 / 60, 5)
		self.slots = { nil, nil }
		self.joined = {}
		self.mode = "pick"
		self.countries = nil
		self.match = nil
		self.pending = {}
		self.snapAcc = 0
		self.resultLeft = 0
		Players.CharacterAutoLoads = false
		local folder = Instance.new("Folder")
		folder.Name = REMOTES_FOLDER
		local make = function(className, name)
			local r = Instance.new(className)
			r.Name = name
			r.Parent = folder
			return r
		end
		self.lobbyRemote = make("RemoteEvent", REMOTE_LOBBY)
		self.eventsRemote = make("RemoteEvent", REMOTE_EVENTS)
		self.snapRemote = make("UnreliableRemoteEvent", REMOTE_SNAP)
		local ready = make("RemoteEvent", REMOTE_READY)
		local pick = make("RemoteEvent", REMOTE_PICK)
		local input = make("RemoteEvent", REMOTE_INPUT)
		folder.Parent = ReplicatedStorage
		ready.OnServerEvent:Connect(function(player)
			return self:sendLobby(player)
		end)
		pick.OnServerEvent:Connect(function(player, ...)
			local args = { ... }
			return self:onPick(player, args[1])
		end)
		input.OnServerEvent:Connect(function(player, ...)
			local args = { ... }
			return self:onInput(player, args[1])
		end)
		Players.PlayerAdded:Connect(function(player)
			return self:onJoin(player)
		end)
		Players.PlayerRemoving:Connect(function(player)
			return self:onLeave(player)
		end)
		for _, player in Players:GetPlayers() do
			self:onJoin(player)
		end
		RunService.Heartbeat:Connect(function(dt)
			return self:onHeartbeat(dt)
		end)
	end
	function MatchService:onJoin(player)
		local _joined = self.joined
		local _player = player
		if table.find(_joined, _player) ~= nil then
			return nil
		end
		local _joined_1 = self.joined
		local _player_1 = player
		table.insert(_joined_1, _player_1)
		assignSlot(self.slots, player.UserId)
		self:sendLobby(player)
	end
	function MatchService:onLeave(player)
		local _joined = self.joined
		local _player = player
		local idx = (table.find(_joined, _player) or 0) - 1
		if idx >= 0 then
			table.remove(self.joined, idx + 1)
		end
		local slot = slotOf(self.slots, player.UserId)
		releaseSlot(self.slots, player.UserId)
		if slot >= 0 then
			local _result = self.match
			if _result ~= nil then
				_result:resetSlot(slot)
			end
		end
		if #self.joined == 0 then
			-- Nobody left: wait for the next first player to pick a country.
			self.mode = "pick"
			self.match = nil
			self.countries = nil
			self.pending = {}
			return nil
		end
		-- Spectators move into free slots, in join order.
		for _, p in self.joined do
			assignSlot(self.slots, p.UserId)
		end
		-- While picking, the picker must hold slot 0.
		if self.mode == "pick" and self.slots[1] == nil and self.slots[2] ~= nil then
			self.slots[1] = self.slots[2]
			self.slots[2] = nil
		end
		self:broadcastLobby()
	end
	function MatchService:onPick(player, country)
		if self.mode ~= "pick" or not isCountry(country) then
			return nil
		end
		if slotOf(self.slots, player.UserId) ~= 0 then
			return nil
		end
		self.countries = { country, pickOpponent(country, self.rng:NextNumber()) }
		self:beginMatch()
	end
	function MatchService:onInput(player, raw)
		local slot = slotOf(self.slots, player.UserId)
		if slot < 0 or self.mode ~= "play" or self.match == nil then
			return nil
		end
		local frame = sanitizeInput(raw)
		if frame ~= nil then
			self.match:receive(slot, frame)
		end
	end
	function MatchService:beginMatch()
		if self.countries == nil then
			return nil
		end
		self.match = MatchSim.new(self.countries[1], self.countries[2], self.rng:NextInteger(1, 2147483646))
		self.stepper:reset()
		self.pending = {}
		self.snapAcc = 0
		self.mode = "play"
		self:broadcastLobby()
	end
	function MatchService:lobbyMsg(player)
		local slot = slotOf(self.slots, player.UserId)
		local msg = {
			mode = self.mode,
			slot = slot,
			humanIdx = humanIdxForSlot(slot),
			canPick = self.mode == "pick" and slot == 0,
		}
		if self.countries ~= nil then
			msg.teams = { self.countries[1], self.countries[2] }
		end
		if self.mode == "result" and self.match ~= nil then
			local m = self.match.state.match
			msg.score = { m.score[1], m.score[2] }
			msg.pk = self.match.pkScore
			msg.restartSec = RESULT_SECONDS
		end
		return msg
	end
	function MatchService:sendLobby(player)
		self.lobbyRemote:FireClient(player, self:lobbyMsg(player))
	end
	function MatchService:broadcastLobby()
		for _, p in self.joined do
			self:sendLobby(p)
		end
	end
	function MatchService:onHeartbeat(dt)
		local match = self.match
		if match == nil or self.mode == "pick" then
			return nil
		end
		if self.mode == "play" then
			local steps = self.stepper:advance(dt)
			do
				local i = 0
				local _shouldIncrement = false
				while true do
					if _shouldIncrement then
						i += 1
					else
						_shouldIncrement = true
					end
					if not (i < steps) then
						break
					end
					for _, e in match:step(self.slots) do
						local _exp = self.pending
						table.insert(_exp, e)
					end
					if match.ended then
						self.mode = "result"
						self.resultLeft = RESULT_SECONDS
						self:broadcastLobby()
						break
					end
				end
			end
		else
			self.resultLeft -= dt
		end
		self.snapAcc += dt
		if self.snapAcc >= SNAP_INTERVAL then
			self.snapAcc = self.snapAcc % SNAP_INTERVAL
			self.snapRemote:FireAllClients(encodeSnapshot(match.state))
		end
		if #self.pending > 0 then
			self.eventsRemote:FireAllClients(self.pending)
			self.pending = {}
		end
		if self.mode == "result" and self.resultLeft <= 0 then
			self:beginMatch()
		end
	end
end
return {
	MatchService = MatchService,
}
]]></string>
