	if d < STOP_DIST then
		return NO_MOVE
	end
	return {
		moveX = if math.abs(dx) > 0.38 * d then sign(dx) else 0,
		moveY = if math.abs(dy) > 0.38 * d then sign(dy) else 0,
	}
end
function sign(v)
	return if v > 0 then 1 elseif v < 0 then -1 else 0
end
function clamp(v, lo, hi)
	return math.min(hi, math.max(lo, v))
end
function dist(ax, ay, bx, by)
	local dx = ax - bx
	local dy = ay - by
	return math.sqrt(dx * dx + dy * dy)
end
--* Dot product of the player's facing with the unit vector toward (x, y). 0 if the point is the player. 
function facingDot(p, x, y)
	local d = dist(p.x, p.y, x, y)
