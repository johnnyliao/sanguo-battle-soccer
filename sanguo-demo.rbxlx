	end
end
--[[
	*
	 * The facing side for a swing (the sign of facingX, or his attack direction when facingX is 0) and the blade wave's direction:
	 * toward the nearest opponent that is not down or recovering and is on that side. With no such opponent it points straight to
	 * that side.
	 
]]
function slashAim(state, p)
	local side = if p.facingX ~= 0 then math.sign(p.facingX) else attackDir(state, p.team)
	local target = nil
	local targetDist = math.huge
	for _, v in state.players do
		if v.team == p.team or v.action == "down" or v.action == "recover" then
			continue
		end
		if (v.x - p.x) * side <= 0 then
			continue
		end
		local d = distance(p.x, p.y, v.x, v.y)
		if d < targetDist then
			target = v
			targetDist = d
		end
	end
	if target == nil then
		return {
			side = side,
			dirX = side,
			dirY = 0,
		}
	end
	return {
		side = side,
		dirX = (target.x - p.x) / targetDist,
		dirY = (target.y - p.y) / targetDist,
	}
end
--* One blade wave from his position flying along (dirX, dirY). 
function fireBladeWave(state, p, dirX, dirY)
	-- One fire per player per tick, so this id is unique among the waves in play.
	local wave = {
		id = state.tick * #state.players + p.idx,
		ownerIdx = p.idx,
		team = p.team,
		x = p.x,
		y = p.y,
		dirX = dirX,
		dirY = dirY,
		travelled = 0,
	}
	local _exp = state.waves
