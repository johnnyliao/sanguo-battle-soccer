        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">match</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local BALL_RADIUS = _constants.BALL_RADIUS
local FIELD_D = _constants.FIELD_D
local FIELD_W = _constants.FIELD_W
local GOAL_CELEBRATE_TICKS = _constants.GOAL_CELEBRATE_TICKS
local HALFTIME_TICKS = _constants.HALFTIME_TICKS
local KICKOFF_TICKS = _constants.KICKOFF_TICKS
local endRampage = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "actions").endRampage
local _field = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "field")
local attackDir = _field.attackDir
local formationPosition = _field.formationPosition
local goalMouth = _field.goalMouth
local startPk = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "pk").startPk
--* Kicking-off forward starts this far behind the center spot, on own half. 
local KICKOFF_FW_OFFSET = 14
local function otherTeam(team)
	return if team == 0 then 1 else 0
end
--* Counts the phase timer down one tick. Returns true when it has run out. 
local function countdown(state)
	state.match.phaseTimer -= 1
	return state.match.phaseTimer <= 0
end
--* Advances the match phase machine one tick. Called after physics in step. 
local updatePlay, resetForKickoff, startSecondHalf
local function updateMatch(state)
	local _exp = state.match.phase
	repeat
		local _fallthrough = false
		if _exp == "kickoff" then
			if countdown(state) then
				state.match.phase = "play"
				local _exp_1 = state.events
				table.insert(_exp_1, {
					type = "whistle",
					reason = "kickoff",
				})
			end
			break
		end
		if _exp == "play" then
			updatePlay(state)
			break
		end
		if _exp == "goal" then
			if countdown(state) then
				resetForKickoff(state)
			end
			break
		end
		if _exp == "halftime" then
			if countdown(state) then
				startSecondHalf(state)
			end
			break
		end
		if _exp == "fulltime" then
			_fallthrough = true
		end
		if _fallthrough or _exp == "pk" then
			break
		end
	until true
end
--* Goal check first (a goal does not use up clock), then the clock. 
local detectGoal, endHalf
function updatePlay(state)
	if detectGoal(state) then
		return nil
	end
	local m = state.match
	m.clockTicks -= 1
	if m.clockTicks <= 0 then
		endHalf(state)
	end
end
--* An unowned ball past a goal line inside the mouth scores for the team that attacks that goal. 
function detectGoal(state)
	local b = state.ball
	if b.ownerIdx ~= -1 then
		return false
	end
	if b.x >= -BALL_RADIUS and b.x <= FIELD_W + BALL_RADIUS then
		return false
	end
	local side = if b.x < 0 then 0 else 1
	local mouth = goalMouth(side)
	if b.y < mouth.yMin or b.y > mouth.yMax then
		return false
	end
	-- Side 0 is attacked by the team whose attack direction is -1.
	local team = if (side == 0) == (attackDir(state, 0) == -1) then 0 else 1
	local m = state.match
	m.score[team + 1] += 1
	b.ownerIdx = -1
	b.special = nil
	m.lastGoal = {
		team = team,
		scorerIdx = b.lastTouchIdx,
		tick = state.tick,
	}
	m.kickoffTeam = otherTeam(team)
	m.phase = "goal"
	m.phaseTimer = GOAL_CELEBRATE_TICKS
	local _events = state.events
	local _arg0 = {
		type = "goal",
		team = team,
		scorerIdx = b.lastTouchIdx,
	}
	table.insert(_events, _arg0)
	return true
end
function endHalf(state)
	local m = state.match
	if m.half == 1 then
		m.phase = "halftime"
		m.phaseTimer = HALFTIME_TICKS
		local _exp = state.events
		table.insert(_exp, {
			type = "whistle",
			reason = "half",
		})
		return nil
	end
	local _exp = state.events
	table.insert(_exp, {
		type = "whistle",
		reason = "full",
	})
	if m.score[1] ~= m.score[2] then
		m.phase = "fulltime"
		local _events = state.events
		local _arg0 = {
			type = "matchEnd",
			score = { m.score[1], m.score[2] },
		}
		table.insert(_events, _arg0)
	else
		m.phase = "pk"
		startPk(state)
		local _exp_1 = state.events
		table.insert(_exp_1, {
			type = "pkStart",
		})
	end
end
function startSecondHalf(state)
	local m = state.match
	m.half = 2
	m.swapped = true
	m.clockTicks = m.halfTicks
	m.kickoffTeam = otherTeam(m.firstKickoffTeam)
	resetForKickoff(state)
end
--[[
	*
	 * Puts every player on its formation spot for the current side, stops everyone, centers the ball,
	 * and starts a kickoff wait. The kicking-off team's forward stands just behind the ball.
	 
]]
function resetForKickoff(state)
	local m = state.match
	for _, p in state.players do
		if p.rampageTicks > 0 then
			endRampage(state, p)
		end
		p.bumpCooldown = 0
		local dir = attackDir(state, p.team)
		local pos = formationPosition(p.idx % 5, dir)
		p.x = pos.x
		p.y = pos.y
		p.z = 0
		p.vx = 0
		p.vy = 0
		p.vz = 0
		p.facingX = dir
		p.facingY = 0
		p.action = "normal"
		p.actionTimer = 0
		p.hitDone = false
		p.callPassTicks = 0
		p.noTouchTicks = 0
		p.chargeTicks = 0
	end
	local kicker = state.players[m.kickoffTeam * 5 + 5]
	kicker.x = FIELD_W / 2 - attackDir(state, m.kickoffTeam) * KICKOFF_FW_OFFSET
	kicker.y = FIELD_D / 2
	local b = state.ball
	b.x = FIELD_W / 2
	b.y = FIELD_D / 2
	b.z = 0
	b.vx = 0
	b.vy = 0
	b.vz = 0
	b.ownerIdx = -1
	b.lastTouchIdx = -1
	b.special = nil
	m.phase = "kickoff"
	m.phaseTimer = KICKOFF_TICKS
end
return {
	updateMatch = updateMatch,
	resetForKickoff = resetForKickoff,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">pk</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
local TS = require(game:GetService("ReplicatedStorage"):WaitForChild("rbxts_include"):WaitForChild("RuntimeLib"))
local _constants = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "constants")
local FIELD_D = _constants.FIELD_D
local FIELD_W = _constants.FIELD_W
local GOAL_H = _constants.GOAL_H
local GOAL_HALF_W = _constants.GOAL_HALF_W
local endRampage = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "actions").endRampage
local _rng = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "rng")
local rngInt = _rng.rngInt
local rngNext = _rng.rngNext
local EMPTY_INPUT = TS.import(script, game:GetService("ReplicatedStorage"), "Shared", "sim", "types").EMPTY_INPUT
local PK_AIM_TICKS = 300
local PK_METER_PERIOD = 80
local PK_FLIGHT_TICKS = 40
local PK_RESULT_TICKS = 90
--* Kicks per team before sudden death. 
local PK_ROUNDS = 5
--* Players per team; every one of them kicks once per round. 
local TEAM_SIZE = 5
local PK_DEFAULT_POWER = 0.5
local CENTER_Y = FIELD_D / 2
local SPOT_X = FIELD_W - 110
local SHOOTER_BACK = 14
local KEEPER_X = FIELD_W - 6
local ROW_X = FIELD_W - 330
local ROW_Y0 = 20
local ROW_STEP = 32
local COL_SPACING = 28
local WIDE_MISS_Y = GOAL_HALF_W + 12
local GOAL_TARGET_X = FIELD_W + 8
local LOW_Z = 6
local HIGH_Z = 26
local KEEPER_HIGH_Z = 18
local OVER_BAR_Z = GOAL_H + 14
--* Shot meter 0..1 after `ticks` ticks of held J: a triangle wave with period PK_METER_PERIOD. 
local function pkMeterValue(ticks)
	local phase = ticks % PK_METER_PERIOD
	local half = PK_METER_PERIOD / 2
	return if phase < half then phase / half else 2 - phase / half
end
--* held moveY to target column: up (-1) = 0 (far post), neutral = 1, down (+1) = 2 (near post). 
local function colFromMoveY(moveY)
	return moveY + 1
end
local function requirePk(state)
	local pk = state.match.pk
	if pk == nil then
		error("penalty shootout has not started")
	end
	return pk
end
local function teamIdxs(team)
	local _exp = { 0, 1, 2, 3, 4 }
	-- ▼ ReadonlyArray.map ▼
	local _newValue = table.create(#_exp)
	local _callback = function(i)
		return team * TEAM_SIZE + i
	end
	for _k, _v in _exp do
		_newValue[_k] = _callback(_v, _k - 1, _exp)
	end
	-- ▲ ReadonlyArray.map ▲
	return _newValue
end
--* Starts the shootout in the 'order' stage. Called by updateMatch when the 2nd half ends level. 
local placePlayers, placeBall
local function startPk(state)
	for _, p in state.players do
		if p.rampageTicks > 0 then
			endRampage(state, p)
		end
		p.bumpCooldown = 0
	end
	local firstTeam = if rngInt(state, 2) == 0 then 0 else 1
	state.match.pk = {
		stage = "order",
		stageTimer = 0,
		order = { nil, nil },
		kicks = { {}, {} },
		kickingTeam = firstTeam,
		firstTeam = firstTeam,
		shooterIdx = -1,
		keeperIdx = -1,
		meterTicks = -1,
		power = 0,
		aimCol = 1,
		aimHigh = false,
		guessCol = 1,
		guessHigh = false,
		outcome = nil,
		score = { 0, 0 },
		winner = -1,
	}
	placePlayers(state, -1, -1)
	placeBall(state)
end
--* Team's 5 idxs sorted by power + technique, highest first; ties go to the lowest idx. 
local function defaultPkOrder(state, team)
	local rating = function(idx)
		local s = state.players[idx + 1].stats
		return s.power + s.technique
	end
	local _exp = teamIdxs(team)
	table.sort(_exp, function(a, b)
		local _condition = rating(b) - rating(a)
		if not (_condition ~= 0 and _condition == _condition and _condition) then
			_condition = a - b
		end
		return _condition < 0
	end)
	return _exp
end
--* Stores a team's kicking order. When both orders are set, the first kick begins. 
local beginKick
local function submitPkOrder(state, team, order)
	local pk = requirePk(state)
	if pk.stage ~= "order" then
		error("penalty order is locked")
	end
	local expected = teamIdxs(team)
	local _condition = #order == TEAM_SIZE
	if _condition then
		local _array = {}
		local _length = #_array
		table.move(order, 1, #order, _length + 1, _array)
		table.sort(_array, function(a, b)
			return a < b
		end)
		-- ▼ ReadonlyArray.every ▼
		local _result = true
		local _callback = function(idx, i)
			return idx == expected[i + 1]
		end
		for _k, _v in _array do
			if not _callback(_v, _k - 1, _array) then
				_result = false
				break
			end
		end
		-- ▲ ReadonlyArray.every ▲
		_condition = _result
	end
	local valid = _condition
	if not valid then
		error(`invalid penalty order for team {team}: {table.concat(order, ",")}`)
	end
	local _array = {}
	local _length = #_array
	table.move(order, 1, #order, _length + 1, _array)
	pk.order[team + 1] = _array
	if pk.order[1] ~= nil and pk.order[2] ~= nil then
		beginKick(state, pk)
	end
end
--* Fills every null order except the human team's (-1 = no human team) with defaultPkOrder. 
local function autoPkOrders(state, humanTeam)
	for _, team in { 0, 1 } do
		if team == humanTeam then
			continue
		end
		if requirePk(state).order[team + 1] == nil then
			submitPkOrder(state, team, defaultPkOrder(state, team))
		end
	end
end
--* Starts the next kick: picks the shooter and keeper and puts everyone on the spot. 
function beginKick(state, pk)
	local team = pk.kickingTeam
	local order = pk.order[team + 1]
	if order == nil then
		error(`no penalty order for team {team}`)
	end
	pk.shooterIdx = order[#pk.kicks[team + 1] % TEAM_SIZE + 1]
	pk.keeperIdx = (1 - team) * TEAM_SIZE
	pk.stage = "aim"
	pk.stageTimer = PK_AIM_TICKS
	pk.meterTicks = -1
	pk.power = 0
	pk.aimCol = 1
	pk.aimHigh = false
	pk.guessCol = 1
	pk.guessHigh = false
	pk.outcome = nil
	placePlayers(state, pk.shooterIdx, pk.keeperIdx)
	placeBall(state)
	local _events = state.events
	local _arg0 = {
		type = "pkKick",
		shooterIdx = pk.shooterIdx,
	}
	table.insert(_events, _arg0)
end
local function placeAt(p, x, y, facingX)
	p.x = x
	p.y = y
	p.z = 0
	p.vx = 0
	p.vy = 0
	p.vz = 0
	p.facingX = facingX
	p.facingY = 0
	p.action = "normal"
	p.actionTimer = 0
end
--* Shooter and keeper go to their spots; everyone else stands in a row away from the action. 
function placePlayers(state, shooterIdx, keeperIdx)
	local row = 0
	for _, p in state.players do
		if p.idx == shooterIdx then
			placeAt(p, SPOT_X - SHOOTER_BACK, CENTER_Y, 1)
		elseif p.idx == keeperIdx then
			placeAt(p, KEEPER_X, CENTER_Y, -1)
		else
			placeAt(p, ROW_X, ROW_Y0 + row * ROW_STEP, 1)
			row += 1
		end
	end
end
function placeBall(state)
	local b = state.ball
	b.x = SPOT_X
	b.y = CENTER_Y
	b.z = 0
	b.vx = 0
	b.vy = 0
	b.vz = 0
	b.ownerIdx = -1
	b.lastTouchIdx = -1
	b.special = nil
end
--* Advances the shootout one tick. Players do not move normally during the PK; only the kick stages read inputs. 
local tickAim, tickFlight, tickResult
local function updatePk(state, inputs)
	local pk = requirePk(state)
	local _exp = pk.stage
	repeat
		local _fallthrough = false
		if _exp == "aim" then
			tickAim(state, pk, inputs)
			break
		end
		if _exp == "flight" then
			tickFlight(state, pk)
			break
		end
		if _exp == "result" then
			tickResult(state, pk)
			break
		end
		if _exp == "order" then
			_fallthrough = true
		end
		if _fallthrough or _exp == "done" then
			break
		end
	until true
end
local shoot
function tickAim(state, pk, inputs)
	local shooter = state.players[pk.shooterIdx + 1]
	local keeper = state.players[pk.keeperIdx + 1]
	local keeperIn = inputs[keeper.idx + 1] or EMPTY_INPUT
	pk.guessCol = colFromMoveY(keeperIn.moveY)
	pk.guessHigh = keeperIn.k
	local shooterIn = inputs[shooter.idx + 1] or EMPTY_INPUT
	if pk.meterTicks < 0 then
		if shooterIn.j and not shooter.prevInput.j then
			pk.meterTicks = 0
		end
	elseif shooterIn.j then
		pk.meterTicks += 1
	else
		shoot(state, pk, shooterIn)
		return nil
	end
	pk.stageTimer -= 1
	if pk.stageTimer <= 0 then
		shoot(state, pk, shooterIn)
	end
end
--* Locks power, aim and the keeper's guess, rolls the outcome, and starts the flight. 
local rollOutcome
function shoot(state, pk, aimIn)
	local shooter = state.players[pk.shooterIdx + 1]
	local keeper = state.players[pk.keeperIdx + 1]
	pk.power = if pk.meterTicks >= 0 then pkMeterValue(pk.meterTicks) else PK_DEFAULT_POWER
	pk.aimCol = colFromMoveY(aimIn.moveY)
	pk.aimHigh = aimIn.k
	pk.outcome = rollOutcome(state, pk, shooter, keeper)
	pk.stage = "flight"
	pk.stageTimer = PK_FLIGHT_TICKS
	keeper.action = "dive"
	local _events = state.events
	local _arg0 = {
		type = "kick",
		playerIdx = shooter.idx,
		kind = "shot",
		targetIdx = -1,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Rolls roll1 always (miss check). roll2 is consumed only when the keeper guessed the aimed column and the
	 * shot was not a miss; a wrong guess is a goal with no second roll.
	 
]]
local clamp
function rollOutcome(state, pk, shooter, keeper)
	local roll1 = rngNext(state)
	local missChance = (if pk.aimCol ~= 1 then 0.06 + (10 - shooter.stats.technique) * 0.015 else 0.02) + (if pk.power > 0.92 then (if pk.aimHigh then 0.6 else 0.25) else 0)
	if roll1 < missChance then
		return "miss"
	end
	if pk.guessCol ~= pk.aimCol then
		return "goal"
	end
	local roll2 = rngNext(state)
	local saveChance = clamp(0.35 + (keeper.stats.defense - shooter.stats.power) * 0.06 + (if pk.guessHigh == pk.aimHigh then 0.15 else -0.15) + (0.6 - pk.power) * 0.5, 0.05, 0.9)
	return if roll2 < saveChance then "save" else "goal"
end
local ballTarget, lerp, diveTarget, enterResult
function tickFlight(state, pk)
	pk.stageTimer -= 1
	local t = (PK_FLIGHT_TICKS - pk.stageTimer) / PK_FLIGHT_TICKS
	local to = ballTarget(pk)
	local b = state.ball
	b.x = lerp(SPOT_X, to.x, t)
	b.y = lerp(CENTER_Y, to.y, t)
	b.z = lerp(0, to.z, t)
	local dive = diveTarget(pk)
	local keeper = state.players[pk.keeperIdx + 1]
	keeper.y = lerp(CENTER_Y, dive.y, t)
	keeper.z = lerp(0, dive.z, t)
	if pk.stageTimer <= 0 and pk.outcome ~= nil then
		enterResult(state, pk, pk.outcome)
	end
end
--* Records the kick and emits its result. The next decision happens after PK_RESULT_TICKS. 
function enterResult(state, pk, outcome)
	local team = pk.kickingTeam
	local _exp = pk.kicks[team + 1]
	local _arg0 = if outcome == "goal" then "goal" else "miss"
	table.insert(_exp, _arg0)
	if outcome == "goal" then
		pk.score[team + 1] += 1
	end
	pk.stage = "result"
	pk.stageTimer = PK_RESULT_TICKS
	local _events = state.events
	local _arg0_1 = {
		type = "pkResult",
		team = team,
		outcome = outcome,
	}
	table.insert(_events, _arg0_1)
	if outcome == "save" then
		local _events_1 = state.events
		local _arg0_2 = {
			type = "save",
			playerIdx = pk.keeperIdx,
			caught = true,
		}
		table.insert(_events_1, _arg0_2)
	end
end
local checkWinner, finish
function tickResult(state, pk)
	pk.stageTimer -= 1
	if pk.stageTimer > 0 then
		return nil
	end
	local winner = checkWinner(pk)
	if winner ~= -1 then
		finish(state, pk, winner)
		return nil
	end
	pk.kickingTeam = if pk.kickingTeam == 0 then 1 else 0
	beginKick(state, pk)
end
--[[
	*
	 * Regulation (both teams within 5 kicks): a team wins once the other cannot catch up with its remaining kicks.
	 * Sudden death (past 5 kicks): decided only when both teams have the same number of kicks and the scores differ.
	 
]]
function checkWinner(pk)
	local taken0 = #pk.kicks[1]
	local taken1 = #pk.kicks[2]
	if taken0 <= PK_ROUNDS and taken1 <= PK_ROUNDS then
		for _, team in { 0, 1 } do
			local other = if team == 0 then 1 else 0
			local remaining = math.max(0, PK_ROUNDS - #pk.kicks[other + 1])
			if pk.score[team + 1] > pk.score[other + 1] + remaining then
				return team
			end
		end
		return -1
	end
	if taken0 == taken1 and pk.score[1] ~= pk.score[2] then
		return if pk.score[1] > pk.score[2] then 0 else 1
	end
	return -1
end
function finish(state, pk, winner)
	pk.stage = "done"
	pk.stageTimer = 0
	pk.winner = winner
	state.match.phase = "fulltime"
	local _events = state.events
	local _arg0 = {
		type = "pkEnd",
		winner = winner,
		score = { pk.score[1], pk.score[2] },
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "matchEnd",
		score = { state.match.score[1], state.match.score[2] },
	}
	table.insert(_events_1, _arg0_1)
end
--* Keeper's dive end point: stays on the goal line, moves to the guessed column. 
function diveTarget(pk)
	return {
		y = CENTER_Y + (pk.guessCol - 1) * COL_SPACING,
		z = if pk.guessHigh then KEEPER_HIGH_Z else 0,
	}
end
--* Where the ball ends its flight: the save point, a wide or over-the-bar miss, or the aimed goal spot. 
function ballTarget(pk)
	if pk.outcome == "save" then
		local d = diveTarget(pk)
		return {
			x = KEEPER_X,
			y = d.y,
			z = d.z,
		}
	end
	local z = if pk.aimHigh then HIGH_Z else LOW_Z
	if pk.outcome == "miss" and pk.aimCol == 1 then
		return {
			x = GOAL_TARGET_X,
			y = CENTER_Y,
			z = OVER_BAR_Z,
		}
	end
	if pk.outcome == "miss" then
		return {
			x = GOAL_TARGET_X,
			y = CENTER_Y + (pk.aimCol - 1) * WIDE_MISS_Y,
			z = z,
		}
	end
	return {
		x = GOAL_TARGET_X,
		y = CENTER_Y + (pk.aimCol - 1) * COL_SPACING,
		z = z,
	}
end
function lerp(a, b, t)
	return a + (b - a) * t
end
function clamp(v, lo, hi)
	return math.min(hi, math.max(lo, v))
end
return {
	pkMeterValue = pkMeterValue,
	startPk = startPk,
	defaultPkOrder = defaultPkOrder,
	submitPkOrder = submitPkOrder,
	autoPkOrders = autoPkOrders,
	updatePk = updatePk,
	PK_AIM_TICKS = PK_AIM_TICKS,
	PK_METER_PERIOD = PK_METER_PERIOD,
	PK_FLIGHT_TICKS = PK_FLIGHT_TICKS,
	PK_RESULT_TICKS = PK_RESULT_TICKS,
}
]]></string>
