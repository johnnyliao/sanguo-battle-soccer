            <string name="Name">rng</string>
            <string name="Source"><![CDATA[-- Compiled with roblox-ts v3.0.0
--[[
	*
	 * Math.imul replacement: low 32 bits of a*b as an unsigned number. Splits into 16-bit halves so every
	 * intermediate stays below 2^53 (exact in Luau doubles). Inputs are uint32 or int32 values.
	 
]]
local function imul(a, b)
	local ah = bit32.band((bit32.rshift(a, 16)), 0xffff)
	local al = bit32.band(a, 0xffff)
	local bh = bit32.band((bit32.rshift(b, 16)), 0xffff)
	local bl = bit32.band(b, 0xffff)
	return (al * bl + ((ah * bl + al * bh) % 65536) * 65536) % 4294967296
end
--* mulberry32 step over state.rng. Returns a float in [0, 1) and advances state.rng. 
local function rngNext(state)
	state.rng = bit32.rshift((state.rng + 0x6d2b79f5), 0)
	local t = state.rng
	t = imul(bit32.bxor(t, (bit32.rshift(t, 15))), bit32.bor(t, 1))
	t = bit32.bxor(t, t + imul(bit32.bxor(t, (bit32.rshift(t, 7))), bit32.bor(t, 61)))
	return (bit32.rshift((bit32.bxor(t, (bit32.rshift(t, 14)))), 0)) / 4294967296
end
--* Returns an integer in [0, n) and advances state.rng. 
local function rngInt(state, n)
	return math.floor(rngNext(state) * n)
end
return {
	imul = imul,
	rngNext = rngNext,
	rngInt = rngInt,
}
]]></string>
