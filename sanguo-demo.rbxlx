	end
	p.sailTicks -= 1
	if p.sailTicks == 0 then
		endSail(state, p)
	end
end
--* True if v's body touches the sail hull: a box of SAIL_HALF_LEN x SAIL_HALF_DEPTH centred on the sailor, grown by v's radius. 
local function touchesSail(sailor, v)
	return math.abs(v.x - sailor.x) <= K.SAIL_HALF_LEN + v.radius and math.abs(v.y - sailor.y) <= K.SAIL_HALF_DEPTH + v.radius
end
--[[
	*
	 * Sail contacts, run after the actions. Only in play. A sailor who is down or in hitstun ends his sail (a guard: an invincible
	 * sailor is not normally hit). Otherwise the first opponent that is not invincible, down or recovering and touches the hull is
	 * launched and the sail ends (sailCrash). With no crash and no passenger yet, the first teammate touching the hull boards.
	 
]]
local sailCrash, boardSail
local function updateSails(state)
	if state.match.phase ~= "play" then
		return nil
	end
	for _, p in state.players do
		if p.sailTicks == 0 then
			continue
		end
		if p.action == "down" or p.action == "hitstun" then
			endSail(state, p)
			continue
		end
		local _exp = state.players
		-- ▼ ReadonlyArray.find ▼
		local _callback = function(v)
			return v.team ~= p.team and v.action ~= "down" and v.action ~= "recover" and not isInvincible(v) and touchesSail(p, v)
		end
		local _result
		for _i, _v in _exp do
			if _callback(_v, _i - 1, _exp) == true then
				_result = _v
				break
			end
		end
		-- ▲ ReadonlyArray.find ▲
		local victim = _result
		if victim ~= nil then
			sailCrash(state, p, victim)
			continue
		end
		if p.sailPassenger ~= -1 then
			continue
		end
		local _exp_1 = state.players
		-- ▼ ReadonlyArray.find ▼
		local _callback_1 = function(v)
			return v.team == p.team and v.idx ~= p.idx and v.action ~= "down" and v.action ~= "recover" and v.sailPassengerOf == -1 and touchesSail(p, v)
		end
		local _result_1
		for _i, _v in _exp_1 do
			if _callback_1(_v, _i - 1, _exp_1) == true then
				_result_1 = _v
				break
			end
		end
		-- ▲ ReadonlyArray.find ▲
		local mate = _result_1
		if mate ~= nil then
			boardSail(state, p, mate)
		end
	end
end
--[[
	*
	 * The hull launches an opponent: he is knocked down for SAIL_LAUNCH_TICKS, flies away from the sailor (SAIL_LAUNCH_SPEED,
	 * SAIL_LAUNCH_VZ up) and loses no stamina. A ball he holds is knocked loose. The sail ends right after.
	 
]]
function sailCrash(state, sailor, v)
	local _events = state.events
	local _arg0 = {
		type = "sailCrash",
		playerIdx = sailor.idx,
		victimIdx = v.idx,
		x = v.x,
		y = v.y,
	}
	table.insert(_events, _arg0)
	reportCastCancel(state, v)
	v.chargeTicks = 0
	local dirX = v.x - sailor.x
	local dirY = v.y - sailor.y
	local len = math.sqrt(dirX * dirX + dirY * dirY)
	if len == 0 then
		dirX = sailor.facingX
		dirY = sailor.facingY
	else
		dirX /= len
		dirY /= len
	end
	v.vx = dirX * K.SAIL_LAUNCH_SPEED
	v.vy = dirY * K.SAIL_LAUNCH_SPEED
	v.vz = K.SAIL_LAUNCH_VZ
	local damage = K.SAIL_CRASH_STAMINA_RATIO * v.maxStamina
	v.stamina = math.max(0, v.stamina - damage)
	-- Airborne for LAUNCH_AIR_TICKS, down for the whole time; an emptied victim stays down for the longer exhausted time.
	setDown(v, if v.stamina <= 0 then math.max(K.SAIL_LAUNCH_TICKS, K.DOWN_TICKS_EXHAUSTED) else K.SAIL_LAUNCH_TICKS)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "hit",
		attackerIdx = sailor.idx,
		victimIdx = v.idx,
		kind = "special",
		damage = damage,
	}
	table.insert(_events_1, _arg0_1)
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, sailor, v, dirX, dirY)
	end
	local _events_2 = state.events
	local _arg0_2 = {
		type = "down",
		playerIdx = v.idx,
	}
	table.insert(_events_2, _arg0_2)
	endSail(state, sailor)
end
--* A teammate boards the sail: he stops, is placed by carryPassengers, and is invincible until the sail ends. 
function boardSail(state, sailor, mate)
	reportCastCancel(state, mate)
	mate.chargeTicks = 0
	if mate.rampageTicks > 0 then
		endRampage(state, mate)
	end
	mate.action = "normal"
	mate.actionTimer = 0
	mate.vx = 0
	mate.vy = 0
	mate.vz = 0
	mate.z = 0
	mate.sailPassengerOf = sailor.idx
	sailor.sailPassenger = mate.idx
	local _events = state.events
	local _arg0 = {
		type = "sailBoard",
		playerIdx = sailor.idx,
		passengerIdx = mate.idx,
	}
	table.insert(_events, _arg0)
end
--* Each passenger is set just behind his sailor (SAIL_PASSENGER_BEHIND, against the facing) after the tick's pushes. 
local function carryPassengers(state)
	for _, mate in state.players do
		if mate.sailPassengerOf == -1 then
			continue
		end
		local sailor = state.players[mate.sailPassengerOf + 1]
		mate.x = sailor.x - sailor.facingX * K.SAIL_PASSENGER_BEHIND
		mate.y = sailor.y
		mate.vx = 0
		mate.vy = 0
		clampPlayerToField(mate)
	end
end
--[[
	*
	 * Ends a sail for any reason: the sailor is no longer invincible, and his passenger (if any) is released at his position
	 * to normal play. Callers only call this for a sailing player.
	 
]]
function endSail(state, sailor)
	sailor.sailTicks = 0
	local _events = state.events
	local _arg0 = {
		type = "sailEnd",
		playerIdx = sailor.idx,
	}
	table.insert(_events, _arg0)
	if sailor.sailPassenger == -1 then
		return nil
	end
	local mate = state.players[sailor.sailPassenger + 1]
	sailor.sailPassenger = -1
	mate.sailPassengerOf = -1
	mate.action = "normal"
	mate.actionTimer = 0
	local _events_1 = state.events
	local _arg0_1 = {
		type = "sailDrop",
		playerIdx = sailor.idx,
		passengerIdx = mate.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--* Ends every sail (the phase left play). Silent apart from sailEnd and sailDrop: no crash, no launch. 
local function endSails(state)
	for _, p in state.players do
		if p.sailTicks > 0 then
			endSail(state, p)
		end
	end
end
--* Clears a rampage and reports it. Callers only call this while the player is rampaging. 
function endRampage(state, p)
	p.rampageTicks = 0
	local _events = state.events
	local _arg0 = {
		type = "rampageEnd",
		playerIdx = p.idx,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Counts down bump cooldowns and the rampage. A rampage also ends when its owner loses the ball or the phase leaves play.
	 * A no-ball special's rampage (specialNoBall) does not end for lack of the ball: only its timer or the phase ends it.
	 
]]
local rampageAtGoalMouth
function tickRampage(state, p)
	if p.bumpCooldown > 0 then
		p.bumpCooldown -= 1
	end
	if p.rampageTicks == 0 then
		return nil
	end
	p.rampageTicks -= 1
	local holding = state.match.phase == "play" and state.ball.ownerIdx == p.idx
	if holding and rampageAtGoalMouth(state, p) then
		local side = if attackDir(state, p.team) == 1 then 1 else 0
		endRampage(state, p)
		ballIntoGoal(state, p, side, attackDir(state, p.team) * maxSpeedOf(state, p), 0)
		return nil
	end
	local ends = if p.specialNoBall then state.match.phase ~= "play" or p.rampageTicks == 0 else not holding or p.rampageTicks == 0
	if ends then
		endRampage(state, p)
	end
end
--* True if the rampager stands on the goal line he attacks (the field clamp stops him there), inside the mouth. 
function rampageAtGoalMouth(state, p)
	local side = if attackDir(state, p.team) == 1 then 1 else 0
	local mouth = goalMouth(side)
	local onGoalLine = if side == 1 then p.x >= K.FIELD_W else p.x <= 0
	return onGoalLine and p.y >= mouth.yMin + K.BALL_RADIUS and p.y <= mouth.yMax - K.BALL_RADIUS
end
--* Ball leaves the owner. The ball keeps its current (dribble) position. 
function releaseBall(state, p, vx, vy, vz)
	local ball = state.ball
	ball.ownerIdx = -1
	ball.lastTouchIdx = p.idx
	ball.vx = vx
	ball.vy = vy
	ball.vz = vz
	p.noTouchTicks = K.KICK_NO_TOUCH
	p.action = "recover"
	p.actionTimer = K.KICK_RECOVER_TICKS
end
--* Launch speed of a special shot's ball, per kind. 
local function specialSpeed(kind)
	repeat
		if kind == "straight" then
			return K.SPECIAL_STRAIGHT_SPEED
		end
		if kind == "zigzag" then
			return K.SPECIAL_ZIGZAG_SPEED
		end
		if kind == "lob" then
			return K.SPECIAL_LOB_SPEED
		end
		if kind == "pierce" then
			return K.SPECIAL_PIERCE_SPEED
		end
		if kind == "beam" then
			return K.BEAM_SPEED
		end
	until true
end
--* Flight time of a lob from launch to landing: rising at GRAVITY, falling at GRAVITY * fall multiplier. 
local function lobFlightTime()
	local up = K.SPECIAL_LOB_VZ / K.GRAVITY
	local apex = (K.SPECIAL_LOB_VZ * K.SPECIAL_LOB_VZ) / (2 * K.GRAVITY)
	return up + math.sqrt((2 * apex) / (K.GRAVITY * K.SPECIAL_LOB_FALL_GRAVITY_MULT))
end
--* Horizontal speed that brings a lob down LOB_OVERSHOOT past the goal line, `dist` away along the shot. 
local function lobSpeed(dist)
	return math.min(LOB_MAX_SPEED, math.max(LOB_MIN_SPEED, (dist + LOB_OVERSHOOT) / lobFlightTime()))
end
function startSpecial(state, p)
	local ball = state.ball
	local goalX = opponentGoalX(state, p.team)
	local dx = goalX - ball.x
	local dy = K.FIELD_D / 2 - ball.y
	local len = math.sqrt(dx * dx + dy * dy)
	local dirX = if len > 0 then dx / len else attackDir(state, p.team)
	local dirY = if len > 0 then dy / len else 0
	local speed = if p.specialKind == "lob" then lobSpeed(len) else specialSpeed(p.specialKind)
	p.stamina = math.max(0, p.stamina - K.SPECIAL_STAMINA_COST)
	releaseBall(state, p, dirX * speed, dirY * speed, if p.specialKind == "lob" then K.SPECIAL_LOB_VZ else 0)
	local special = {
		kind = p.specialKind,
		shooterIdx = p.idx,
		team = p.team,
		ticks = 0,
		dirX = dirX,
		dirY = dirY,
		speed = speed,
		hit = {},
		rolled = {},
	}
	ball.special = special
	local _events = state.events
	local _arg0 = {
		type = "specialShot",
		playerIdx = p.idx,
		kind = p.specialKind,
	}
	table.insert(_events, _arg0)
end
function shoot(state, p, input, charge)
	local ball = state.ball
	local goalX = opponentGoalX(state, p.team)
	local aimY = K.FIELD_D / 2 + input.moveY * SHOT_AIM_OFFSET_Y + (rngNext(state) * 2 - 1) * (11 - p.stats.technique) * SHOT_AIM_SPREAD
	local targetZ = 6 + rngNext(state) * (K.GOAL_H - 10)
	local speed = K.SHOT_BASE_SPEED + p.stats.power * K.SHOT_SPEED_PER_POWER + charge * K.SHOT_SPEED_PER_CHARGE
	local dx = goalX - ball.x
	local dy = aimY - ball.y
	local dist = math.sqrt(dx * dx + dy * dy)
	local ux = if dist > 0 then dx / dist else attackDir(state, p.team)
	local uy = if dist > 0 then dy / dist else 0
	local t = dist / speed
	local vz = math.min(SHOT_MAX_VZ, targetZ / t + 0.5 * K.GRAVITY * t)
	releaseBall(state, p, ux * speed, uy * speed, vz)
	local _events = state.events
	local _arg0 = {
		type = "kick",
		playerIdx = p.idx,
		kind = "shot",
		targetIdx = -1,
	}
	table.insert(_events, _arg0)
end
function kickClear(state, p)
	-- Inside its own area a player clearing toward its own goal is mirrored up-field instead.
	local backward = p.facingX * attackDir(state, p.team) < 0
	local dirX = if backward and inOwnArea(state, p) then -p.facingX else p.facingX
	releaseBall(state, p, dirX * CLEAR_SPEED, p.facingY * CLEAR_SPEED, CLEAR_VZ)
	local _events = state.events
	local _arg0 = {
		type = "kick",
		playerIdx = p.idx,
		kind = "clear",
		targetIdx = -1,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Teammate for a pass: a teammate who called for the ball (callPassTicks > 0) wins regardless of facing
	 * (highest callPassTicks, ties: lowest idx). Otherwise prefers the nearest one in front (cos > 0.3),
	 * else nearest overall. -1 if none.
	 
]]
local function choosePassTarget(state, p)
	local callIdx = -1
	local callTicks = 0
	for _, t in state.players do
		if t.team ~= p.team or t.idx == p.idx or t.action == "down" then
			continue
		end
		if t.callPassTicks > callTicks then
			callIdx = t.idx
			callTicks = t.callPassTicks
		end
	end
	if callIdx ~= -1 then
		return callIdx
	end
	local frontIdx = -1
	local frontScore = math.huge
	local anyIdx = -1
	local anyScore = math.huge
	for _, t in state.players do
		if t.team ~= p.team or t.idx == p.idx or t.action == "down" then
			continue
		end
		local dx = t.x - p.x
		local dy = t.y - p.y
		local dist = math.sqrt(dx * dx + dy * dy)
		local cos = if dist > 0 then (dx * p.facingX + dy * p.facingY) / dist else 0
		local score = dist * (2 - cos)
		if cos > PASS_CONE_COS and score < frontScore then
			frontIdx = t.idx
			frontScore = score
		end
		if score < anyScore then
			anyIdx = t.idx
			anyScore = score
		end
	end
	return if frontIdx ~= -1 then frontIdx else anyIdx
end
function passBall(state, p)
	local idx = choosePassTarget(state, p)
	if idx == -1 then
		return nil
	end
	local target = state.players[idx + 1]
	local dx = target.x - p.x
	local dy = target.y - p.y
	local dist = math.sqrt(dx * dx + dy * dy)
	-- Lead the target: aim where it will be, assuming it keeps its current velocity.
	local lead = (dist / PASS_SPEED_GUESS) * 0.5
	local aimX = target.x + target.vx * lead - p.x
	local aimY = target.y + target.vy * lead - p.y
	local aimLen = math.sqrt(aimX * aimX + aimY * aimY)
	local ux = if aimLen > 0 then aimX / aimLen else p.facingX
	local uy = if aimLen > 0 then aimY / aimLen else p.facingY
	if dist <= K.PASS_LOB_DIST then
		local speed = math.min(380, math.max(160, 120 + dist * 1.2))
		releaseBall(state, p, ux * speed, uy * speed, PASS_GROUND_VZ)
	else
		local t = dist / K.PASS_LOB_SPEED
		releaseBall(state, p, ux * K.PASS_LOB_SPEED, uy * K.PASS_LOB_SPEED, math.min(PASS_LOB_MAX_VZ, 0.5 * K.GRAVITY * t))
	end
	local _events = state.events
	local _arg0 = {
		type = "kick",
		playerIdx = p.idx,
		kind = "pass",
		targetIdx = idx,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * Special-ball hit: stamina cost `cost` (default SPECIAL_HIT_STAMINA); pierce knocks down, other kinds hitstun.
	 * Knockback follows the ball's direction.
	 
]]
function applySpecialHit(state, shooter, victim, kind, dirX, dirY, cost)
	if cost == nil then
		cost = K.SPECIAL_HIT_STAMINA
	end
	if isInvincible(victim) then
		arrowshipBlockAttack(state, victim)
		return nil
	end
	reportCastCancel(state, victim)
	victim.stamina = math.max(0, victim.stamina - cost)
	victim.chargeTicks = 0
	local knock = (K.KNOCKBACK_SPEED * shooter.mass) / victim.mass
	victim.vx = dirX * knock
	victim.vy = dirY * knock
	victim.vz = HIT_VZ
	local down = false
	if victim.stamina <= 0 then
		setDown(victim, K.DOWN_TICKS_EXHAUSTED)
		down = true
	elseif kind == "pierce" then
		setDown(victim, K.DOWN_TICKS_KNOCKED)
		down = true
	else
		victim.action = "hitstun"
		victim.actionTimer = K.HITSTUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = shooter.idx,
		victimIdx = victim.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = victim.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
end
--* First opponent in index order that is not down and satisfies the overlap test. 
function findVictim(state, attacker, overlaps)
	for _, v in state.players do
		if v.team == attacker.team or v.action == "down" then
			continue
		end
		if overlaps(v) then
			return v
		end
	end
	return nil
end
--* Invincible players (rampaging, lunging, leaping, riding, under Sun Quan's arrowship, or on or aboard a sail) cannot be hit, tackled, stolen from, roared at, or pierced by a special. 
function isInvincible(p)
	return p.rampageTicks > 0 or p.arrowshipUp or p.action == "lunge" or p.action == "leap" or p.action == "ride" or p.sailTicks > 0 or p.sailPassengerOf ~= -1
end
--[[
	*
	 * Each invincible attacker (rampaging or lunging) knocks away every standing opponent that is not invincible and not on
	 * bump cooldown, whose circle is within RAMPAGE_BUMP_PAD of its own. Runs after the actions, before collisions.
	 
]]
local rampageBump
local function applyRampageBumps(state)
	for _, r in state.players do
		-- A leap hits only on landing (see landLeap), a ride hits only its lane (see rideHitLane), and a sail only through
		-- updateSails (a sailor or passenger does not bump), so none of them bump here.
		if not isInvincible(r) or r.action == "leap" or r.action == "ride" or r.sailTicks > 0 or r.sailPassengerOf ~= -1 or r.arrowshipUp then
			continue
		end
		for _1, o in state.players do
			if o.team == r.team or o.action == "down" or o.bumpCooldown > 0 or isInvincible(o) then
				continue
			end
			local dx = o.x - r.x
			local dy = o.y - r.y
			local dist = math.sqrt(dx * dx + dy * dy)
			if dist >= r.radius + o.radius + RAMPAGE_BUMP_PAD then
				continue
			end
			rampageBump(state, r, o, dist)
		end
	end
end
local lungeHeal
function rampageBump(state, rampager, victim, dist)
	reportCastCancel(state, victim)
	local dirX = if dist > 0 then (victim.x - rampager.x) / dist else rampager.facingX
	local dirY = if dist > 0 then (victim.y - rampager.y) / dist else rampager.facingY
	local massMult = math.min(1.5, math.max(0.7, rampager.mass / victim.mass))
	victim.vx = dirX * K.RAMPAGE_BUMP_SPEED * massMult
	victim.vy = dirY * K.RAMPAGE_BUMP_SPEED * massMult
	victim.vz = RAMPAGE_BUMP_VZ
	victim.bumpCooldown = K.RAMPAGE_BUMP_COOLDOWN
	local cost = if rampager.specialBumpPct ~= nil then rampager.specialBumpPct * victim.maxStamina else K.RAMPAGE_BUMP_STAMINA
	victim.stamina = math.max(0, victim.stamina - cost)
	-- Sent flying: always knocked down (longer when it empties his stamina).
	setDown(victim, if victim.stamina <= 0 then K.DOWN_TICKS_EXHAUSTED else K.DOWN_TICKS_KNOCKED)
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = rampager.idx,
		victimIdx = victim.idx,
		kind = "special",
		damage = cost,
	}
	table.insert(_events, _arg0)
	local _events_1 = state.events
	local _arg0_1 = {
		type = "down",
		playerIdx = victim.idx,
	}
	table.insert(_events_1, _arg0_1)
	if rampager.action == "lunge" then
		lungeHeal(state, rampager)
	end
end
--* A lunge bump restores Zhao Yun LUNGE_HEAL_RATIO of his own maxStamina, capped at maxStamina. 
function lungeHeal(state, p)
	local before = p.stamina
	p.stamina = math.min(p.maxStamina, p.stamina + K.LUNGE_HEAL_RATIO * p.maxStamina)
	local _events = state.events
	local _arg0 = {
		type = "lungeHeal",
		playerIdx = p.idx,
		amount = p.stamina - before,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * One hit on a victim. Does not touch attacker.hitDone: a punch or tackle sets it itself, so a slash swing (which also calls
	 * this) cannot cancel an attack that has not landed yet.
	 
]]
function applyHit(state, attacker, victim, kind)
	-- An invincible victim (rampaging or lunging): the attack is spent and nothing else changes. A raised arrowship counts it.
	if isInvincible(victim) then
		arrowshipBlockAttack(state, victim)
		return nil
	end
	reportCastCancel(state, victim)
	victim.chargeTicks = 0
	local damage = math.max(3, math.floor(8 + attacker.stats.power * 1.2 - victim.stats.defense * 0.5 + 0.5))
	if kind ~= "punch" then
		damage = math.floor(damage * 1.5 + 0.5)
	end
	victim.stamina = math.max(0, victim.stamina - damage)
	local dirX = victim.x - attacker.x
	local dirY = victim.y - attacker.y
	local len = math.sqrt(dirX * dirX + dirY * dirY)
	if len == 0 then
		dirX = attacker.facingX
		dirY = attacker.facingY
	else
		dirX /= len
		dirY /= len
	end
	local knock = (K.KNOCKBACK_SPEED * attacker.mass) / victim.mass
	victim.vx = dirX * knock
	victim.vy = dirY * knock
	victim.vz = HIT_VZ
	local down = false
	if victim.stamina <= 0 then
		setDown(victim, K.DOWN_TICKS_EXHAUSTED)
		down = true
	elseif kind ~= "punch" then
		setDown(victim, K.DOWN_TICKS_KNOCKED)
		down = true
	else
		victim.action = "hitstun"
		victim.actionTimer = K.HITSTUN_TICKS
	end
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = attacker.idx,
		victimIdx = victim.idx,
		kind = kind,
		damage = damage,
	}
	table.insert(_events, _arg0)
	if state.ball.ownerIdx == victim.idx then
		knockLooseBall(state, attacker, victim, dirX, dirY)
	end
	if down then
		local _events_1 = state.events
		local _arg0_1 = {
			type = "down",
			playerIdx = victim.idx,
		}
		table.insert(_events_1, _arg0_1)
	end
end
--* A hit knocks the ball out of the victim's control, launched along the hit direction. 
function knockLooseBall(state, attacker, victim, dirX, dirY)
	local ball = state.ball
	ball.ownerIdx = -1
	-- The attacker's hit is the last touch, so a knock-in (even into the victim's own goal) is credited to the attacker.
	ball.lastTouchIdx = attacker.idx
	ball.vx = dirX * LOOSE_BALL_SPEED + (rngNext(state) * 2 - 1) * LOOSE_BALL_SPREAD
	ball.vy = dirY * LOOSE_BALL_SPEED + (rngNext(state) * 2 - 1) * LOOSE_BALL_SPREAD
	ball.vz = LOOSE_BALL_VZ
	victim.noTouchTicks = K.LOOSE_BALL_NO_TOUCH
	local _events = state.events
	local _arg0 = {
		type = "looseBall",
		playerIdx = victim.idx,
	}
	table.insert(_events, _arg0)
end
function distance(ax, ay, bx, by)
	local dx = ax - bx
	local dy = ay - by
	return math.sqrt(dx * dx + dy * dy)
end
return {
	updateAction = updateAction,
	clampPlayerToField = clampPlayerToField,
	updateRiders = updateRiders,
	clearRiders = clearRiders,
	tigerBallHit = tigerBallHit,
	endTigerWindows = endTigerWindows,
	updateBladeWaves = updateBladeWaves,
	endSlashWindows = endSlashWindows,
	updateIcefields = updateIcefields,
	endIcefields = endIcefields,
	updateGusts = updateGusts,
	endGusts = endGusts,
	updatePortals = updatePortals,
	endPortals = endPortals,
	updateEastwinds = updateEastwinds,
	endEastwinds = endEastwinds,
	updateArrowships = updateArrowships,
	clampArrowshipBarrier = clampArrowshipBarrier,
	blockArrowshipBall = blockArrowshipBall,
	endArrowships = endArrowships,
	updateSails = updateSails,
	carryPassengers = carryPassengers,
	endSails = endSails,
	endRampage = endRampage,
	specialSpeed = specialSpeed,
	choosePassTarget = choosePassTarget,
	applySpecialHit = applySpecialHit,
	isInvincible = isInvincible,
	applyRampageBumps = applyRampageBumps,
	knockLooseBall = knockLooseBall,
}
]]></string>
          </Properties>
