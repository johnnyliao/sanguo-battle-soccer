end
--[[
	*
	 * Free teammate (no opponent within RECEIVER_FREE_RANGE) that is at least minAhead further toward the
	 * opponent goal than the player. Picks the one furthest forward. Null if none.
	 
]]
function pickReceiver(state, p, minAhead)
	local dir = attackDir(state, p.team)
	local best = nil
	local bestAhead = -math.huge
	for _, t in state.players do
		if t.team ~= p.team or t.idx == p.idx or t.action == "down" then
