end
--* Number of standing opponents of `team` within range of the point (x, y). 
function opponentsNear(state, team, x, y, range)
	local count = 0
	for _, t in state.players do
		if t.team == team or t.action == "down" then
			continue
		end
		if dist(t.x, t.y, x, y) < range then
			count += 1
		end
	end
	return count
end
--* True if a standing opponent is within range and in the half-plane ahead of the player's facing (within lateral). 
function opponentAhead(state, p, range, lateral)
	local _exp = state.players
	-- ▼ ReadonlyArray.some ▼
	local _result = false
	local _callback = function(t)
		if t.team == p.team or t.action == "down" then
			return false
		end
		local dx = t.x - p.x
		local dy = t.y - p.y
		if math.sqrt(dx * dx + dy * dy) >= range then
