--[[
	*
	 * The gust erupts: every standing, non-invincible opponent within GUST_RADIUS of its point is launched. Victims are handled
	 * in index order, so the events are deterministic.
	 
]]
local launchGustVictim
function gustBlow(state, g)
	local caster = state.players[g.ownerIdx + 1]
	local victimIdxs = {}
	for _, v in state.players do
		if v.team == g.team or v.action == "down" or v.action == "recover" or isInvincible(v) then
			continue
		end
		if distance(g.x, g.y, v.x, v.y) > K.GUST_RADIUS then
			continue
		end
		launchGustVictim(state, g, caster, v)
		local _idx = v.idx
		table.insert(victimIdxs, _idx)
	end
	local _events = state.events
	local _arg0 = {
		type = "gustBlow",
		gustId = g.id,
		x = g.x,
		y = g.y,
		victimIdxs = victimIdxs,
	}
	table.insert(_events, _arg0)
end
--[[
	*
	 * A gust victim loses GUST_STAMINA_RATIO of his maxStamina, is pushed away from the gust point and launched: he is airborne
	 * for LAUNCH_AIR_TICKS, then lies down until GUST_LAUNCH_TICKS. An emptied victim stays down for the longer exhausted
	 * time. A ball he holds is knocked loose by the caster.
	 
]]
function launchGustVictim(state, g, caster, v)
	reportCastCancel(state, v)
	v.chargeTicks = 0
	local dirX = v.x - g.x
	local dirY = v.y - g.y
	local len = math.sqrt(dirX * dirX + dirY * dirY)
	if len == 0 then
		dirX = attackDir(state, g.team)
		dirY = 0
	else
		dirX /= len
		dirY /= len
	end
	v.vx = dirX * K.GUST_PUSH_SPEED
	v.vy = dirY * K.GUST_PUSH_SPEED
	v.vz = K.GUST_LAUNCH_VZ
	local damage = K.GUST_STAMINA_RATIO * v.maxStamina
	v.stamina = math.max(0, v.stamina - damage)
	setDown(v, if v.stamina <= 0 then math.max(K.GUST_LAUNCH_TICKS, K.DOWN_TICKS_EXHAUSTED) else K.GUST_LAUNCH_TICKS)
	local _events = state.events
	local _arg0 = {
		type = "hit",
		attackerIdx = g.ownerIdx,
		victimIdx = v.idx,
		kind = "special",
		damage = damage,
	}
	table.insert(_events, _arg0)
	if state.ball.ownerIdx == v.idx then
		knockLooseBall(state, caster, v, dirX, dirY)
	end
	local _events_1 = state.events
	local _arg0_1 = {
		type = "down",
		playerIdx = v.idx,
	}
	table.insert(_events_1, _arg0_1)
end
--* Clears every pending gust without an eruption (the phase left play). 
local function endGusts(state)
	for _, g in state.gusts do
		local _events = state.events
		local _arg0 = {
			type = "gustEnd",
			gustId = g.id,
		}
		table.insert(_events, _arg0)
	end
	state.gusts = {}
end
