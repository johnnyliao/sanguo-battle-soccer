{
	"name": "sanguo-demo",
	"globIgnorePaths": [
		"**/package.json",
		"**/tsconfig.json"
	],
	"tree": {
		"$className": "DataModel",
		"Workspace": {
			"$className": "Workspace"
		},
		"Players": {
			"$className": "Players",
			"$properties": {
				"CharacterAutoLoads": false
			}
		},
		"Lighting": {
			"$className": "Lighting",
			"$properties": {
				"ClockTime": 14,
				"Brightness": 2
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": "out/server"
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"Tools": {
				"$path": "out/tools"
			}
		},
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"rbxts_include": {
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					}
				}
			},
			"Shared": {
				"$path": "out/shared"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "out/client"
				}
			}
		}
	}
}
